/* 订阅手势诊断页(#36 排查专用,develop only):按钮刻意保持素态——
   不加 hover 属性、不加自定义包装,与产品页 chip 的唯一区别就是这些变量 */
.diag {
  padding: 32rpx;
}

.diag-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.diag-env {
  background: rgba(127, 127, 127, 0.1);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
}

.diag-envline {
  font-size: 24rpx;
  line-height: 1.8;
  font-family: monospace;
  word-break: break-all;
}

.diag-btn {
  margin-bottom: 16rpx;
}

.diag-hint {
  font-size: 24rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}

.diag-r {
  font-size: 24rpx;
  line-height: 1.6;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.diag-r.ok {
  background: rgba(46, 155, 97, 0.14);
}

.diag-r.fail {
  background: rgba(200, 60, 60, 0.14);
}
