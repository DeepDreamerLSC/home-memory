/* D1 位置级视频清点页(#94):复用 app.wxss 的卡片/条目语言,颜色只用全局 CSS 变量 */

.scan-video {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
  background: var(--card-inset);
}

/* 线索统计行(R0 #101:三数分立);组卡呈现收进 components/scene-group-card */
.stats-line {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text-2);
}

/* 草稿卡:逐件确认主体 */
.draft-card {
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid var(--card-inset);
}

.draft-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  background: var(--card-inset);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.draft-meta {
  margin: 12rpx 0 8rpx;
}

.time-input {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--text);
  background: var(--card-inset);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}

.link-text {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 8rpx 0;
}

.danger-text {
  color: var(--danger);
}

/* 半屏弹层(子位置选择 / 匹配建议):遮罩 + 底部面板 */
.layer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.layer {
  width: 100%;
  max-height: 72vh;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.layer-scroll {
  max-height: 48vh;
  margin: 12rpx 0;
}

.option-row {
  padding: 16rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.option-current {
  background: var(--card-inset);
}

/* 遮罩层里的按钮与整体留白 */
.layer .btn {
  margin-top: 8rpx;
}
