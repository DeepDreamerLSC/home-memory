/* 详情页补充样式(其余复用 app.wxss)
   常态=只读大卡(先答案后操作),编辑折叠、操作收进「⋯」菜单(issue #45 D1) */

/* 批准原型的详情页:先位置,再证据和管理操作。 */
.page-with-detail-dock { padding-bottom: calc(174rpx + env(safe-area-inset-bottom)); }
.detail-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 40rpx 44rpx 0; }
.detail-title { flex: 1; min-width: 0; }
.pagetitle { font-size: 54rpx; font-weight: 600; line-height: 1.35; letter-spacing: -1.6rpx; color: var(--text); word-break: break-all; }
.detail-head .more-inline { min-height: 72rpx; min-width: 72rpx; padding: 0; }
.detail-head .more-inline-face { border: none; background: transparent; padding: 0; min-width: 60rpx; min-height: 60rpx; font-size: 34rpx; font-weight: 500; }
.detail-visual { height: 268rpx; margin: 36rpx 44rpx; border-radius: 34rpx; background: var(--card-inset); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.detail-art { width: 240rpx; height: 200rpx; }
.detail-photo { width: 100%; height: 100%; }
.bigcard-lbl { margin: 48rpx 44rpx 20rpx; font-size: 22rpx; color: var(--text-2); }
.bigcard { background: var(--card); border: 1rpx solid var(--line); border-radius: 36rpx; padding: 40rpx; margin: 0 44rpx; }
.bigcard-path { font-size: 22rpx; font-weight: 400; line-height: 1.6; color: var(--text-2); word-break: break-all; }
.bigcard-sep { margin: 0 12rpx; color: var(--text-3); }
.bigcard-location { margin-top: 16rpx; font-size: 42rpx; font-weight: 500; line-height: 1.5; letter-spacing: -1rpx; word-break: break-all; }
.detail-meta { font-size: 22rpx; color: var(--text-2); margin-top: 12rpx; }
.bigcard-quote { margin-top: 16rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.6; }
.bigcard-tiny { margin: 22rpx 44rpx 34rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.75; }
.detail-quote-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 20rpx 0; margin: 0 44rpx; border-bottom: 1rpx solid var(--line); font-size: 24rpx; color: var(--text-2); }
.detail-quote-row text:last-child { color: var(--text); }
.detail-quote { margin: 24rpx 44rpx; padding: 28rpx 34rpx; border-left: 4rpx solid var(--accent); border-radius: 0 24rpx 24rpx 0; background: var(--card-inset); font-size: 26rpx; line-height: 1.9; color: var(--text); }
.detail-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; align-items: center; gap: 20rpx; padding: 24rpx 40rpx calc(8rpx + env(safe-area-inset-bottom) / 2); border-top: 1rpx solid var(--line); background: var(--bg); }
.detail-found, .detail-update { min-height: 102rpx; margin: 0; padding: 0 24rpx; border-radius: 32rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 500; line-height: 1; }
.detail-found { flex: 1; gap: 16rpx; background: var(--go-bg); color: var(--go-fg); }
.detail-update { min-width: 176rpx; background: var(--card); color: var(--text); border: 1rpx solid var(--line); }
.detail-found::after, .detail-update::after { border: none; }
.detail-found[disabled], .detail-update[disabled] { opacity: .45; }
.found-check { font-size: 32rpx; }

/* ============ 编辑折叠(展开后=原有表单与保存路径;原型 .fold padding 14px 13px)
   (Fix 1 压扁:104→88,flex 居中 + line-height:1) ============ */
.fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--card);
  border-radius: 30rpx;
  padding: 26rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 20rpx 36rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.fold-hover {
  background: var(--card-inset);
}

.fold-chev {
  font-size: 36rpx;
  color: var(--text-3);
  transition: transform 0.2s ease;
}

.fold-chev.up {
  transform: rotate(90deg);
}

.fold-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.25s ease;
  margin: 0 36rpx;
}

.fold-body.open {
  /* 展开高度上限:表单 + 冲突面板(多字段并排)都在折叠体内,不够会被裁掉 */
  max-height: 4000rpx;
}

.fold-body .card {
  margin: 16rpx 0 0;
}

.fold-note {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 保存 / 确认整理:墨底黄字主 CTA(一屏唯一大面积明黄留给语音条)
   视觉/热区分层样式统一收在 app.wxss(.btn.ink + .btn-face,#36 真机反馈 Fix 1) */

/* ============ 「⋯」次级菜单:底部弹层 ============ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: none;
  align-items: flex-end;
  z-index: 60;
}

.sheet-mask.open {
  display: flex;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

/* 弹层动作行(Fix 1 压扁:104→88;纵向 flex 居中,热区=元素 ≥88rpx) */
.sheet-act {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--card);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sheet-act-hover {
  background: var(--card-inset);
}

.sheet-act-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.sheet-act.warn .sheet-act-name {
  color: var(--danger);
}

.sheet-act-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.3;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 24rpx;
  line-height: 1;
}

.field:last-of-type {
  margin-bottom: 0;
}

/* 整理位置:AI 拿不准的分段标黄(横幅语言,与「待核对」视觉一致) */
.input-warn {
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
}

/* ============ 保质期行(#36,原型 .expire-row:有 active 提醒才显示;Fix 1 压扁) ============ */
.expire-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid var(--danger-shadow);
  background: var(--danger-bg);
  border-radius: 30rpx;
  padding: 18rpx 26rpx;
  margin: 24rpx 36rpx 0;
}

.expire-main {
  flex: 1;
  min-width: 0;
}

.expire-t {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.4;
}

.expire-sub {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 6rpx;
}

/* 「已处理」(原型 .r1-done):视觉/热区分层样式统一收在 app.wxss
   (.r-done + .r-done-face,#36 真机反馈 Fix 1:热区 88 = 面 66) */

/* ============ 到期微信提醒显式入口(#36 真机手势规则:订阅授权只能由真实 tap 发起;
     picker bindchange 无点击手势,授权入口收在这里)。小号次级触点,贴「已处理/⋯」
   的次级规范:热区 ≥88(透明上下延伸)、视觉面 60;全用主题变量,浅深两套主题通用 ============ */
.notify-chip {
  /* 原生 button 手势令牌用(鸿蒙);重置微信 button 默认观感,视觉仍由 face 胶囊承担 */
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 14rpx 0;
  margin: 0 36rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-radius: 0;
  width: auto;
  line-height: normal;
  font-size: inherit;
  font-weight: normal;
  color: inherit;
}

.notify-chip::after {
  border: none;
}

.notify-chip-face {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  padding: 0 26rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.notify-chip-hover .notify-chip-face {
  background: var(--card-inset);
}

/* ============ 编辑折叠「提醒」字段(#36 十五轮:picker mode=date + ✕ 清除) ============ */
.remind-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.remind-field picker {
  flex: 1;
  min-width: 0;
}

/* 日期按钮行(原型 .field-btn;Fix 1 压扁:92→88,热区=元素 88rpx,flex 居中 + line-height:1) */
.field-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  line-height: 1;
}

.field-val {
  font-weight: 700;
  color: var(--text);
}

.field-ph {
  color: var(--text-3);
}

.field-chev {
  color: var(--text-3);
  font-size: 32rpx;
  font-weight: 300;
}

/* 「✕」清除(原型 .clearx;Fix 1:热区 88 = 面 66 + 透明四周延伸) */
.clearx {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  padding: 11rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.clearx-face {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-3);
  border-radius: 50%;
  font-size: 28rpx;
  line-height: 1;
}

/* ============ 版本冲突面板(issue #6,移植自 PR #12):黄色横幅面,逐字段
   并排「你的修改 / 最新记录」+ 显式选边;全部用主题变量,浅深两套主题通用 ============ */
.conflict-card {
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
}

.conflict-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.conflict-desc {
  font-size: 24rpx;
  color: var(--text-2);
  margin: 8rpx 0 20rpx;
  line-height: 1.5;
}

.conflict-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.conflict-item:last-child {
  margin-bottom: 0;
}

.conflict-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.conflict-row {
  display: flex;
}

.conflict-side {
  flex: 1;
  min-width: 0;
  background: var(--card-inset);
  border-radius: 12rpx;
  padding: 16rpx;
}

.conflict-side + .conflict-side {
  margin-left: 16rpx;
}

.conflict-side-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 4rpx;
}

.conflict-value {
  font-size: 26rpx;
  color: var(--text);
  word-break: break-all;
}

.conflict-actions {
  display: flex;
  margin-top: 16rpx;
}

/* 选择按钮:热区层复用全局 button.btn(面 66 内嵌深槽),选中态复用
   button.btn.primary 的明黄强调面;两个按钮共担一行 */
.conflict-actions button.conflict-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  min-height: 76rpx;
  padding: 5rpx 0;
}

.conflict-actions button.conflict-btn + button.conflict-btn {
  margin-left: 16rpx;
}

.conflict-actions button.conflict-btn .btn-face {
  min-height: 66rpx;
  font-size: 26rpx;
}

/* 冲突未选完:保存按钮禁用(门禁可视层;onSaveTap 里还有一道双保险) */
.btn.ink[disabled] {
  background: transparent;
  opacity: 1;
}

.btn.ink[disabled] .btn-face {
  opacity: 0.38;
}

/* ============ 照片证据回放卡(#3):照片=历史证据,不冒充当前位置 ============ */

.ev-card {
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 18rpx;
  margin: 24rpx 36rpx;
}

/* 折叠态:压暗缩略条(约 120px 高) + 居中提示胶囊 */
.ev-fold {
  position: relative;
  height: 240rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #000;
}

.ev-fold-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(0.55) blur(1px);
}

.ev-fold-fail {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa0a6;
}

.ev-chip {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 99rpx;
  padding: 18rpx 32rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--text);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
  white-space: nowrap;
}

/* 展开态:等比 contain 全幅(aspect-ratio 跟随原图,零裁切,§3.2 纪律) */
.ev-wrap {
  position: relative;
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #000;
}

.ev-wrap.older {
  margin-top: 18rpx;
}

.ev-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ev-fail {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 黄环脉冲高亮框(原型 .bbox.hit 的 hitring 动画):黄环从框边扩散淡出 */
.ev-box {
  position: absolute;
  border: 7rpx solid var(--go-bg);
  border-radius: 16rpx;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  animation: evhitring 1.5s infinite;
}

@keyframes evhitring {
  0%,
  100% {
    box-shadow: 0 0 0 6rpx rgba(255, 225, 90, 0.65), 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  }
  50% {
    box-shadow: 0 0 0 22rpx rgba(255, 225, 90, 0), 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  }
}

/* 角标:拍摄于某日 · 当时记录在哪(photo 页 .ask 同款形态) */
.ev-ask {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  max-width: 78%;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  z-index: 7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 展开态文案区:位置已变更徽标 + 副文案(以文字为准,旧照片仅作证据) */
.ev-meta {
  padding: 20rpx 12rpx 6rpx;
}

.ev-changed {
  display: inline-block;
  font-size: 21rpx;
  color: var(--text-2);
  background: var(--card-inset);
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.ev-sub {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-all;
}

.ev-sub.moved {
  color: var(--text-2);
}

.ev-acts {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 14rpx;
}

.ev-retake {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
}

.ev-retake-hover {
  opacity: 0.6;
}

.ev-older-toggle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-3);
}

/* 无证据行(拉取成功但没拍过照):灰底说明 + 去补拍入口(原型屏⑥ nocard) */
.ev-none {
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 26rpx 30rpx;
  margin: 24rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ev-none-ico {
  font-size: 40rpx;
  line-height: 1;
  flex: none;
}

.ev-none-main {
  flex: 1;
  min-width: 0;
}

.ev-none-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.ev-none-s {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.ev-none-go {
  flex: none;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 99rpx;
  padding: 20rpx 34rpx;
  box-shadow: 6rpx 6rpx 0 var(--accent-shadow);
}

.ev-none-go-hover {
  transform: translate(2rpx, 2rpx);
  box-shadow: 3rpx 3rpx 0 var(--accent-shadow);
}

/* 视频证据卡 */
.vd-card { margin: 28rpx 44rpx; background: var(--card); border-radius: 36rpx; overflow: hidden; }
.vd-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 28rpx 20rpx; }
.vd-title { font-size: 28rpx; font-weight: 800; }
.vd-more { font-size: 24rpx; color: var(--text-2); }
.vd-wrap { position: relative; width: 100%; background: #000; }
.vd-video { width: 100%; height: 100%; display: block; }
.vd-fail { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 26rpx; background: #111; }
.vd-box { position: absolute; border: 6rpx solid #ffe15a; border-radius: 16rpx; box-shadow: 0 0 0 19998rpx rgba(0,0,0,.22), 0 0 36rpx rgba(255,225,90,.85); pointer-events: none; }
.vd-meta { padding: 24rpx 28rpx 28rpx; }
.vd-changed { display: inline-block; margin-bottom: 12rpx; padding: 4rpx 16rpx; border-radius: 16rpx; background: #fff0d9; color: #8a4b00; font-size: 22rpx; font-weight: 700; }
.vd-sub { color: var(--text-2); font-size: 24rpx; line-height: 1.5; }
.vd-sub.moved { margin-top: 6rpx; }
.vd-tip { margin-top: 16rpx; color: var(--text-2); font-size: 22rpx; line-height: 1.45; }
.vd-actions { margin-top: 20rpx; display: flex; justify-content: flex-end; }
.vd-collapse { padding: 12rpx 20rpx; border-radius: 18rpx; background: var(--card-inset); font-size: 24rpx; font-weight: 700; }
.vd-fold { padding: 24rpx 28rpx 28rpx; }
.vd-fold-face { font-size: 25rpx; color: var(--text-2); }

.vd-pending { margin: 28rpx 44rpx; padding: 28rpx; border-radius: 32rpx; background: #fff5d6; }
.vd-pending-title { font-size: 28rpx; font-weight: 800; color: #5c4a00; }
.vd-pending-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #6b5a1d; }
.vd-pending-actions { margin-top: 20rpx; display: flex; gap: 24rpx; }
.vd-empty { margin: 28rpx 44rpx; padding: 32rpx; border-radius: 32rpx; background: var(--card); color: var(--text-2); font-size: 26rpx; text-align: center; }
.vd-textbtn { padding: 12rpx 20rpx; border-radius: 18rpx; background: var(--card-inset); font-size: 24rpx; font-weight: 700; }
.vd-textbtn.danger { color: #b3261e; }

/* 单件视频 AI 定位:候选需用户确认后才保存高亮 */
.vd-ai-saved { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 20rpx; background: #eef8ee; color: #245b2c; }
.vd-ai-saved-title { font-size: 24rpx; font-weight: 800; }
.vd-ai-saved-row { margin-top: 6rpx; font-size: 22rpx; line-height: 1.45; }
.vd-ai-zone { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }
.vd-ai-entry { padding: 20rpx 24rpx; border-radius: 20rpx; background: var(--card-inset); color: var(--text); font-size: 25rpx; font-weight: 800; text-align: center; }
.vd-ai-progress { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 20rpx; border-radius: 20rpx; background: var(--card-inset); color: var(--text-2); font-size: 24rpx; }
.vd-ai-cancel { padding: 8rpx 16rpx; border-radius: 16rpx; color: var(--text); font-weight: 700; }
.vd-ai-error { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #fdecea; color: #a1261d; font-size: 24rpx; line-height: 1.45; }
.vd-ai-tip { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 18rpx; background: #fff5d6; color: #6b5a1d; font-size: 24rpx; line-height: 1.45; }
.vd-ai-panel { margin-top: 16rpx; }
.vd-ai-panel-title { margin-bottom: 14rpx; font-size: 24rpx; font-weight: 800; }
.vd-ai-scroll { width: 100%; white-space: nowrap; }
.vd-ai-card { display: inline-block; width: 292rpx; margin-right: 16rpx; vertical-align: top; border: 4rpx solid transparent; border-radius: 24rpx; overflow: hidden; background: var(--card-inset); }
.vd-ai-card.selected { border-color: var(--go-bg); }
.vd-ai-thumb { position: relative; width: 100%; height: 192rpx; overflow: hidden; background: #000; }
.vd-ai-img { width: 100%; height: 100%; display: block; }
.vd-ai-thumb .vd-box { border: 4rpx solid #ffe15a; box-shadow: 0 0 0 19998rpx rgba(0,0,0,.18), 0 0 24rpx rgba(255,225,90,.75); }
.vd-ai-check { position: absolute; top: 12rpx; right: 12rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; font-size: 28rpx; line-height: 40rpx; text-align: center; }
.vd-ai-time { padding: 10rpx 14rpx 0; font-size: 22rpx; font-weight: 800; }
.vd-ai-conf { padding: 2rpx 14rpx 12rpx; font-size: 21rpx; color: var(--text-2); }
.vd-ai-actions { margin-top: 16rpx; display: flex; justify-content: flex-end; gap: 20rpx; }
.vd-textbtn.primary { background: var(--go-bg); color: var(--go-fg); }

/* ===== PR C：已确认片段定位回放 ===== */
.vd-fail-inline { margin: 0 28rpx 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fdecea; color: #a1261d; font-size: 24rpx; text-align: center; }
.vd-notice { margin: 20rpx 28rpx 0; padding: 16rpx 20rpx; border-radius: 18rpx; background: #fff5d6; color: #6b5a1d; font-size: 23rpx; line-height: 1.45; }
.vd-evidence-scroll { width: 100%; white-space: nowrap; padding: 16rpx 28rpx 0; box-sizing: border-box; }
.vd-evidence-chip { display: inline-block; margin-right: 16rpx; padding: 12rpx 18rpx; border-radius: 18rpx; border: 3rpx solid transparent; background: var(--card-inset); color: var(--text-2); font-size: 22rpx; font-weight: 700; }
.vd-evidence-chip.selected { border-color: #191919; background: #191919; color: #ffe15a; }
.vd-evidence-chip.unavailable { color: #a1261d; background: #fdecea; }
.vd-points { margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx solid var(--line); }
.vd-points-title { font-size: 23rpx; color: var(--text-2); line-height: 1.45; }
.vd-points-scroll { width: 100%; white-space: nowrap; margin-top: 14rpx; }
.vd-point { display: inline-block; min-height: 64rpx; margin-right: 14rpx; padding: 12rpx 18rpx; border-radius: 18rpx; background: var(--card-inset); color: var(--text); font-size: 22rpx; font-weight: 700; line-height: 40rpx; }
.vd-point.selected { background: #fff5d6; border: 3rpx solid #ffe15a; color: #6b5a1d; }

/* 辅助证据内容使用同一页面栅格。 */
.fold, .ev-card, .ev-none, .expire-row, .notify-chip { margin-left: 44rpx; margin-right: 44rpx; }
.fold-body { margin-left: 44rpx; margin-right: 44rpx; }
.fold { background: transparent; border-bottom: 1rpx solid var(--line); border-radius: 0; padding: 24rpx 0; font-size: 24rpx; font-weight: 400; }
.ev-fold-img { filter: none; }
.ev-chip { left: auto; top: auto; right: 16rpx; bottom: 16rpx; transform: none; padding: 10rpx 18rpx; font-size: 22rpx; font-weight: 500; box-shadow: none; background: var(--card); }
.ev-none { background: transparent; border: none; border-bottom: 1rpx solid var(--line); border-radius: 0; padding: 20rpx 0; }
.ev-none-t, .ev-none-go { font-size: 24rpx; font-weight: 400; }
.vd-empty { background: transparent; border-bottom: 1rpx solid var(--line); border-radius: 0; text-align: left; padding: 24rpx 0; font-size: 24rpx; }
.vd-title, .vd-pending-title, .vd-ai-panel-title { font-weight: 500; }

button.detail-update { flex: 0 0 176rpx; min-width: 176rpx; max-width: 176rpx; }
.ev-none-go { min-height: 88rpx; display: flex; align-items: center; padding: 0; border-radius: 0; background: transparent; color: var(--text-2); box-shadow: none; }

/* ---------- 数量区(issue #102 Q1,Q0-CONTRACT §10.1/§10.3) ---------- */
.qty-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 44rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.qty-main { flex: 1; min-width: 0; }
.qty-t { font-size: 30rpx; font-weight: 500; color: var(--text); }
.qty-t.unconfirmed { font-size: 26rpx; color: var(--text-2); font-weight: 400; }
.qty-sub { margin-top: 8rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.6; }
.qty-act { flex: 0 0 auto; font-size: 24rpx; color: var(--text-2); padding: 12rpx 0 12rpx 20rpx; }
.qty-act.busy { opacity: .6; }
.qty-card { margin: 20rpx 24rpx 0; padding: 28rpx; }
.qty-card .hint { font-size: 22rpx; color: var(--text-2); line-height: 1.7; margin: 8rpx 0 24rpx; }
.note-fold-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 20rpx 0; margin: 0 44rpx; border-bottom: 1rpx solid var(--line); font-size: 24rpx; color: var(--text-2); }
.note-fold-row .note-fold-chev { color: var(--text); }
.note-fold-body { margin: 0 44rpx; padding: 20rpx 0; font-size: 26rpx; line-height: 1.8; color: var(--text); border-bottom: 1rpx solid var(--line); white-space: pre-wrap; word-break: break-all; }

/* 提醒设置行(2026-10-26 上移主界面):picker 按钮与 ✕ 清除横向排布 */
.remind-set-row { display: flex; align-items: center; gap: 16rpx; margin: 14rpx 24rpx 0; }
.remind-set-row picker { flex: 1; }

/* 2026-10-27 批准的详情减法：小图、位置主卡、三行摘要与单任务面板。 */
.page-with-detail-dock { padding: 30rpx 42rpx calc(160rpx + env(safe-area-inset-bottom)); }
.detail-head { margin: 0 0 34rpx; gap: 24rpx; }
.detail-thumb { width: 98rpx; height: 98rpx; flex: 0 0 98rpx; border-radius: 28rpx; background: var(--card-inset); display: flex; align-items: center; justify-content: center; }
.detail-art { width: 82rpx; height: 82rpx; }
.pagetitle { font-size: 44rpx; letter-spacing: -1rpx; }
.detail-shared { margin-top: 8rpx; font-size: 20rpx; color: var(--text-2); }
button.detail-more { color: var(--text); width: 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; font-size: 44rpx; font-weight: 400; background: transparent; border: none; line-height: 88rpx; }
.detail-more::after { border: 0; }
.bigcard { margin: 0; padding: 32rpx; border-radius: 40rpx; }
.bigcard-lbl { margin: 0 0 22rpx; font-size: 22rpx; }
.bigcard-location { font-size: 36rpx; line-height: 1.5; margin: 14rpx 0 25rpx; letter-spacing: -.6rpx; }
.bigcard-path { font-size: 23rpx; }
.bigcard-sep { margin: 0 10rpx; }
.detail-meta { margin: 0; display: flex; justify-content: space-between; gap: 12rpx; font-size: 20rpx; }
.detail-rows { margin-top: 20rpx; }
button.detail-row { font-weight: 400; color: var(--text); display: flex; align-items: center; gap: 20rpx; width: 100%; min-height: 118rpx; margin: 0; padding: 24rpx 2rpx; border-radius: 0; background: transparent; border-bottom: 1rpx solid var(--line); text-align: left; line-height: 1.5; }
.detail-row::after { border: 0; }
.detail-row-label { font-size: 26rpx; flex: 0 0 auto; }
.detail-row-value { flex: 1; min-width: 0; font-size: 23rpx; color: var(--text-2); text-align: right; }
.detail-row-value.strong { color: var(--text); font-size: 28rpx; font-weight: 500; }
.detail-chevron { color: var(--text-3); font-size: 32rpx; }
.detail-row-symbol { font-size: 32rpx; color: var(--text-2); width: 34rpx; text-align: center; }
.detail-row-icon { width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }
.detail-row-icon image { width: 34rpx; height: 34rpx; }
.detail-footnote { color: var(--text-3); font-size: 20rpx; line-height: 1.7; margin: 26rpx 0 0; }
.detail-attention { border: 1rpx solid var(--banner-line); background: var(--banner-bg); padding: 20rpx 24rpx; margin-bottom: 26rpx; border-radius: 26rpx; color: var(--text); font-size: 23rpx; line-height: 1.7; }
button.detail-inline { display: inline-block; width: auto; min-height: 80rpx; margin: 0; padding: 12rpx 0; color: var(--text-2); background: transparent; border: 0; font-size: 23rpx; line-height: 1.6; text-align: left; text-decoration: underline; }
.detail-inline::after { border: 0; }
.detail-inline.danger { color: var(--danger); }
.detail-panel-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,23,14,.42); z-index: 80; display: flex; align-items: flex-end; }
.detail-panel { width: 100%; height: 88vh; max-height: 88vh; border-radius: 48rpx 48rpx 0 0; overflow: hidden; background: var(--bg); display: flex; flex-direction: column; color: var(--text); }
.detail-handle { width: 70rpx; height: 8rpx; border-radius: 8rpx; background: var(--line); margin: 18rpx auto 24rpx; flex-shrink: 0; }
.detail-panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; padding: 0 42rpx 26rpx; flex-shrink: 0; }
.detail-panel-title { font-size: 40rpx; font-weight: 600; line-height: 1.5; }
.detail-panel-sub { margin-top: 8rpx; font-size: 22rpx; color: var(--text-2); }
button.detail-close { width: 72rpx; min-width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--card-inset); line-height: 72rpx; color: var(--text); font-size: 38rpx; }
.detail-close::after { border: 0; }
.detail-panel-body { flex: 1; min-height: 0; height: 0; box-sizing: border-box; padding: 0 42rpx; }
.detail-panel-body .field { margin: 22rpx 0 30rpx; }
.detail-panel-body .label { color: var(--text-2); font-size: 24rpx; margin-bottom: 16rpx; }
.detail-panel-body .textarea { height: 180rpx; min-height: 180rpx; box-sizing: border-box; }
.detail-panel-body .card { margin: 22rpx 0; }
.detail-panel-body .hint { margin: 16rpx 0; }
.detail-panel-body .field-btn { width: 100%; box-sizing: border-box; font-weight: 400; margin: 0; font-size: 26rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 24rpx; min-height: 96rpx; }
.detail-panel-actions { flex-shrink: 0; padding: 22rpx 42rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); display: flex; gap: 18rpx; background: var(--bg); }
button.detail-cancel, button.detail-confirm { margin: 0; padding: 22rpx 28rpx; min-height: 98rpx; border-radius: 30rpx; font-size: 26rpx; line-height: 1.5; }
button.detail-cancel { border: 1rpx solid var(--line); background: var(--card); color: var(--text); }
button.detail-confirm { flex: 1; background: var(--go-bg); color: var(--go-fg); }
.detail-confirm::after, .detail-cancel::after { border: 0; }
.detail-confirm[disabled], .detail-cancel[disabled], .detail-close[disabled] { opacity: .45; }
.detail-preview { background: var(--card-inset); border: 1rpx solid var(--line); border-radius: 26rpx; padding: 26rpx; margin: 32rpx 0 18rpx; font-size: 26rpx; line-height: 1.7; }
.detail-preview .label { font-size: 20rpx; margin-bottom: 10rpx; }
.detail-preview-text { white-space: pre-wrap; word-break: break-all; }
.detail-number-fields { display: flex; gap: 18rpx; }
.detail-stepper { display: flex; flex: 1; min-width: 0; align-items: center; border-radius: 24rpx; border: 1rpx solid var(--line); background: var(--card); overflow: hidden; }
.detail-stepper .input { flex: 1; width: 0; border: 0; text-align: center; font-size: 44rpx; margin: 0; padding: 8rpx 0; background: transparent; }
.detail-stepper button { flex: 0 0 96rpx; width: 96rpx; min-width: 96rpx; margin: 0; padding: 0; min-height: 100rpx; background: transparent; line-height: 100rpx; font-size: 44rpx; }
.detail-stepper button::after { border: 0; }
.detail-unit { padding: 24rpx; min-width: 132rpx; min-height: 100rpx; box-sizing: border-box; border-radius: 24rpx; border: 1rpx solid var(--line); background: var(--card); font-size: 26rpx; }
.detail-unit-check { display: flex; align-items: flex-start; gap: 16rpx; margin: 24rpx 0; color: var(--text-2); font-size: 22rpx; line-height: 1.7; }
.detail-unit-check checkbox { transform: scale(.8); transform-origin: left top; }
.detail-panel-body .remind-set-row { margin: 22rpx 0; display: block; }
.detail-notify { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 22rpx 0; border-top: 1rpx solid var(--line); font-size: 25rpx; }
.detail-notify .notify-chip { margin: 0; width: auto; min-width: 0; padding: 0; flex-shrink: 0; }
.detail-notify .notify-chip-face { font-size: 22rpx; }
.detail-reminder-actions { display: flex; justify-content: space-between; gap: 16rpx; }
.detail-media-tabs { display: flex; gap: 8rpx; background: var(--card-inset); padding: 8rpx; border-radius: 24rpx; margin: 4rpx 0 24rpx; }
.detail-media-tabs button { flex: 1; background: transparent; margin: 0; padding: 16rpx; border-radius: 18rpx; font-size: 25rpx; color: var(--text-2); line-height: 1.5; }
.detail-media-tabs button::after { border: 0; }
.detail-media-tabs button.selected { background: var(--card); color: var(--text); }
.detail-panel-body .vd-card, .detail-panel-body .ev-card, .detail-panel-body .ev-none, .detail-panel-body .vd-empty, .detail-panel-body .vd-pending { margin: 20rpx 0; }
button.sheet-act { display: flex; justify-content: space-between; width: 100%; margin: 0; background: transparent; border-radius: 0; text-align: left; color: var(--text); }
.sheet-act::after, .sheet-close::after { border: 0; }
button.sheet-close { margin: 12rpx 0 0; width: 100%; background: var(--card-inset); color: var(--text); }

.detail-panel-quantity, .detail-panel-reminder { height: 72vh; }
