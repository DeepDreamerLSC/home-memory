/* 详情页补充样式(其余复用 app.wxss)
   常态=只读大卡(先答案后操作),编辑折叠、操作收进「⋯」菜单(issue #45 D1) */

/* ============ 头部:物品名 + 记录更新时间 + 「⋯」 ============ */
.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 36rpx 0;
}

.detail-title {
  flex: 1;
  min-width: 0;
}

.pagetitle {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.6rpx;
  color: var(--text);
  word-break: break-all;
}

.detail-meta {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 「⋯」次级入口:视觉/热区分层样式统一收在 app.wxss(.more-inline + .more-inline-face) */
.detail-head .more-inline {
  margin-top: 4rpx;
}

/* ============ 只读大卡:上次记在(空间路径 + 原话常显) ============ */
.bigcard {
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 32rpx 30rpx;
  margin: 24rpx 36rpx;
}

.bigcard-lbl {
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 700;
  margin-bottom: 18rpx;
}

.bigcard-loc {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.bigcard-pin {
  font-size: 38rpx;
  flex: none;
  line-height: 1.2;
}

.bigcard-main {
  flex: 1;
  min-width: 0;
}

.bigcard-path {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.4;
  color: var(--text);
  word-break: break-all;
}

.bigcard-sep {
  color: var(--text-3);
  font-weight: 400;
  margin: 0 6rpx;
}

.bigcard-quote {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-all;
}

.bigcard-quote-sub {
  color: var(--text-3);
}

/* 时间没换算留痕(Fix 4):比原话更弱的灰阶,只说明「说了时间、没换算成日期」 */
.bigcard-quote.vague-quote {
  color: var(--text-3);
}

/* 「可能已移动」静态提示(原型 bigcard 内 tiny 句:如实区分上次记录与现在) */
.bigcard-tiny {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* ============ 编辑折叠(展开后=原有表单与保存路径;原型 .fold padding 14px 13px)
   (Fix 1 压扁:104→88,flex 居中 + line-height:1) ============ */
.fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--card);
  border-radius: 30rpx;
  padding: 26rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 20rpx 36rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.fold-hover {
  background: var(--card-inset);
}

.fold-chev {
  font-size: 36rpx;
  color: var(--text-3);
  transition: transform 0.2s ease;
}

.fold-chev.up {
  transform: rotate(90deg);
}

.fold-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.25s ease;
  margin: 0 36rpx;
}

.fold-body.open {
  /* 展开高度上限:表单 + 冲突面板(多字段并排)都在折叠体内,不够会被裁掉 */
  max-height: 4000rpx;
}

.fold-body .card {
  margin: 16rpx 0 0;
}

.fold-note {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 保存 / 确认整理:墨底黄字主 CTA(一屏唯一大面积明黄留给语音条)
   视觉/热区分层样式统一收在 app.wxss(.btn.ink + .btn-face,#36 真机反馈 Fix 1) */

/* ============ 「⋯」次级菜单:底部弹层 ============ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: none;
  align-items: flex-end;
  z-index: 60;
}

.sheet-mask.open {
  display: flex;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

/* 弹层动作行(Fix 1 压扁:104→88;纵向 flex 居中,热区=元素 ≥88rpx) */
.sheet-act {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--card);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sheet-act-hover {
  background: var(--card-inset);
}

.sheet-act-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.sheet-act.warn .sheet-act-name {
  color: var(--danger);
}

.sheet-act-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.3;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 24rpx;
  line-height: 1;
}

.field:last-of-type {
  margin-bottom: 0;
}

/* 整理位置:AI 拿不准的分段标黄(横幅语言,与「待核对」视觉一致) */
.input-warn {
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
}

/* ============ 保质期行(#36,原型 .expire-row:有 active 提醒才显示;Fix 1 压扁) ============ */
.expire-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid var(--danger-shadow);
  background: var(--danger-bg);
  border-radius: 30rpx;
  padding: 18rpx 26rpx;
  margin: 24rpx 36rpx 0;
}

.expire-main {
  flex: 1;
  min-width: 0;
}

.expire-t {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.4;
}

.expire-sub {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 6rpx;
}

/* 「已处理」(原型 .r1-done):视觉/热区分层样式统一收在 app.wxss
   (.r-done + .r-done-face,#36 真机反馈 Fix 1:热区 88 = 面 66) */

/* ============ 到期微信提醒显式入口(#36 真机手势规则:订阅授权只能由真实 tap 发起;
     picker bindchange 无点击手势,授权入口收在这里)。小号次级触点,贴「已处理/⋯」
   的次级规范:热区 ≥88(透明上下延伸)、视觉面 60;全用主题变量,浅深两套主题通用 ============ */
.notify-chip {
  /* 原生 button 手势令牌用(鸿蒙);重置微信 button 默认观感,视觉仍由 face 胶囊承担 */
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 14rpx 0;
  margin: 0 36rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-radius: 0;
  width: auto;
  line-height: normal;
  font-size: inherit;
  font-weight: normal;
  color: inherit;
}

.notify-chip::after {
  border: none;
}

.notify-chip-face {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  padding: 0 26rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.notify-chip-hover .notify-chip-face {
  background: var(--card-inset);
}

/* ============ 编辑折叠「提醒」字段(#36 十五轮:picker mode=date + ✕ 清除) ============ */
.remind-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.remind-field picker {
  flex: 1;
  min-width: 0;
}

/* 日期按钮行(原型 .field-btn;Fix 1 压扁:92→88,热区=元素 88rpx,flex 居中 + line-height:1) */
.field-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  line-height: 1;
}

.field-val {
  font-weight: 700;
  color: var(--text);
}

.field-ph {
  color: var(--text-3);
}

.field-chev {
  color: var(--text-3);
  font-size: 32rpx;
  font-weight: 300;
}

/* 「✕」清除(原型 .clearx;Fix 1:热区 88 = 面 66 + 透明四周延伸) */
.clearx {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  padding: 11rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.clearx-face {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-3);
  border-radius: 50%;
  font-size: 28rpx;
  line-height: 1;
}

/* ============ 版本冲突面板(issue #6,移植自 PR #12):黄色横幅面,逐字段
   并排「你的修改 / 最新记录」+ 显式选边;全部用主题变量,浅深两套主题通用 ============ */
.conflict-card {
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
}

.conflict-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.conflict-desc {
  font-size: 24rpx;
  color: var(--text-2);
  margin: 8rpx 0 20rpx;
  line-height: 1.5;
}

.conflict-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.conflict-item:last-child {
  margin-bottom: 0;
}

.conflict-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.conflict-row {
  display: flex;
}

.conflict-side {
  flex: 1;
  min-width: 0;
  background: var(--card-inset);
  border-radius: 12rpx;
  padding: 16rpx;
}

.conflict-side + .conflict-side {
  margin-left: 16rpx;
}

.conflict-side-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 4rpx;
}

.conflict-value {
  font-size: 26rpx;
  color: var(--text);
  word-break: break-all;
}

.conflict-actions {
  display: flex;
  margin-top: 16rpx;
}

/* 选择按钮:热区层复用全局 button.btn(面 66 内嵌深槽),选中态复用
   button.btn.primary 的明黄强调面;两个按钮共担一行 */
.conflict-actions button.conflict-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  min-height: 76rpx;
  padding: 5rpx 0;
}

.conflict-actions button.conflict-btn + button.conflict-btn {
  margin-left: 16rpx;
}

.conflict-actions button.conflict-btn .btn-face {
  min-height: 66rpx;
  font-size: 26rpx;
}

/* 冲突未选完:保存按钮禁用(门禁可视层;onSaveTap 里还有一道双保险) */
.btn.ink[disabled] {
  background: transparent;
  opacity: 1;
}

.btn.ink[disabled] .btn-face {
  opacity: 0.38;
}

/* ============ 照片证据回放卡(#3):照片=历史证据,不冒充当前位置 ============ */

.ev-card {
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 18rpx;
  margin: 24rpx 36rpx;
}

/* 折叠态:压暗缩略条(约 120px 高) + 居中提示胶囊 */
.ev-fold {
  position: relative;
  height: 240rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #000;
}

.ev-fold-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(0.55) blur(1px);
}

.ev-fold-fail {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa0a6;
}

.ev-chip {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 99rpx;
  padding: 18rpx 32rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--text);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
  white-space: nowrap;
}

/* 展开态:等比 contain 全幅(aspect-ratio 跟随原图,零裁切,§3.2 纪律) */
.ev-wrap {
  position: relative;
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #000;
}

.ev-wrap.older {
  margin-top: 18rpx;
}

.ev-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ev-fail {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 黄环脉冲高亮框(原型 .bbox.hit 的 hitring 动画):黄环从框边扩散淡出 */
.ev-box {
  position: absolute;
  border: 7rpx solid var(--go-bg);
  border-radius: 16rpx;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  animation: evhitring 1.5s infinite;
}

@keyframes evhitring {
  0%,
  100% {
    box-shadow: 0 0 0 6rpx rgba(255, 225, 90, 0.65), 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  }
  50% {
    box-shadow: 0 0 0 22rpx rgba(255, 225, 90, 0), 0 0 0 3rpx rgba(255, 255, 255, 0.55);
  }
}

/* 角标:拍摄于某日 · 当时记录在哪(photo 页 .ask 同款形态) */
.ev-ask {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  max-width: 78%;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  z-index: 7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 展开态文案区:位置已变更徽标 + 副文案(以文字为准,旧照片仅作证据) */
.ev-meta {
  padding: 20rpx 12rpx 6rpx;
}

.ev-changed {
  display: inline-block;
  font-size: 21rpx;
  color: var(--text-2);
  background: var(--card-inset);
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.ev-sub {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  word-break: break-all;
}

.ev-sub.moved {
  color: var(--text-2);
}

.ev-acts {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 14rpx;
}

.ev-retake {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
}

.ev-retake-hover {
  opacity: 0.6;
}

.ev-older-toggle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-3);
}

/* 无证据行(拉取成功但没拍过照):灰底说明 + 去补拍入口(原型屏⑥ nocard) */
.ev-none {
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 26rpx 30rpx;
  margin: 24rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ev-none-ico {
  font-size: 40rpx;
  line-height: 1;
  flex: none;
}

.ev-none-main {
  flex: 1;
  min-width: 0;
}

.ev-none-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.ev-none-s {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.ev-none-go {
  flex: none;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 99rpx;
  padding: 20rpx 34rpx;
  box-shadow: 6rpx 6rpx 0 var(--accent-shadow);
}

.ev-none-go-hover {
  transform: translate(2rpx, 2rpx);
  box-shadow: 3rpx 3rpx 0 var(--accent-shadow);
}
