<view class="page">
  <view class="card">
    <view class="meta">当前版本 v{{ version }} · 更新于 {{ updatedAtText }}</view>

    <view class="field">
      <view class="label">名称</view>
      <input
        class="input"
        placeholder="物品名称(必填)"
        placeholder-class="placeholder"
        value="{{ name }}"
        maxlength="50"
        bindinput="onNameInput"
      />
    </view>
    <view class="field">
      <view class="label">位置(必填)</view>
      <input
        class="input"
        placeholder="放在哪里"
        placeholder-class="placeholder"
        value="{{ locationText }}"
        maxlength="200"
        bindinput="onLocationInput"
      />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea
        class="textarea"
        placeholder="选填,最多 200 字"
        placeholder-class="placeholder"
        value="{{ note }}"
        maxlength="200"
        auto-height
        bindinput="onNoteInput"
      />
    </view>

    <button
      class="btn primary block"
      loading="{{ saving }}"
      bindtap="onSaveTap"
    >
      保存修改
    </button>
    <button
      class="btn danger block"
      loading="{{ deleting }}"
      bindtap="onDeleteTap"
    >
      删除这条记录
    </button>
  </view>
</view>
