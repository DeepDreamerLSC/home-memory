<view class="page page-with-voice-bar">
  <!-- 先答案:物品名 + 记录更新时间;操作全收进「⋯」 -->
  <view class="detail-head">
    <view class="detail-title">
      <view class="pagetitle">{{ name }}</view>
      <view wx:if="{{ lastConfirmedText }}" class="detail-meta">{{ lastConfirmedText }}</view>
    </view>
    <view class="more-inline" bindtap="onMoreTap"><view class="more-inline-face">⋯</view></view>
  </view>

  <!-- 只读大卡:空间路径(知道时)+ 原话常显 +「可能已移动」提示(D1 P0 三组成) -->
  <view class="bigcard">
    <view class="bigcard-lbl">上次记在</view>
    <view class="bigcard-loc">
      <view class="bigcard-pin">📍</view>
      <view class="bigcard-main">
        <view wx:if="{{ spacePath.length > 0 }}" class="bigcard-path">
          <block wx:for="{{ spacePath }}" wx:key="*this">
            <text>{{ item }}</text>
            <text wx:if="{{ index < spacePath.length - 1 }}" class="bigcard-sep"> › </text>
          </block>
        </view>
        <view class="bigcard-quote">
          你当时说的是:「{{ locationText }}」
        </view>
        <!-- 时间没换算留痕(0.6.0 真机反馈 Fix 4):录入时说了时间但没换成日期;
             纯展示不产生提醒,有到期行在屏时不重复提示 -->
        <view wx:if="{{ vagueQuote && !expire }}" class="bigcard-quote vague-quote">
          当时提到时间:『{{ vagueQuote }}』(没换算成日期)
        </view>
      </view>
    </view>
    <view class="bigcard-tiny">这是上次记录的位置,东西可能已经移动。</view>
  </view>

  <view wx:if="{{ videoPending }}" class="vd-pending">
    <view class="vd-pending-title">🎬 视频待关联</view>
    <view class="vd-pending-sub">{{ videoPendingText }}</view>
    <view class="vd-pending-actions">
      <view wx:if="{{ videoPendingExpired === false }}" class="vd-textbtn" bindtap="onVideoPendingRetryTap">重试关联</view>
      <view class="vd-textbtn danger" bindtap="onVideoPendingDiscardTap">删除待关联视频</view>
    </view>
  </view>

  <view wx:if="{{ videoLookupFailed }}" id="video-evidence-card" class="vd-card">
    <view class="vd-head">
      <view class="vd-title">🎬 当时的视频</view>
      <view class="vd-more" bindtap="onVideoMoreTap">说明</view>
    </view>
    <view class="vd-fail-inline" bindtap="onVideoRetry">视频留证暂时无法加载,点按重试</view>
  </view>

  <view wx:if="{{ videoReady && videoEvidence && videoSelected }}" id="video-evidence-card" class="vd-card">
    <view class="vd-head">
      <view class="vd-title">🎬 当时的视频</view>
      <view class="vd-more" bindtap="onVideoMoreTap">说明</view>
    </view>
    <block wx:if="{{ videoOpen }}">
      <view wx:if="{{ videoPlaybackNotice }}" class="vd-notice">{{ videoPlaybackNotice }}</view>
      <scroll-view wx:if="{{ videoEvidence.all.length > 1 }}" scroll-x="{{ true }}" class="vd-evidence-scroll">
        <view
          wx:for="{{ videoEvidence.all }}"
          wx:key="evidenceId"
          class="vd-evidence-chip {{ item.evidenceId === videoSelected.evidenceId ? 'selected' : '' }} {{ item.playable === false ? 'unavailable' : '' }}"
          data-evidence-id="{{ item.evidenceId }}"
          bindtap="onVideoEvidenceSelect"
        >
          {{ item.dateText }}<text wx:if="{{ item.highlightCount > 0 }}"> · {{ item.highlightCount }}段</text><text wx:if="{{ item.playable === false }}"> · 暂不可播</text>
        </view>
      </scroll-view>
      <view class="vd-wrap" style="aspect-ratio: {{ videoSelected.aspect }};">
        <video
          wx:if="{{ videoSelected.playable && videoPlaybackError === '' }}"
          id="videoEvidencePlayer"
          class="vd-video"
          src="{{ videoSelected.videoUrl }}"
          autoplay="{{ false }}"
          controls="{{ true }}"
          object-fit="contain"
          show-center-play-btn="{{ true }}"
          enable-progress-gesture="{{ true }}"
          initial-time="{{ videoInitialTime }}"
          bindloadedmetadata="onVideoLoadedMetadata"
          bindtimeupdate="onVideoTimeUpdate"
          binderror="onVideoPlaybackError"
        ></video>
        <view wx:else class="vd-fail" bindtap="onVideoRetry">{{ videoPlaybackError || '视频加载失败,点按重试' }}</view>
        <view
          wx:if="{{ videoActiveBox && videoSelected.playable && videoPlaybackError === '' }}"
          class="vd-box"
          style="left:{{ videoActiveBox.left }}%;top:{{ videoActiveBox.top }}%;width:{{ videoActiveBox.width }}%;height:{{ videoActiveBox.height }}%"
        ></view>
      </view>
      <view class="vd-meta">
        <view wx:if="{{ videoSelected.changed }}" class="vd-changed">位置已变更</view>
        <view class="vd-sub">{{ videoSelected.badge }}</view>
        <view class="vd-sub {{ videoSelected.changed ? 'moved' : '' }}">{{ videoSelected.subText }}</view>
        <view class="vd-tip">视频只说明当时记录在哪,不冒充当前位置;你确认过的片段也可能有偏差。播放需你明确点击。</view>
        <view wx:if="{{ videoSelected.highlights.length > 0 }}" class="vd-points">
          <view class="vd-points-title">你确认过的片段(点时间只定位,不自动播放)</view>
          <scroll-view scroll-x="{{ true }}" class="vd-points-scroll">
            <view
              wx:for="{{ videoSelected.highlights }}"
              wx:key="key"
              class="vd-point {{ videoSelectedHighlightKey === item.key ? 'selected' : '' }}"
              data-highlight-key="{{ item.key }}"
              bindtap="onVideoHighlightTap"
            >
              {{ item.rangeText }}<text wx:if="{{ item.hasBox }}"> · 有框</text>
            </view>
          </scroll-view>
        </view>
        <view wx:else class="vd-tip">这段视频还没有你确认过的命中时刻,展开后从开头暂停。</view>
        <view wx:if="{{ videoEvidence.olderCount > 0 }}" class="vd-tip">另有 {{ videoEvidence.olderCount }} 条更早视频;点「删除视频」会一并清理。</view>
        <view class="vd-actions">
          <view class="vd-textbtn" bindtap="onVideoRetakeTap">重拍</view>
          <view class="vd-textbtn danger" bindtap="onVideoDeleteTap">删除视频</view>
          <view class="vd-collapse" bindtap="onVideoToggle">收起</view>
        </view>

        <view class="vd-ai-zone">
          <view wx:if="{{ videoAiBusy === false && videoAiCandidates.length === 0 && videoSelected.playable }}" class="vd-ai-entry" bindtap="onVideoAiTap">🔎 AI 找这件物品</view>
          <view wx:if="{{ videoAiBusy }}" class="vd-ai-progress">
            {{ videoAiProgress }}
            <text class="vd-ai-cancel" catchtap="onVideoAiCancel">取消</text>
          </view>
          <view wx:if="{{ videoAiError }}" class="vd-ai-error">{{ videoAiError }}</view>
          <view wx:if="{{ videoAiNoHit }}" class="vd-ai-tip">这段视频里没找到清晰目标。可换一段更清楚的视频再试。</view>
          <view wx:if="{{ videoAiCandidates.length > 0 }}" class="vd-ai-panel">
            <view class="vd-ai-panel-title">AI 候选:勾选要保存的时间点</view>
            <scroll-view scroll-x="{{ true }}" class="vd-ai-scroll">
              <view
                wx:for="{{ videoAiCandidates }}"
                wx:key="key"
                class="vd-ai-card {{ item.selected ? 'selected' : '' }}"
                bindtap="onVideoAiCandidateToggle"
                data-key="{{ item.key }}"
              >
                <view class="vd-ai-thumb">
                  <image class="vd-ai-img" src="{{ item.framePath }}" mode="aspectFill" />
                  <view wx:if="{{ item.box }}" class="vd-box" style="{{ item.boxStyle }}"></view>
                  <view class="vd-ai-check">{{ item.selected ? '✓' : '' }}</view>
                </view>
                <view class="vd-ai-time">{{ item.timeText }}</view>
                <view class="vd-ai-conf">{{ item.confidenceText }}</view>
              </view>
            </scroll-view>
            <view class="vd-ai-actions">
              <view class="vd-textbtn" catchtap="onVideoAiCancel">放弃</view>
              <view class="vd-textbtn primary" catchtap="onVideoAiSave">保存选中高亮</view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="vd-fold" bindtap="onVideoToggle">
      <view class="vd-fold-face">{{ videoFoldText }}</view>
    </view>
  </view>
  <view wx:elif="{{ videoBusy }}" class="vd-empty">视频处理中…</view>
  <view wx:elif="{{ videoPending === null && videoLookupFailed === false }}" class="vd-empty" bindtap="onAddVideoTap">🎬 给这件物品拍一段视频留证</view>

  <!-- 照片证据回放(#3):照片是历史证据——只说明拍摄当日记录在哪,不冒充当前位置;
       位置已变更时以文字位置为准、旧照片作证据。拉取失败整卡不渲染(增强露出,静默) -->
  <view wx:if="{{ evidenceReady && evidence }}" class="ev-card">
    <!-- 折叠态:压暗缩略条,点开回放 -->
    <view wx:if="{{ !evidenceOpen }}" class="ev-fold" bindtap="onEvidenceTap">
      <image wx:if="{{ !evidence.latest.urlFail }}" class="ev-fold-img" src="{{ evidence.latest.photoUrl }}" mode="aspectFill" />
      <view wx:else class="ev-fold-fail">照片加载失败,点按重试</view>
      <view class="ev-chip">📍 点开看拍照留证</view>
    </view>
    <!-- 展开态:等比 contain 全幅(aspect-ratio 跟随原图,零裁切)+ 黄环脉冲框 + 当时记录角标 -->
    <block wx:else>
      <view class="ev-wrap" style="aspect-ratio: {{ evidence.latest.aspect }}" bindtap="onEvidenceTap">
        <image wx:if="{{ !evidence.latest.urlFail }}" class="ev-img" src="{{ evidence.latest.photoUrl }}" mode="aspectFill" />
        <view wx:else class="ev-fail">照片加载失败,点按重试</view>
        <view wx:if="{{ evidence.latest.box && !evidence.latest.urlFail }}" class="ev-box" style="left:{{ evidence.latest.box.left }}%;top:{{ evidence.latest.box.top }}%;width:{{ evidence.latest.box.width }}%;height:{{ evidence.latest.box.height }}%"></view>
        <view class="ev-ask">{{ evidence.latest.badge }}</view>
      </view>
      <view class="ev-meta">
        <view wx:if="{{ evidence.latest.changed }}" class="ev-changed">位置已变更</view>
        <view class="ev-sub {{ evidence.latest.changed ? 'moved' : '' }}">{{ evidence.latest.subText }}</view>
        <view class="ev-acts">
          <view class="ev-retake" hover-class="ev-retake-hover" hover-stay-time="80" bindtap="onRetakeTap">📸 重拍更新</view>
          <view wx:if="{{ evidence.olderCount > 0 }}" class="ev-older-toggle" bindtap="onEvidenceOlderToggle">
            {{ evidenceOlderOpen ? '收起更早照片' : '更早的照片 ' + evidence.olderCount + ' 张' }}
          </view>
        </view>
      </view>
      <!-- 更早的照片:同物品多次拍照,全部平铺(created_at 降序) -->
      <view wx:if="{{ evidenceOlderOpen }}" class="ev-older">
        <view wx:for="{{ evidence.older }}" wx:key="key" class="ev-wrap older" style="aspect-ratio: {{ item.aspect }}">
          <image wx:if="{{ !item.urlFail }}" class="ev-img" src="{{ item.photoUrl }}" mode="aspectFill" />
          <view wx:else class="ev-fail">照片加载失败</view>
          <view wx:if="{{ item.box && !item.urlFail }}" class="ev-box" style="left:{{ item.box.left }}%;top:{{ item.box.top }}%;width:{{ item.box.width }}%;height:{{ item.box.height }}%"></view>
          <view class="ev-ask">{{ item.badge }}</view>
        </view>
      </view>
    </block>
  </view>
  <!-- 拉取成功但没证据行:如实说明只有文字位置,给补拍入口(原型屏⑥ nocard) -->
  <view wx:elif="{{ evidenceNoPhoto }}" class="ev-none">
    <view class="ev-none-ico">📷</view>
    <view class="ev-none-main">
      <view class="ev-none-t">这件还没拍过照片</view>
      <view class="ev-none-s">只有文字位置,没有照片留证</view>
    </view>
    <view class="ev-none-go" hover-class="ev-none-go-hover" hover-stay-time="80" bindtap="onRetakeTap">去补拍</view>
  </view>

  <!-- 保质期行(#36):有 active 提醒才显示;到了那天出现在「快到期」里,不做任何推送承诺 -->
  <view wx:if="{{ expire }}" class="expire-row">
    <view class="expire-main">
      <view class="expire-t">{{ expire.mainText }}</view>
      <!-- 换算候选标注(#36 真机反馈三件 A):日期来自服务端对『原相对话』的闭集换算 -->
      <view wx:if="{{ expire.convertedNote }}" class="expire-sub converted-note">按『{{ expire.convertedNote }}』换算</view>
      <view class="expire-sub">到了那天,它会出现在「快到期」里</view>
    </view>
    <view class="r-done {{ remindBusy || conflictPending ? 'busy' : '' }}" bindtap="onExpireDoneTap"><view class="r-done-face">已处理</view></view>
  </view>

  <!-- 到期微信提醒显式入口(#36 真机手势规则):picker bindchange 无点击手势,订阅授权
       必须由真实 tap 发起;有生效提醒且本地未标记「已开启」才显示,accept 后收起
       (本地标记是展示启发式,权威记录在服务端 remind_subscriptions)。
       0.9.3(鸿蒙真机反馈):view+bindtap 在鸿蒙微信上丢手势令牌(requestSubscribeMessage
       报 can only be invoked by user TAP gesture),换原生 button+bindtap 直接触发 -->
  <button
    wx:if="{{ remindAt && !notifyAccepted }}"
    class="notify-chip"
    hover-class="notify-chip-hover"
    hover-stay-time="80"
    bindtap="onNotifyChipTap"
  >
    <view class="notify-chip-face">到期时微信提醒我 ›</view>
  </button>

  <!-- 订阅手势诊断入口(#36 鸿蒙真机手势排查,仅 develop 环境显示):素按钮二分实验页,
       正式版/体验版用户不可见 -->
  <view wx:if="{{ diagEntryVisible }}" class="diag-entry" bindtap="onDiagEntryTap">订阅手势诊断 ›</view>

  <!-- 编辑全部折叠:展开后是原有表单与保存路径(expected_version / 冲突处理不变) -->
  <view
    class="fold {{ editPanelOpen ? 'open' : '' }}"
    hover-class="fold-hover"
    hover-stay-time="80"
    bindtap="onEditToggle"
  >
    <text>编辑物品信息</text>
    <text class="fold-chev {{ editPanelOpen ? 'up' : '' }}">›</text>
  </view>
  <view class="fold-body {{ editPanelOpen ? 'open' : '' }}">
    <!-- 冲突面板(issue #6):保存或改提醒命中版本冲突后出现,逐字段并排
         「你的修改 / 最新记录」;未选完前下方保存按钮禁用,直接在表单里改不算选择 -->
    <view wx:if="{{ conflicts.length > 0 }}" class="card conflict-card">
      <view class="conflict-title">这些字段与最新记录冲突</view>
      <view class="conflict-desc">
        别的设备也改了这些字段。逐项选择保留哪一版后才能保存;在下面表单里直接改不算选择。
      </view>
      <view wx:for="{{ conflicts }}" wx:key="key" class="conflict-item">
        <view class="conflict-item-title">{{ item.label }}</view>
        <view class="conflict-row">
          <view class="conflict-side">
            <view class="conflict-side-label">你的修改</view>
            <view class="conflict-value">{{ item.localDisplay }}</view>
          </view>
          <view class="conflict-side">
            <view class="conflict-side-label">最新记录</view>
            <view class="conflict-value">{{ item.remoteDisplay }}</view>
          </view>
        </view>
        <view class="conflict-actions">
          <button
            class="btn conflict-btn {{ item.choice === 'local' ? 'primary' : '' }}"
            bindtap="onChooseLocal"
            data-key="{{ item.key }}"
          >
            <view class="btn-face">保留我的修改</view>
          </button>
          <button
            class="btn conflict-btn {{ item.choice === 'remote' ? 'primary' : '' }}"
            bindtap="onChooseRemote"
            data-key="{{ item.key }}"
          >
            <view class="btn-face">采用最新记录</view>
          </button>
        </view>
      </view>
    </view>
    <view class="card edit-card">
      <view class="field">
        <view class="label">名称</view>
        <input
          class="input"
          placeholder="物品名称(必填)"
          placeholder-class="placeholder"
          value="{{ name }}"
          maxlength="50"
          bindinput="onNameInput"
        />
      </view>
      <view class="field">
        <view class="label">位置(必填)</view>
        <input
          class="input"
          placeholder="放在哪里"
          placeholder-class="placeholder"
          value="{{ locationText }}"
          maxlength="200"
          bindinput="onLocationInput"
        />
      </view>
      <!-- 提醒字段(#36):无条件渲染——没有提醒的物品在这里补录,有提醒的在这里改;
           改=日期选择器弹层(唯一手动日期来源),✕=连日期一起清除 -->
      <view class="field">
        <view class="label">提醒</view>
        <view class="remind-field">
          <picker
            mode="date"
            value="{{ remindAt || today }}"
            start="{{ today }}"
            disabled="{{ remindBusy }}"
            bindchange="onRemindDateChange"
          >
            <view class="field-btn">
              <text wx:if="{{ remindAt }}" class="field-val">{{ remindAt }} 到期</text>
              <text wx:else class="field-ph">选一个日子;留空=不带提醒</text>
              <text class="field-chev">›</text>
            </view>
          </picker>
          <view wx:if="{{ remindAt }}" class="clearx" bindtap="onRemindFieldClear"><view class="clearx-face">✕</view></view>
        </view>
      </view>
      <view class="field">
        <view class="label">备注</view>
        <textarea
          class="textarea"
          placeholder="选填,最多 200 字"
          placeholder-class="placeholder"
          value="{{ note }}"
          maxlength="200"
          auto-height
          bindinput="onNoteInput"
        />
      </view>

      <button
        class="btn ink block"
        loading="{{ saving }}"
        disabled="{{ conflictPending }}"
        bindtap="onSaveTap"
      >
        <view class="btn-face">保存修改</view>
      </button>
      <view class="fold-note">与他处改动冲突时,保存前会先让你核对。</view>
    </view>
  </view>

  <!-- 整理位置:候选分段逐段核对,确认后才会创建位置并记入(ensurePath 只在确认后建节点) -->
  <view wx:if="{{ mountPanelOpen }}" class="card">
    <view class="card-title">整理位置(请核对)</view>
    <view class="hint">
      从大到小逐段核对,可以直接改;{{ mountOrderViolation ? '分段顺序与原文对不上,务必逐段核对。' : '' }}确认后才会记到这个位置。
    </view>
    <view
      wx:for="{{ mountSegments }}"
      wx:key="idx"
      class="field"
    >
      <view class="label">
        第 {{ index + 1 }} 段 · 把握 {{ item.confidenceText }}{{ item.needConfirm ? ' · 不太确定' : '' }}
      </view>
      <input
        class="input {{ item.needConfirm ? 'input-warn' : '' }}"
        value="{{ item.name }}"
        maxlength="30"
        data-index="{{ index }}"
        bindinput="onMountSegmentInput"
      />
      <view wx:if="{{ item.hintName }}" class="hint">
        与已有的「{{ item.hintName }}」同名,确认后直接用那个位置
      </view>
    </view>
      <button
        class="btn ink block"
        loading="{{ mountSaving }}"
        bindtap="confirmMount"
      >
        <view class="btn-face">确认放这里</view>
      </button>
      <button class="btn block" bindtap="cancelMount"><view class="btn-face">取消</view></button>
  </view>
</view>

<!-- 「⋯」次级菜单:底部弹层(分享给家人 / 整理位置 / 删除) -->
<view
  class="sheet-mask {{ moreOpen ? 'open' : '' }}"
  bindtap="onSheetClose"
  catchtouchmove="noop"
>
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{ name || '这件物品' }} · 更多</view>
    <view wx:if="{{ familyShared }}" class="sheet-act" hover-class="sheet-act-hover" hover-stay-time="60" bindtap="onShareTap">
      <view class="sheet-act-name">分享给家人</view>
      <view class="sheet-act-sub">家里人都能看到这条记录</view>
    </view>
    <view class="sheet-act" hover-class="sheet-act-hover" hover-stay-time="60" bindtap="onTidyTap">
      <view class="sheet-act-name">整理位置</view>
      <view class="sheet-act-sub">选择它属于哪个房间 / 家具</view>
    </view>
    <view class="sheet-act warn" hover-class="sheet-act-hover" hover-stay-time="60" bindtap="onDeleteTap">
      <view class="sheet-act-name">删除这条记录</view>
      <view class="sheet-act-sub">需要二次确认</view>
    </view>
    <view class="sheet-close" bindtap="onSheetClose">取消</view>
  </view>
</view>

<!-- 常驻语音条:按住说话记一件(issue #45 全局可达) -->
<voice-bar />
