<view class="page">
  <view wx:if="{{ conflicts.length > 0 }}" class="conflict-card">
    <view class="conflict-title">这些字段与最新记录冲突</view>
    <view class="conflict-desc">
      保存时检测到其他设备也修改了这些字段。逐项选择保留哪一版后才能再次保存;在输入框直接修改不会替代选择。
    </view>
    <view wx:for="{{ conflicts }}" wx:key="key" class="conflict-item">
      <view class="conflict-item-title">{{ item.label }}</view>
      <view class="conflict-row">
        <view class="conflict-side">
          <view class="conflict-side-label">你的修改</view>
          <view class="conflict-value">{{ item.localValue || '(空)' }}</view>
        </view>
        <view class="conflict-side">
          <view class="conflict-side-label">最新记录</view>
          <view class="conflict-value">{{ item.remoteValue || '(空)' }}</view>
        </view>
      </view>
      <view class="conflict-actions">
        <button
          class="btn conflict-btn {{ item.choice === 'local' ? 'primary' : '' }}"
          bindtap="onChooseLocal"
          data-key="{{ item.key }}"
        >
          保留我的修改
        </button>
        <button
          class="btn conflict-btn {{ item.choice === 'remote' ? 'primary' : '' }}"
          bindtap="onChooseRemote"
          data-key="{{ item.key }}"
        >
          采用最新记录
        </button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="meta">当前版本 v{{ version }} · 更新于 {{ updatedAtText }}</view>

    <view class="field">
      <view class="label">名称</view>
      <input
        class="input"
        placeholder="物品名称(必填)"
        placeholder-class="placeholder"
        value="{{ name }}"
        maxlength="50"
        bindinput="onNameInput"
      />
    </view>
    <view class="field">
      <view class="label">位置(必填)</view>
      <input
        class="input"
        placeholder="放在哪里"
        placeholder-class="placeholder"
        value="{{ locationText }}"
        maxlength="200"
        bindinput="onLocationInput"
      />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea
        class="textarea"
        placeholder="选填,最多 200 字"
        placeholder-class="placeholder"
        value="{{ note }}"
        maxlength="200"
        auto-height
        bindinput="onNoteInput"
      />
    </view>

    <button
      class="btn primary block"
      loading="{{ saving }}"
      disabled="{{ conflictPending }}"
      bindtap="onSaveTap"
    >
      保存修改
    </button>
    <button
      class="btn danger block"
      loading="{{ deleting }}"
      bindtap="onDeleteTap"
    >
      删除这条记录
    </button>
  </view>
</view>
