<view class="appearance-root" style="{{themeStyle}}">
<view class="page page-with-detail-dock">
  <view class="detail-head">
    <view class="detail-thumb">
      <image class="detail-art theme-light" src="{{artworkLight}}" mode="aspectFit" />
      <image class="detail-art theme-dark" src="{{artworkDark}}" mode="aspectFit" />
    </view>
    <view class="detail-title"><view class="pagetitle">{{recordedName || name}}</view><view class="detail-shared">{{familyShared ? '家人可见' : '个人记录'}}</view></view>
    <button class="detail-more" bindtap="onMoreTap" aria-label="更多操作">⋯</button>
  </view>
  <view wx:if="{{videoPending}}" class="detail-attention">
    <view>有一段视频还没关联到这件物品。</view><button class="detail-inline" bindtap="onPendingMediaTap">查看并处理 ›</button>
  </view>
  <view wx:if="{{conflicts.length > 0 || reminderNeedsSave}}" class="detail-attention">
    <view>有修改尚未保存，请核对后继续。</view><button class="detail-inline" bindtap="onContinueReviewTap">继续核对 ›</button>
  </view>
  <view class="bigcard">
    <view class="bigcard-lbl">上次记录位置</view>
    <view wx:if="{{spacePath.length}}" class="bigcard-path"><block wx:for="{{spacePath}}" wx:key="*this"><text>{{item}}</text><text wx:if="{{index < spacePath.length - 1}}" class="bigcard-sep">›</text></block></view>
    <view class="bigcard-location">{{recordedLocationText}}</view>
    <view class="detail-meta"><text>{{lastConfirmedText}}</text><text>物品可能已移动。</text></view>
    <view wx:if="{{ vagueQuote && !expire }}" class="bigcard-quote vague-quote">当时提到时间:『{{ vagueQuote }}』(没换算成日期)</view>
  </view>
  <view class="detail-rows">
    <button class="detail-row" bindtap="onQuantityPanelToggle"><view class="detail-row-symbol">□</view><text class="detail-row-label">数量</text><text class="detail-row-value strong">{{quantityShortText}}{{quantityIsZero ? ' · 目前没有' : ''}}</text><text class="detail-chevron">›</text></button>
    <button class="detail-row" bindtap="onOpenReminderTap"><view class="detail-row-icon"><image class="theme-light" src="/assets/icons/clock.png"/><image class="theme-dark" src="/assets/icons/clock-dark.png"/></view><text class="detail-row-label">到期提醒</text><text class="detail-row-value">{{recordedRemindAt ? recordedRemindAt + ' 到期' : '未设置'}}</text><text class="detail-chevron">›</text></button>
    <button class="detail-row" bindtap="onMediaEntryTap"><view class="detail-row-icon"><image class="theme-light" src="/assets/icons/camera.png"/><image class="theme-dark" src="/assets/icons/camera-dark.png"/></view><text class="detail-row-label">照片与视频</text><view class="detail-row-value"><block wx:if="{{videoPending}}">视频待关联</block><block wx:elif="{{photoLookupFailed || videoLookupFailed}}">部分留证待重试</block><block wx:elif="{{evidenceReady || videoReady}}"><text wx:if="{{evidenceReady}}">{{evidence.olderCount + 1}} 张照片</text><text wx:if="{{evidenceReady && videoReady}}"> · </text><text wx:if="{{videoReady}}">{{videoEvidence.all.length}} 段视频</text></block><block wx:else>查看或添加</block></view><text class="detail-chevron">›</text></button>
  </view>
  <view class="detail-footnote">{{quantityText}}。影像仅记录当时。</view>
</view>

<view wx:if="{{detailPanel}}" class="detail-panel-mask" catchtouchmove="noop" bindtap="onPanelClose">
  <view class="detail-panel detail-panel-{{detailPanel}}" catchtap="noop">
    <view class="detail-handle"></view>
    <view class="detail-panel-head"><view><view class="detail-panel-title">{{detailPanel === 'location' ? '放到哪里了？' : detailPanel === 'quantity' ? '现在有多少？' : detailPanel === 'reminder' ? '到期提醒' : detailPanel === 'media' ? '照片与视频' : '名称与备注'}}</view><view class="detail-panel-sub">{{recordedName || name}}</view></view><button class="detail-close" bindtap="onPanelClose" aria-label="关闭面板" disabled="{{saving || quantitySaving || remindBusy || reminderConfirming || mountSaving || locationCommitSaving}}">×</button></view>
    <scroll-view scroll-y class="detail-panel-body" scroll-into-view="{{mediaScrollTarget}}">
      <view wx:if="{{panelError}}" class="detail-attention panel-attention">{{panelError}}</view>
      <view wx:if="{{detailPanel === 'location' || detailPanel === 'info'}}" id="item-edit-panel">
    <!-- 冲突面板(issue #6):保存或改提醒命中版本冲突后出现,逐字段并排
         「你的修改 / 最新记录」;未选完前下方保存按钮禁用,直接在表单里改不算选择 -->
    <view wx:if="{{ conflicts.length > 0 }}" class="card conflict-card">
      <view class="conflict-title">这些字段与最新记录冲突</view>
      <view class="conflict-desc">
        别的设备也改了这些字段。逐项选择保留哪一版后才能保存;在下面表单里直接改不算选择。
      </view>
      <view wx:for="{{ conflicts }}" wx:key="key" class="conflict-item">
        <view class="conflict-item-title">{{ item.label }}</view>
        <view class="conflict-row">
          <view class="conflict-side">
            <view class="conflict-side-label">你的修改</view>
            <view class="conflict-value">{{ item.localDisplay }}</view>
          </view>
          <view class="conflict-side">
            <view class="conflict-side-label">最新记录</view>
            <view class="conflict-value">{{ item.remoteDisplay }}</view>
          </view>
        </view>
        <view class="conflict-actions">
          <button
            class="btn conflict-btn {{ item.choice === 'local' ? 'primary' : '' }}"
            bindtap="onChooseLocal"
            data-key="{{ item.key }}"
          >
            <view class="btn-face">保留我的修改</view>
          </button>
          <button
            class="btn conflict-btn {{ item.choice === 'remote' ? 'primary' : '' }}"
            bindtap="onChooseRemote"
            data-key="{{ item.key }}"
          >
            <view class="btn-face">采用最新记录</view>
          </button>
        </view>
      </view>
    </view>

        <view wx:if="{{detailPanel === 'info'}}" class="field"><view class="label">名称</view><input class="input" value="{{name}}" maxlength="50" disabled="{{saving}}" bindinput="onNameInput" /></view>
        <view wx:if="{{detailPanel === 'location'}}" class="field"><view class="label">归类位置</view><button class="field-btn" bindtap="openLocationPicker" disabled="{{saving || mountSaving || locationCommitSaving}}"><text class="field-val"><block wx:if="{{locationPathDraft.length}}" wx:for="{{locationPathDraft}}" wx:key="*this">{{item}}{{index < locationPathDraft.length - 1 ? ' / ' : ''}}</block><block wx:if="{{!locationPathDraft.length}}">选择已有位置（可选）</block></text><text class="field-chev">›</text></button></view>
        <view wx:if="{{detailPanel === 'location' || conflicts.length > 0}}" class="field"><view class="label">具体放在哪里</view><textarea class="textarea" value="{{locationText}}" maxlength="200" disabled="{{saving || mountSaving || locationCommitSaving}}" bindinput="onLocationInput" /></view>
        <view wx:if="{{detailPanel === 'info'}}" class="field"><view class="label">备注</view><textarea class="textarea" value="{{note}}" maxlength="200" disabled="{{saving}}" bindinput="onNoteInput" /></view>
        <view wx:if="{{detailPanel === 'location'}}" class="detail-preview"><view class="label">确认后记录为</view><view wx:if="{{locationPathDraft.length}}" class="hint"><block wx:for="{{locationPathDraft}}" wx:key="*this">{{item}}{{index < locationPathDraft.length - 1 ? ' / ' : ''}}</block></view><view class="detail-preview-text">{{locationText || '请补充具体位置'}}</view></view>
        <view wx:if="{{detailPanel === 'location'}}" class="hint">只更新位置，数量、提醒和历史影像继续保留。</view>
        <button wx:if="{{detailPanel === 'location'}}" class="detail-inline" bindtap="onMountTap" disabled="{{saving || mountSaving || locationCommitSaving}}">按已保存的描述整理归类</button>
  <!-- 整理位置:候选分段逐段核对,确认后才会创建位置并记入(ensurePath 只在确认后建节点) -->
  <view wx:if="{{ mountPanelOpen }}" class="card">
    <view class="card-title">整理位置(请核对)</view>
    <view class="hint">
      从大到小逐段核对,可以直接改;{{ mountOrderViolation ? '分段顺序与原文对不上,务必逐段核对。' : '' }}确认后才会记到这个位置。
    </view>
    <view
      wx:for="{{ mountSegments }}"
      wx:key="idx"
      class="field"
    >
      <view class="label">
        第 {{ index + 1 }} 段 · 把握 {{ item.confidenceText }}{{ item.needConfirm ? ' · 不太确定' : '' }}
      </view>
      <input
        class="input {{ item.needConfirm ? 'input-warn' : '' }}"
        value="{{ item.name }}"
        maxlength="30"
        data-index="{{ index }}"
        bindinput="onMountSegmentInput"
      />
      <view wx:if="{{ item.hintName }}" class="hint">
        与已有的「{{ item.hintName }}」同名,确认后直接用那个位置
      </view>
    </view>
      <button
        class="btn ink block"
        loading="{{ mountSaving }}"
        bindtap="confirmMount"
      >
        <view class="btn-face">确认放这里</view>
      </button>
      <button class="btn block" bindtap="cancelMount"><view class="btn-face">取消</view></button>
  </view>
      </view>
      <view wx:if="{{detailPanel === 'quantity'}}">
        <view class="field"><view class="label">当前总数</view><view class="detail-number-fields"><view class="detail-stepper"><button data-delta="-1" bindtap="onQuantityStep" disabled="{{quantitySaving}}" aria-label="减少数量">−</button><input class="input" type="number" value="{{quantityDraft}}" placeholder="待核对" disabled="{{quantitySaving}}" bindinput="onQuantityInput"/><button data-delta="1" bindtap="onQuantityStep" disabled="{{quantitySaving}}" aria-label="增加数量">+</button></view><picker range="{{unitOptions}}" value="{{quantityUnitIndex}}" disabled="{{quantitySaving}}" bindchange="onQuantityUnitChange"><view class="detail-unit">{{unitOptions[quantityUnitIndex]}} ›</view></picker></view></view>
        <view class="detail-preview"><view class="label">上次确认</view><view>{{quantityText}}</view></view>
        <view class="hint">填 0 表示目前没有，物品记录、位置、提醒和影像仍然保留。</view>
        <checkbox-group wx:if="{{quantityUnitChanged}}" bindchange="onQuantityUnitVerify"><label class="detail-unit-check"><checkbox value="verified" checked="{{quantityUnitVerified}}" disabled="{{quantitySaving}}"/><text>如果更改单位，我已按新单位重新核对总数</text></label></checkbox-group>
      </view>
      <view wx:if="{{detailPanel === 'reminder'}}">
        <view class="field remind-set-row"><view class="label">到期日期</view><picker mode="date" value="{{reminderDateDraft || pickerStart}}" start="{{pickerStart}}" disabled="{{remindBusy || saving}}" bindchange="onReminderDraftChange"><view class="field-btn"><text class="field-val">{{reminderDateDraft || '选择日期'}}</text><text class="field-chev">›</text></view></picker></view>
        <view class="hint">设置后会出现在小程序的到期列表。</view>
        <view wx:if="{{expire && expire.convertedNote}}" class="expire-sub converted-note">按『{{ expire.convertedNote }}』换算，请核对日期。</view>
        <!-- 到期微信提醒显式入口：保留真实 button tap，不在 picker change 自动申请 -->
        <view class="detail-notify"><view><view>微信消息提醒</view><view class="hint">{{notifyAccepted ? '本机已记录开启状态' : '需在微信中单独开启'}}</view></view><button wx:if="{{remindAt && !notifyAccepted}}" class="notify-chip" bindtap="onNotifyChipTap"><view class="notify-chip-face">开启微信提醒 ›</view></button><view wx:elif="{{!remindAt}}" class="hint">先确认日期</view></view>
        <view class="detail-reminder-actions"><button wx:if="{{expire}}" class="detail-inline" bindtap="onExpireDoneTap" disabled="{{remindBusy || conflictPending}}">已处理这次提醒</button><button wx:if="{{remindAt}}" class="detail-inline danger" bindtap="onRemindFieldClear" disabled="{{remindBusy}}">清除提醒</button></view>
        <view wx:if="{{reminderNeedsSave || conflictPending}}" class="detail-attention panel-attention">提醒修改尚未保存，请核对冲突后继续。<button class="detail-inline" bindtap="onContinueReviewTap">继续核对 ›</button></view>
        <view wx:if="{{diagEntryVisible}}" class="diag-entry" bindtap="onDiagEntryTap">订阅手势诊断 ›</view>
      </view>
      <view wx:if="{{detailPanel === 'media'}}">
        <view class="detail-media-tabs"><button class="{{mediaTab === 'photo' ? 'selected' : ''}}" data-tab="photo" bindtap="onMediaTabTap">照片</button><button class="{{mediaTab === 'video' ? 'selected' : ''}}" data-tab="video" bindtap="onMediaTabTap">视频</button></view>
        <view wx:if="{{mediaTab === 'video'}}">
  <view wx:if="{{ videoPending }}" class="vd-pending">
    <view class="vd-pending-title">视频待关联</view>
    <view class="vd-pending-sub">{{ videoPendingText }}</view>
    <view class="vd-pending-actions">
      <view wx:if="{{ videoPendingExpired === false }}" class="vd-textbtn" bindtap="onVideoPendingRetryTap">重试关联</view>
      <view class="vd-textbtn danger" bindtap="onVideoPendingDiscardTap">删除待关联视频</view>
    </view>
  </view>

  <view wx:if="{{ videoLookupFailed }}" id="video-evidence-card" class="vd-card">
    <view class="vd-head">
      <view class="vd-title">当时的视频</view>
      <view class="vd-more" bindtap="onVideoMoreTap">说明</view>
    </view>
    <view class="vd-fail-inline" bindtap="onVideoRetry">视频留证暂时无法加载,点按重试</view>
  </view>

  <view wx:if="{{ videoReady && videoEvidence && videoSelected }}" id="video-evidence-card" class="vd-card">
    <view class="vd-head">
      <view class="vd-title">当时的视频</view>
      <view class="vd-more" bindtap="onVideoMoreTap">说明</view>
    </view>
    <block wx:if="{{ videoOpen }}">
      <view wx:if="{{ videoPlaybackNotice }}" class="vd-notice">{{ videoPlaybackNotice }}</view>
      <scroll-view wx:if="{{ videoEvidence.all.length > 1 }}" scroll-x="{{ true }}" class="vd-evidence-scroll">
        <view
          wx:for="{{ videoEvidence.all }}"
          wx:key="evidenceId"
          class="vd-evidence-chip {{ item.evidenceId === videoSelected.evidenceId ? 'selected' : '' }} {{ item.playable === false ? 'unavailable' : '' }}"
          data-evidence-id="{{ item.evidenceId }}"
          bindtap="onVideoEvidenceSelect"
        >
          {{ item.dateText }}<text wx:if="{{ item.highlightCount > 0 }}"> · {{ item.highlightCount }}段</text><text wx:if="{{ item.playable === false }}"> · 暂不可播</text>
        </view>
      </scroll-view>
      <view class="vd-wrap" style="aspect-ratio: {{ videoSelected.aspect }};">
        <video
          wx:if="{{ videoSelected.playable && videoPlaybackError === '' }}"
          id="videoEvidencePlayer"
          class="vd-video"
          src="{{ videoSelected.videoUrl }}"
          autoplay="{{ false }}"
          controls="{{ true }}"
          object-fit="contain"
          show-center-play-btn="{{ true }}"
          enable-progress-gesture="{{ true }}"
          initial-time="{{ videoInitialTime }}"
          bindloadedmetadata="onVideoLoadedMetadata"
          bindtimeupdate="onVideoTimeUpdate"
          binderror="onVideoPlaybackError"
        ></video>
        <view wx:else class="vd-fail" bindtap="onVideoRetry">{{ videoPlaybackError || '视频加载失败,点按重试' }}</view>
        <view
          wx:if="{{ videoActiveBox && videoSelected.playable && videoPlaybackError === '' }}"
          class="vd-box"
          style="left:{{ videoActiveBox.left }}%;top:{{ videoActiveBox.top }}%;width:{{ videoActiveBox.width }}%;height:{{ videoActiveBox.height }}%"
        ></view>
      </view>
      <view class="vd-meta">
        <view wx:if="{{ videoSelected.changed }}" class="vd-changed">位置已变更</view>
        <view class="vd-sub">{{ videoSelected.badge }}</view>
        <view class="vd-sub {{ videoSelected.changed ? 'moved' : '' }}">{{ videoSelected.subText }}</view>
        <view class="vd-tip">视频只说明当时记录在哪,不冒充当前位置;你确认过的片段也可能有偏差。播放需你明确点击。</view>
        <view wx:if="{{ videoSelected.highlights.length > 0 }}" class="vd-points">
          <view class="vd-points-title">你确认过的片段(点时间只定位,不自动播放)</view>
          <scroll-view scroll-x="{{ true }}" class="vd-points-scroll">
            <view
              wx:for="{{ videoSelected.highlights }}"
              wx:key="key"
              class="vd-point {{ videoSelectedHighlightKey === item.key ? 'selected' : '' }}"
              data-highlight-key="{{ item.key }}"
              bindtap="onVideoHighlightTap"
            >
              {{ item.rangeText }}<text wx:if="{{ item.hasBox }}"> · 有框</text>
            </view>
          </scroll-view>
        </view>
        <view wx:else class="vd-tip">这段视频还没有你确认过的命中时刻,展开后从开头暂停。</view>
        <view wx:if="{{ videoEvidence.olderCount > 0 }}" class="vd-tip">另有 {{ videoEvidence.olderCount }} 条更早视频;点「删除视频」会一并清理。</view>
        <view class="vd-actions">
          <view class="vd-textbtn" bindtap="onVideoRetakeTap">重拍</view>
          <view class="vd-textbtn danger" bindtap="onVideoDeleteTap">删除视频</view>
          <view class="vd-collapse" bindtap="onVideoToggle">收起</view>
        </view>

        <view class="vd-ai-zone">
          <view wx:if="{{ videoAiBusy === false && videoAiCandidates.length === 0 && videoSelected.playable }}" class="vd-ai-entry" bindtap="onVideoAiTap">🔎 AI 找这件物品</view>
          <view wx:if="{{ videoAiBusy }}" class="vd-ai-progress">
            {{ videoAiProgress }}
            <text class="vd-ai-cancel" catchtap="onVideoAiCancel">取消</text>
          </view>
          <view wx:if="{{ videoAiError }}" class="vd-ai-error">{{ videoAiError }}</view>
          <view wx:if="{{ videoAiNoHit }}" class="vd-ai-tip">这段视频里没找到清晰目标。可换一段更清楚的视频再试。</view>
          <view wx:if="{{ videoAiCandidates.length > 0 }}" class="vd-ai-panel">
            <view class="vd-ai-panel-title">AI 候选:勾选要保存的时间点</view>
            <scroll-view scroll-x="{{ true }}" class="vd-ai-scroll">
              <view
                wx:for="{{ videoAiCandidates }}"
                wx:key="key"
                class="vd-ai-card {{ item.selected ? 'selected' : '' }}"
                bindtap="onVideoAiCandidateToggle"
                data-key="{{ item.key }}"
              >
                <view class="vd-ai-thumb">
                  <image class="vd-ai-img" src="{{ item.framePath }}" mode="aspectFill" />
                  <view wx:if="{{ item.box }}" class="vd-box" style="{{ item.boxStyle }}"></view>
                  <view class="vd-ai-check">{{ item.selected ? '✓' : '' }}</view>
                </view>
                <view class="vd-ai-time">{{ item.timeText }}</view>
                <view class="vd-ai-conf">{{ item.confidenceText }}</view>
              </view>
            </scroll-view>
            <view class="vd-ai-actions">
              <view class="vd-textbtn" catchtap="onVideoAiCancel">放弃</view>
              <view class="vd-textbtn primary" catchtap="onVideoAiSave">保存选中高亮</view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="vd-fold" bindtap="onVideoToggle">
      <view class="vd-fold-face">{{ videoFoldText }}</view>
    </view>
  </view>
  <view wx:elif="{{ videoBusy }}" class="vd-empty">视频处理中…</view>
  <view wx:elif="{{ videoPending === null && videoLookupFailed === false }}" class="vd-empty" bindtap="onAddVideoTap">添加视频留证</view>


        </view>
        <view wx:if="{{mediaTab === 'photo'}}">
          <view wx:if="{{photoLookupFailed}}" class="detail-attention panel-attention">照片暂时无法加载。<button class="detail-inline" bindtap="refreshEvidence">重试加载</button></view>
  <!-- 照片证据回放(#3):照片是历史证据——只说明拍摄当日记录在哪,不冒充当前位置;
       位置已变更时以文字位置为准、旧照片作证据。拉取失败整卡不渲染(增强露出,静默) -->
  <view wx:if="{{ evidenceReady && evidence }}" class="ev-card">
    <!-- 折叠态:压暗缩略条,点开回放 -->
    <view wx:if="{{ !evidenceOpen }}" class="ev-fold" bindtap="onEvidenceTap">
      <image wx:if="{{ !evidence.latest.urlFail }}" class="ev-fold-img" src="{{ evidence.latest.photoUrl }}" mode="aspectFill" />
      <view wx:else class="ev-fold-fail">照片加载失败,点按重试</view>
      <view class="ev-chip">查看照片</view>
    </view>
    <!-- 展开态:等比 contain 全幅(aspect-ratio 跟随原图,零裁切)+ 黄环脉冲框 + 当时记录角标 -->
    <block wx:else>
      <view class="ev-wrap" style="aspect-ratio: {{ evidence.latest.aspect }}" bindtap="onEvidenceTap">
        <image wx:if="{{ !evidence.latest.urlFail }}" class="ev-img" src="{{ evidence.latest.photoUrl }}" mode="aspectFill" />
        <view wx:else class="ev-fail">照片加载失败,点按重试</view>
        <view wx:if="{{ evidence.latest.box && !evidence.latest.urlFail }}" class="ev-box" style="left:{{ evidence.latest.box.left }}%;top:{{ evidence.latest.box.top }}%;width:{{ evidence.latest.box.width }}%;height:{{ evidence.latest.box.height }}%"></view>
        <view class="ev-ask">{{ evidence.latest.badge }}</view>
      </view>
      <view class="ev-meta">
        <view wx:if="{{ evidence.latest.changed }}" class="ev-changed">位置已变更</view>
        <view class="ev-sub {{ evidence.latest.changed ? 'moved' : '' }}">{{ evidence.latest.subText }}</view>
        <view class="ev-acts">
          <view class="ev-retake" hover-class="ev-retake-hover" hover-stay-time="80" bindtap="onRetakeTap">📸 重拍更新</view>
          <view wx:if="{{ evidence.olderCount > 0 }}" class="ev-older-toggle" bindtap="onEvidenceOlderToggle">
            {{ evidenceOlderOpen ? '收起更早照片' : '更早的照片 ' + evidence.olderCount + ' 张' }}
          </view>
        </view>
      </view>
      <!-- 更早的照片:同物品多次拍照,全部平铺(created_at 降序) -->
      <view wx:if="{{ evidenceOlderOpen }}" class="ev-older">
        <view wx:for="{{ evidence.older }}" wx:key="key" class="ev-wrap older" style="aspect-ratio: {{ item.aspect }}">
          <image wx:if="{{ !item.urlFail }}" class="ev-img" src="{{ item.photoUrl }}" mode="aspectFill" />
          <view wx:else class="ev-fail">照片加载失败</view>
          <view wx:if="{{ item.box && !item.urlFail }}" class="ev-box" style="left:{{ item.box.left }}%;top:{{ item.box.top }}%;width:{{ item.box.width }}%;height:{{ item.box.height }}%"></view>
          <view class="ev-ask">{{ item.badge }}</view>
        </view>
      </view>
    </block>
  </view>
  <!-- 拉取成功但没证据行:如实说明只有文字位置,给补拍入口(原型屏⑥ nocard) -->
  <view wx:elif="{{ evidenceNoPhoto }}" class="ev-none">

    <view class="ev-none-main">
      <view class="ev-none-t">照片留证</view>

    </view>
    <view class="ev-none-go" hover-class="ev-none-go-hover" hover-stay-time="80" bindtap="onRetakeTap">去补拍</view>
  </view>


        </view>
      </view>
    </scroll-view>
    <view wx:if="{{detailPanel !== 'media'}}" class="detail-panel-actions">
      <button class="detail-cancel" bindtap="onPanelClose" disabled="{{saving || quantitySaving || remindBusy || reminderConfirming || mountSaving || locationCommitSaving}}">取消</button>
      <button wx:if="{{detailPanel === 'location'}}" class="detail-confirm" loading="{{saving || mountSaving || locationCommitSaving}}" disabled="{{conflictPending}}" bindtap="onSaveLocationTap">确认更新位置</button>
      <button wx:elif="{{detailPanel === 'quantity'}}" class="detail-confirm" loading="{{quantitySaving}}" bindtap="onQuantitySaveTap">确认数量</button>
      <button wx:elif="{{detailPanel === 'reminder'}}" class="detail-confirm" loading="{{remindBusy || saving || reminderConfirming}}" disabled="{{reminderConfirming}}" bindtap="onReminderConfirmTap">确认日期</button>
      <button wx:else class="detail-confirm" loading="{{saving}}" disabled="{{conflictPending}}" bindtap="onSaveTap">保存修改</button>
    </view>
  </view>
</view>

<view class="sheet-mask {{moreOpen ? 'open' : ''}}" bindtap="onSheetClose" catchtouchmove="noop"><view class="sheet" catchtap="noop"><view class="sheet-title">{{recordedName || name}} · 更多</view><button class="sheet-act" bindtap="onEditToggle"><view class="sheet-act-name">编辑名称与备注</view><text>›</text></button><view wx:if="{{familyShared}}" class="sheet-act"><view class="sheet-act-name">共享状态</view><view class="sheet-act-sub">家人可见</view></view><button class="sheet-act warn" bindtap="onDeleteTap"><view class="sheet-act-name">删除这条记录</view><view class="sheet-act-sub">需要二次确认</view></button><button class="sheet-close" bindtap="onSheetClose">取消</button></view></view>
<view wx:if="{{!detailPanel}}" class="detail-dock"><button class="detail-found" bindtap="onFoundTap" disabled="{{saving || deleting || mountSaving || quantitySaving || locationCommitSaving}}"><text class="found-check">✓</text>找到了</button><button class="detail-update" bindtap="onUpdateLocationTap" disabled="{{saving || deleting || mountSaving || quantitySaving || locationCommitSaving}}">更新位置</button></view>
</view>
