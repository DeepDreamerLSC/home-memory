/* 我的家(空间树)页面:复用 app.wxss 的卡片/条目语言,颜色只用全局 CSS 变量 */

/* 面包屑行:路径 + 后台刷新轻量指示(不整页 loading);左右边距对齐全局 36rpx */
.crumb-row {
  display: flex;
  align-items: center;
  margin: 24rpx 36rpx 0;
}

.crumb {
  font-size: 24rpx;
  color: var(--text-3);
}

.refresh-flag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 刷新失败:保留旧树,如实提示上次记录(可点按重试) */
.stale-banner {
  margin: 24rpx 36rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
  font-size: 24rpx;
  color: var(--text);
}

/* 首载骨架屏:占位几何与真实条目一致(图标块 + 两行文字) */
.skeleton .skel-crumb {
  margin: 24rpx 36rpx 0;
  width: 220rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: var(--card-inset);
}

.skel-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.skel-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: var(--card-inset);
}

.skel-main {
  flex: 1;
  min-width: 0;
}

.skel-line {
  border-radius: 8rpx;
  background: var(--card-inset);
}

.skel-line-name {
  width: 40%;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.skel-line-sub {
  width: 60%;
  height: 22rpx;
}

/* 轻微呼吸(只动透明度,不引入新颜色) */
.skel-crumb,
.skel-icon,
.skel-line {
  animation: skel-pulse 1.2s ease-in-out infinite;
}

@keyframes skel-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* 生成 / 更新空间树常驻入口(次级行,item-row 同款节奏) */
.scan-entry {
  display: flex;
  align-items: center;
}

.warn-line {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
  font-size: 24rpx;
  color: var(--text);
}

.add-link {
  font-size: 26rpx;
  color: var(--text-2);
  padding: 0 0 0 16rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  line-height: 1;
}

/* 「⋯」管理入口:足够大的点击热区(Fix 1:透明内边距延伸到 ≥88rpx) */
.row-more {
  margin-left: 12rpx;
  padding: 26rpx 8rpx 26rpx 20rpx;
  color: var(--text-3);
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* 选择模式:选中动作与禁用态 */
.pick-check {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-dim);
  color: var(--text-2);
  font-size: 24rpx;
  flex-shrink: 0;
}

.row-disabled .item-icon {
  opacity: 0.35;
}

.row-disabled .item-name,
.row-disabled .item-location {
  color: var(--text-3);
}

.row-note {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  max-width: 220rpx;
  text-align: right;
}

/* 选择模式行内动作组:「选这个」+ 下钻 */
.row-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 选择模式:当前层直选卡(「就选这里」) */
.pick-current {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--accent-dim);
}

/* 共享家庭标识(面包屑行内,真机反馈:加入后需表明当前家庭) */
.family-flag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-dim, #f3edd9);
  color: var(--text-2, #4c483e);
  font-size: 22rpx;
  flex-shrink: 0;
}

/* ------------------------------------------------------------------ */
/* D1(#94)位置级视频清点:底部入口卡 + 删除位置三按钮弹层              */

/* 底部入口卡(仅 browse 且非根层):点整卡拍摄,点「回看」进回放 */
.scan-entry-card .scan-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.scan-entry-card .pick-check {
  flex-shrink: 0;
}

/* 三按钮弹层:遮罩 + 底部面板 */
.layer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.delete-layer {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.delete-layer .hint {
  text-align: left;
}

/* ------------------------------------------------------------------ */
/* D2(#96)清点历史:半屏弹层(列表 / 行内回看 / 删除确认)            */

/* 历史弹层面板:遮罩复用 .layer-mask,面板同 .delete-layer 的底部半屏语言 */
.scan-history-layer {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 回看播放器:高度 JS 计算 px 喂 inline(契约 §8 实现纪律),这里只管底色圆角 */
.scan-history-video {
  width: 100%;
  border-radius: 12rpx;
  background: var(--card-inset);
}

/* 历史行:时间 / 候选·确认 + 回看 / 删(item-row 同款节奏) */
.scan-history-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.scan-history-row .pick-check {
  flex-shrink: 0;
}

/* 行内「删」:危险色次级文字按钮,热区对齐 .row-more 的 ≥88rpx 纪律 */
.scan-history-del {
  margin-left: 12rpx;
  padding: 26rpx 8rpx 26rpx 20rpx;
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}
