<view class="appearance-root" style="{{themeStyle}}">
<view class="page page-with-voice-bar">
  <!-- 选择模式说明头 -->
  <view wx:if="{{ mode === 'pick' }}" class="card">
    <view class="card-title">{{ pickTitle }}</view>
    <view class="hint">想选哪一层就进到哪一层,顶部「就选这里」选定当前层;叶子位置点行即可。不能选的会标出原因。</view>
  </view>

  <!-- 无缓存首载:骨架屏(占位几何与真实列表一致,不再是一行干巴巴的「加载中」) -->
  <view wx:if="{{ loading }}" class="skeleton">
    <view class="skel-crumb"></view>
    <view class="card">
      <view class="skel-row" wx:for="{{ [0, 1, 2, 3] }}" wx:key="*this">
        <view class="skel-icon"></view>
        <view class="skel-main">
          <view class="skel-line skel-line-name"></view>
          <view class="skel-line skel-line-sub"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{ loadError }}" class="card">
    <view class="error-text">{{ loadError }}</view>
    <button class="btn block" bindtap="onRetryTap"><view class="btn-face">重试</view></button>
  </view>

  <block wx:else>
    <view class="crumb-row {{ highlightId === currentNodeId && !isRoot ? 'row-hl' : '' }}">
      <view wx:if="{{ headIcon }}" class="head-icon"><image class="loc-icon theme-light" src="{{ headIcon }}" mode="aspectFit"/><image class="loc-icon theme-dark" src="{{ headIconDark }}" mode="aspectFit"/></view>
      <view class="crumb">{{ breadcrumbText }}</view>
      <view wx:if="{{ familyShared }}" class="family-flag">共享家庭·{{ familyName }}</view>
      <view wx:if="{{ refreshing }}" class="refresh-flag">同步中…</view>
    </view>

    <!-- 选择模式非根层:当前层可直接选中(下钻过深不必退回找「选这个」) -->
    <view
      wx:if="{{ mode === 'pick' && !isRoot }}"
      class="card pick-current"
      bindtap="onPickCurrentTap"
    >
      <view class="item-main">
        <view class="item-name">就选这里:「{{ currentNodeName }}」</view>
        <view class="item-location">选当前这一层;往里找可继续点下面的位置</view>
      </view>
      <view class="pick-check">选</view>
    </view>

    <!-- 后台刷新失败:保留旧树,如实提示并可重试(点按=强制刷新) -->
    <view wx:if="{{ stale }}" class="stale-banner" bindtap="onRetryTap">
      当前为上次记录(刷新失败),下拉或点按重试
    </view>

    <!-- 根层常驻入口:生成 / 更新空间树(浏览模式) -->
    <view wx:if="{{ mode === 'browse' && isRoot && (canScan || hasRooms) }}" class="card">
      <view class="scan-entry" bindtap="onScanTap">
        <view class="item-main">
          <view class="item-name">{{ hasRooms ? '生成 / 更新空间树' : '从已录入物品生成空间' }}</view>
          <view class="item-location">
            {{ canScan ? unmountedCount + ' 件未归位' : '全部已归位' }}{{ hasRooms ? '' : ',AI 整理后逐条让你确认' }}
          </view>
        </view>
        <view class="chevron">›</view>
      </view>
      <view wx:if="{{ danglingMounts > 0 }}" class="warn-line">
        {{ danglingMounts }} 件挂载异常(位置可能刚被移动或删除),建议进来重新挂载
      </view>
    </view>
    <view wx:elif="{{ mode === 'browse' && isRoot }}" class="card">
      <view class="empty-text">还没建过空间。先去首页记几件东西,再回来生成空间树。</view>
    </view>

    <!-- 子位置列表 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title">位置</view>
        <view wx:if="{{ mode === 'browse' }}" class="row-more add-plus" catchtap="onAddTap">＋</view>
      </view>
      <view wx:if="{{ children.length === 0 }}" class="empty-text">
        {{ isRoot ? '还没有房间。右上角「＋」一键加常用房间,或从上方生成空间树。' : '这里还没有更细的位置。' }}
      </view>
      <view
        wx:for="{{ children }}"
        wx:key="location_id"
        class="item-row {{ item.disabled || item.deleting ? 'row-disabled' : '' }} {{ highlightId === item.location_id ? 'row-hl' : '' }}"
        data-index="{{ index }}"
        bindtap="onChildTap"
        bindlongpress="onChildLongPress"
      >
        <view class="item-icon"><block wx:if="{{ item.icon }}"><image class="loc-icon theme-light" src="{{ item.icon }}" mode="aspectFit"/><image class="loc-icon theme-dark" src="{{ item.iconDark }}" mode="aspectFit"/></block><block wx:else>{{ item.name[0] }}</block></view>
        <view class="item-main">
          <view class="item-name">{{ item.name }}</view>
          <view class="item-location">{{ item.countText }}</view>
        </view>
        <view wx:if="{{ item.deleting }}" class="row-note">清理中</view>
        <view wx:if="{{ mode === 'pick' && item.disabled }}" class="row-note">{{ item.disabledReason }}</view>
        <view wx:if="{{ mode === 'pick' && !item.disabled }}" class="row-actions">
          <view class="pick-check" catchtap="onPickTap" data-index="{{ index }}">选这个</view>
          <view wx:if="{{ item.child_count > 0 }}" class="chevron" catchtap="onChildTap" data-index="{{ index }}">›</view>
        </view>
        <view wx:if="{{ mode === 'browse' }}" class="row-more" catchtap="onChildMore" data-index="{{ index }}">⋯</view>
      </view>
    </view>

    <!-- 本层物品(浏览模式;物品不允许直接挂 home 根,根层恒为空故不显示) -->
    <view wx:if="{{ mode === 'browse' && items.length > 0 }}" class="card">
      <view class="card-title">这里的物品</view>
      <view
        wx:for="{{ items }}"
        wx:key="item_id"
        class="item-row {{ highlightId === item.item_id ? 'row-hl' : '' }}"
        data-index="{{ index }}"
        bindtap="onItemTap"
        bindlongpress="onItemLongPress"
      >
        <view class="item-icon">{{ item.name[0] }}</view>
        <view class="item-main">
          <view class="item-name">{{ item.name }}</view>
          <view class="item-location">原始记录:{{ item.location_text }}</view>
        </view>
        <view class="row-more" catchtap="onItemMore" data-index="{{ index }}">⋯</view>
      </view>
    </view>

    <!-- D1(#94)底部入口卡:仅 browse 且非根层;点整卡拍摄,点「回看」进回放;D2(#96)「历史」开清点历史弹层 -->
    <view wx:if="{{ mode === 'browse' && hasScanEntry }}" class="card scan-entry-card">
      <view class="scan-entry" bindtap="onScanEntryTap">
        <view class="item-main">
          <view class="item-name">📹 拍视频清点这里</view>
          <view wx:if="{{ scanSummaryText }}" class="item-location">{{ scanSummaryText }}</view>
        </view>
        <view wx:if="{{ scanSummaryText }}" class="row-actions">
          <view class="pick-check" catchtap="onScanHistoryTap">历史</view>
          <view class="pick-check" catchtap="onScanReviewTap">回看</view>
        </view>
        <view wx:else class="chevron">›</view>
      </view>
    </view>
  </block>
</view>

<!-- D1(#94)+#116 删除位置四选弹层:影响面文案 + 取消/迁移/转为未归类/全部删除(全部删除保留独立二次确认) -->
<view wx:if="{{ deleteLayer.visible }}" class="layer-mask" bindtap="onDeleteLayerCancel">
  <view class="delete-layer" catchtap="noop">
    <view class="card-title">删除「{{ deleteLayer.name }}」</view>
    <view class="hint">{{ deleteLayer.countsText }}</view>
    <view wx:if="{{ deleteLayer.scanCount > 0 }}" class="hint">
      含 {{ deleteLayer.scanCount }} 次视频清点记录
    </view>
    <!-- #116(D0 §3.1 发现点一):上次「转为未归类」未完成 ⇒ 如实提示续跑(用户显式触发,绝不自动) -->
    <view wx:if="{{ deleteLayer.pendingUnmount }}" class="hint">
      上次「转为未归类」未完成({{ deleteLayer.pendingUnmount.status === 'conflict' ? '有物品待核对' : '清理中途停止' }}),点「转为未归类」可继续清理
    </view>
    <button class="btn block" disabled="{{ deleteLayer.busy }}" bindtap="onDeleteLayerCancel">
      <view class="btn-face">取消</view>
    </button>
    <button
      class="btn block"
      disabled="{{ deleteLayer.busy || !deleteLayer.migrateAvailable }}"
      bindtap="onMigrateTap"
    >
      <view class="btn-face">删位置并迁移物品</view>
    </button>
    <view wx:if="{{ !deleteLayer.migrateAvailable }}" class="hint">
      顶层房间不能迁移(物品不能直接挂「我的家」),可移动物品后重试、改用转为未归类或全部删除
    </view>
    <button class="btn block" disabled="{{ deleteLayer.busy }}" bindtap="onUnmountTap">
      <view class="btn-face">转为未归类</view>
    </button>
    <view class="hint">物品解除挂载回到首页「尚未归类」,原始位置文本保留;位置和清点记录删除</view>
    <button class="btn block danger" disabled="{{ deleteLayer.busy }}" bindtap="onPurgeTap">
      <view class="btn-face">全部删除</view>
    </button>
  </view>
</view>

<!-- D2(#96)清点历史半屏弹层:本位置清点列表(时间/候选/确认/回看/删)+ 行内回看播放 -->
<view wx:if="{{ scanHistory.visible }}" class="layer-mask" bindtap="onScanHistoryClose">
  <view class="scan-history-layer" catchtap="noop">
    <view class="card-head">
      <view class="card-title">清点历史</view>
      <view class="add-link" bindtap="onScanHistoryClose">关闭</view>
    </view>
    <block wx:if="{{ scanHistory.replayUrl }}">
      <view class="hint">{{ scanHistory.replayTitle }}</view>
      <video
        class="scan-history-video"
        style="height: {{ scanHistory.replayHeight }}px"
        src="{{ scanHistory.replayUrl }}"
        controls
      ></video>
      <button class="btn block" bindtap="onScanHistoryBackTap"><view class="btn-face">返回列表</view></button>
    </block>
    <block wx:else>
      <view wx:if="{{ scanHistory.loading }}" class="empty-text">正在读取清点记录…</view>
      <block wx:elif="{{ scanHistory.errorText }}">
        <view class="error-text">{{ scanHistory.errorText }}</view>
        <button class="btn block" bindtap="onScanHistoryRetryTap"><view class="btn-face">重试</view></button>
      </block>
      <block wx:elif="{{ scanHistory.rows.length > 0 }}">
        <view wx:if="{{ scanHistory.hasMore }}" class="hint">仅显示最近 20 次</view>
        <scroll-view scroll-y class="scan-history-scroll" style="height: {{ scanHistory.scrollHeight }}px">
          <view wx:for="{{ scanHistory.rows }}" wx:key="scanId" class="scan-history-row">
            <view class="item-main">
              <view class="item-name">{{ item.timeText }}</view>
              <view class="item-location">{{ item.countsText }}{{ item.stateText ? ' · ' + item.stateText : '' }}</view>
            </view>
            <view wx:if="{{ item.canReview }}" class="pick-check" catchtap="onScanHistoryReviewTap" data-index="{{ index }}">回看</view>
            <view class="scan-history-del" catchtap="onScanHistoryDeleteTap" data-index="{{ index }}">删</view>
          </view>
        </scroll-view>
      </block>
      <view wx:else class="empty-text">这里还没有清点记录</view>
    </block>
  </view>
</view>

<!-- D2(#96)删除单次清点确认弹层:影响面预告文案冻结自契约 §4 -->
<view wx:if="{{ scanDeleteLayer.visible }}" class="layer-mask" bindtap="onScanDeleteLayerCancel">
  <view class="delete-layer" catchtap="noop">
    <view class="card-title">删除这条清点记录</view>
    <view class="hint">{{ scanDeleteLayer.timeText }}</view>
    <view class="hint">只删这条清点记录,不影响已录入的物品和它们的视频证据;若这段视频没有其他引用,将一并删除视频文件。</view>
    <button class="btn block" disabled="{{ scanDeleteLayer.busy }}" bindtap="onScanDeleteLayerCancel">
      <view class="btn-face">取消</view>
    </button>
    <button class="btn block danger" disabled="{{ scanDeleteLayer.busy }}" bindtap="onScanDeleteConfirmTap">
      <view class="btn-face">删除</view>
    </button>
  </view>
</view>

<!-- ②「+」面板:常用预设 chips 一键创建 + 自定义输入(根层=房间 / 子层=家具);非根层另有「添加物品」入口(③) -->
<view wx:if="{{ addPanel.visible }}" class="layer-mask" bindtap="onAddPanelClose">
  <view class="add-layer" catchtap="noop">
    <view class="card-head">
      <view class="card-title">{{ isRoot ? '添加房间' : '在「' + currentNodeName + '」里添加' }}</view>
      <view class="add-link" bindtap="onAddPanelClose">关闭</view>
    </view>
    <view class="hint">{{ isRoot ? '点一个常用房间直接添加,或用自定义输入。' : '点一个常用家具/位置直接添加,或用自定义输入。' }}</view>
    <view class="chip-row">
      <view wx:for="{{ addPanel.presets }}" wx:key="*this" class="chip" data-name="{{ item }}" catchtap="onAddPresetTap">{{ item }}</view>
    </view>
    <view class="field">
      <view class="label">自定义</view>
      <view class="custom-inline">
        <input
          class="input"
          placeholder="{{ isRoot ? '如:茶室' : '如:第二个抽屉' }}"
          placeholder-class="placeholder"
          value="{{ addPanel.customName }}"
          maxlength="30"
          disabled="{{ acting }}"
          bindinput="onAddPanelInput"
        />
        <button class="btn" size="mini" disabled="{{ acting }}" bindtap="onAddCustomTap"><view class="btn-face">添加</view></button>
      </view>
    </view>
    <view wx:if="{{ !isRoot }}" class="hint">要直接记一件东西放这里?</view>
    <button wx:if="{{ !isRoot }}" class="btn block" disabled="{{ acting }}" bindtap="onAddItemTap"><view class="btn-face">＋ 添加物品到这里</view></button>
  </view>
</view>

<!-- ③ 位置内直接添加物品:名称 + 数量步进器 + 单位选择器(复用确认页组件模式) -->
<view wx:if="{{ itemPanel.visible }}" class="layer-mask" bindtap="onItemPanelClose">
  <view class="add-layer" catchtap="noop">
    <view class="card-head">
      <view class="card-title">在「{{ currentNodeName }}」记一件东西</view>
      <view class="add-link" bindtap="onItemPanelClose">关闭</view>
    </view>
    <view class="field">
      <view class="label">物品</view>
      <input
        class="input"
        placeholder="物品名称"
        placeholder-class="placeholder"
        value="{{ itemPanel.name }}"
        maxlength="50"
        disabled="{{ itemPanel.busy }}"
        bindinput="onItemNameInput"
      />
    </view>
    <view class="field">
      <view class="label">数量</view>
      <view class="qty-stepper">
        <view class="qty-step-btn" data-d="{{ -1 }}" catchtap="onItemQtyStep">−</view>
        <text class="qty-step-num">{{ itemPanel.quantity }}</text>
        <view class="qty-step-btn" data-d="{{ 1 }}" catchtap="onItemQtyStep">+</view>
        <picker
          class="qty-unit"
          range="{{ unitOptions }}"
          value="{{ itemPanel.unitIndex }}"
          disabled="{{ itemPanel.busy }}"
          bindchange="onItemUnitChange"
        >
          <view class="qty-unit-btn">{{ unitOptions[itemPanel.unitIndex] }} <text class="qty-chev">›</text></view>
        </picker>
      </view>
    </view>
    <view class="hint">记下后直接挂到「{{ currentNodeName }}」,位置记录按本层路径保存;确认后才保存。</view>
    <button class="btn primary block" loading="{{ itemPanel.busy }}" disabled="{{ itemPanel.busy }}" bindtap="onItemSaveTap"><view class="btn-face">确认记住</view></button>
  </view>
</view>

<!-- 常驻语音条:按住说话记一件(issue #45 全局可达);选择位置(picker)是过渡任务流,不挂语音入口 -->
<voice-bar wx:if="{{mode !== 'pick'}}" />

</view>
