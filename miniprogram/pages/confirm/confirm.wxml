<view class="appearance-root" style="{{themeStyle}}">
<view class="page confirm-page">
  <!-- 手动录入:单表单(旧路径) -->
  <block wx:if="{{ isManual }}">
    <view class="c-head"><view class="c-title">核对记录</view></view>
    <view class="card">
      <view class="field">
        <view class="label">物品</view>
        <input
          class="input"
          placeholder="物品名称"
          placeholder-class="placeholder"
          value="{{ name }}"
          disabled="{{ saving }}"
          maxlength="50"
          bindinput="onNameInput"
        />
      </view>
      <view class="field">
        <view class="label">位置</view>
        <input
          class="input"
          placeholder="放在哪里"
          placeholder-class="placeholder"
          value="{{ locationText }}"
          disabled="{{ saving }}"
          maxlength="200"
          bindinput="onLocationInput"
        />
      </view>
      <view class="manual-note-toggle" bindtap="onToggleManualNote">{{ manualNoteOpen ? '收起备注' : '备注（选填）' }}</view>
      <view wx:if="{{ manualNoteOpen || note }}" class="field">
        <view class="label">备注</view>
        <textarea
          class="textarea"
          placeholder="选填,最多 200 字"
          placeholder-class="placeholder"
          value="{{ note }}"
          disabled="{{ saving }}"
          maxlength="200"
          auto-height
          bindinput="onNoteInput"
        />
      </view>
    </view>
    <view class="trust-line">确认后才保存。</view>
    <view class="confirm-dock">
      <button class="btn primary block" loading="{{ saving }}" disabled="{{ saving || !name || !locationText }}" bindtap="onSaveTap"><view class="btn-face">确认记住</view></button>
    </view>
  </block>

  <!-- 语音/文字记下后核对:单件摘要(C1/C1b)或多件勾选(C2) -->
  <block wx:else>
    <view class="c-head">
      <view class="c-title">{{ headTitle }}</view>
      <view class="c-sub">{{ headSub }}</view>
    </view>

    <!-- 单件字段直接编辑；位置不确定、原话不足等警示保持可见。 -->
    <block wx:if="{{ rows.length === 1 }}">
      <view class="card sum-card">
        <view class="field">
          <view class="label">物品</view>
          <input class="input" placeholder="物品名称" placeholder-class="placeholder" value="{{ rows[0].name }}" maxlength="50" disabled="{{ batchSaving || rows[0].status === 'saving' || rows[0].status === 'saved' }}" data-index="0" bindinput="onRowNameInput" />
        </view>
        <view wx:if="{{ rows[0].certain }}" class="field">
          <view class="label">位置</view>
          <input class="input" placeholder="放在哪里" placeholder-class="placeholder" value="{{ rows[0].locationText }}" maxlength="200" disabled="{{ batchSaving || rows[0].status === 'saving' || rows[0].status === 'saved' }}" data-index="0" bindinput="onRowLocationInput" />
        </view>
        <view wx:if="{{ rows[0].mountPathText }}" class="mount-preview">
          <view class="mount-check">✓</view><view class="mount-text">归到「{{ rows[0].mountPathText }}」</view><view class="mount-swap" data-index="0" bindtap="onMountSwapTap">更换</view>
        </view>
        <!-- 提醒行(#36):原话里明确说了日期才显示;改=日期选择器弹层,✕=连日期一起清除(灰显「不提醒」);没提取到不催 -->
        <view wx:if="{{ rows[0].remindAt || rows[0].remindTouched }}" class="sumrow">
          <view class="k">提醒</view>
          <view class="v {{ rows[0].remindAt ? '' : 'muted' }}">{{ rows[0].remindAt ? rows[0].remindAt + ' 到期' : '不提醒' }}</view>
          <picker
            mode="date"
            value="{{ rows[0].remindAt || today }}"
            disabled="{{ batchSaving || rows[0].status === 'saving' || rows[0].status === 'saved' }}"
            bindchange="onRemindDateChange"
          >
            <view class="sum-edit"><view class="sum-edit-face">选日期</view></view>
          </picker>
          <view
            wx:if="{{ rows[0].remindAt }}"
            class="remind-clear"
            data-index="0"
            bindtap="onRemindClear"
          >✕</view>
        </view>
        <view wx:if="{{ rows[0].status !== 'pending' }}" class="sum-status">
          <text wx:if="{{ rows[0].status === 'saved' }}" class="st saved">已记住</text>
          <text wx:elif="{{ rows[0].status === 'saving' }}" class="st saving">保存中…</text>
          <text wx:elif="{{ rows[0].status === 'failed' }}" class="st failed">未保存</text>
        </view>
      </view>

      <!-- 纪律句(#36):只在提醒行存在时显示;日期只来自原话或日期选择器 -->
      <view wx:if="{{ rows[0].remindAt || rows[0].remindTouched }}" class="sum-meta remind-note">日期可修改或取消。</view>

      <!-- 换算候选标注(#36 真机反馈三件 A):日期来自服务端对『原相对话』的闭集换算,
           是候选不是定论——可改可清;用户改过日期(remindConverted=false)即收起 -->
      <view
        wx:if="{{ rows[0].remindAt && rows[0].remindConverted && rows[0].remindAt === rows[0].remindOrigin }}"
        class="sum-meta converted-note"
      >由「{{ rows[0].remindQuote }}」换算，请核对日期。</view>

      <!-- 时间没换算(0.6.0 真机反馈 Fix 4):原话有时间表述但没换成日期——纯提示,不是换算 -->
      <view wx:if="{{ rows[0].remindVagueQuote }}" class="sum-meta vague-note">「{{ rows[0].remindVagueQuote }}」未换算，请补充日期或稍后设置。</view>

      <!-- C1b:位置没听清的警示框(常驻展开,不藏进折叠) -->
      <view wx:if="{{ !rows[0].certain }}" class="warnbox">
        <view class="wtitle">位置待补充</view>
        <view class="whint">填好后即可确认。</view>
        <input
          class="winput"
          placeholder="例:客厅电视柜第二格"
          placeholder-class="placeholder"
          value="{{ rows[0].locationText }}"
          maxlength="200"
          disabled="{{ batchSaving || rows[0].status === 'saving' || rows[0].status === 'saved' }}"
          data-index="0"
          bindinput="onRowLocationInput"
        />
      </view>

      <view wx:if="{{ rows[0].qualifiersText }}" class="sum-meta">限定语:{{ rows[0].qualifiersText }}</view>
      <view wx:if="{{ rows[0].anchorShared }}" class="sum-meta warn">这段原话里有两件东西,位置请核对后再确认</view>
      <view wx:if="{{ rows[0].sourceQuote && rows[0].anchorShared }}" class="sum-meta quote">原话:{{ rows[0].sourceQuote }}</view>
      <view wx:elif="{{ !rows[0].sourceQuote && rows[0].status !== 'saved' }}" class="sum-meta warn">缺少原话依据，请核对后勾选</view>

      <view wx:if="{{ rows[0].status === 'failed' }}" class="row-fail sum-fail">
        <text class="fail-msg">{{ rows[0].failMsg }}</text>
        <text wx:if="{{ rows[0].itemId }}" class="fail-link" data-index="0" catchtap="onRowDetail">去详情页</text>
      </view>

      <!-- 默认未勾选但位置已听清(两件东西/来源不充分):核对过再勾 -->
      <view
        wx:if="{{ rows[0].certain && !rows[0].checked && rows[0].status === 'pending' }}"
        class="sum-check-row"
        data-index="0"
        bindtap="onRowToggle"
      >
        <view class="check {{ rows[0].checked ? 'on' : '' }}"></view>
        <text class="sum-check-label">已核对，记住这件</text>
      </view>
    </block>

    <!-- 原话:默认折叠,点开核对;警示场景初始展开 -->
    <view class="fold" bindtap="onToggleQuote">
      <text class="fold-label">原话</text>
      <text class="chev {{ quoteOpen ? 'open' : '' }}">›</text>
    </view>
    <view wx:if="{{ quoteOpen }}" class="fold-body">
      <view class="fold-quote">{{ originalText }}</view>
    </view>

    <view wx:if="{{ truncated || rows.length >= 5 }}" class="truncated-banner">
      {{ truncated ? '这句话里的东西超过 5 件,先记住下面这 5 件,剩下的回头再说一句。' : '这句话正好列了 5 件,如果还有没列出来的,回头再补说一句。' }}
    </view>

    <!-- 多件:逐件勾选核对(C2) -->
    <view wx:if="{{ rows.length > 1 }}" class="card batch-card">
      <view wx:for="{{ rows }}" wx:key="key" class="row {{ item.status }}">
        <view class="row-head">
          <view class="row-head-left">
            <view class="check-hit" data-index="{{ index }}" bindtap="onRowToggle">
              <view class="check {{ item.checked ? 'on' : '' }} {{ item.status === 'saved' ? 'fixed' : '' }}">{{ item.status === 'saved' ? '✓' : item.checked ? '✓' : '' }}</view>
            </view>
            <text wx:if="{{ !item.certain }}" class="flag">⚠ 位置待核实</text>
            <text wx:elif="{{ item.anchorShared || !item.sourceQuote }}" class="flag">⚠ 请核对</text>
          </view>
          <view class="row-status">
            <text wx:if="{{ item.status === 'saved' }}" class="st saved">已记住</text>
            <text wx:elif="{{ item.status === 'saving' }}" class="st saving">保存中…</text>
            <text wx:elif="{{ item.status === 'failed' }}" class="st failed">未保存</text>
          </view>
        </view>

        <view class="field">
          <view class="label">物品</view>
          <input
            class="input row-name"
            placeholder="物品名称"
            placeholder-class="placeholder"
            value="{{ item.name }}"
            maxlength="50"
            disabled="{{ batchSaving || item.status === 'saving' || item.status === 'saved' }}"
            data-index="{{ index }}"
            bindinput="onRowNameInput"
          />
        </view>
        <view class="field">
          <view class="label">位置</view>
          <input
            class="input row-location"
            placeholder="{{ item.certain ? '放在哪里' : '放在哪儿?例:书房插座旁' }}"
            placeholder-class="placeholder"
            value="{{ item.locationText }}"
            maxlength="200"
            disabled="{{ batchSaving || item.status === 'saving' || item.status === 'saved' }}"
            data-index="{{ index }}"
            bindinput="onRowLocationInput"
          />
        </view>
        <!-- 「将放入」副文(十七轮):certain 行明示挂靠预览,「换」=同款选位置;
             模糊行无副文(=确认后先进「尚未归类」),绝不静默建路径 -->
        <view wx:if="{{ item.mountPathText }}" class="row-mount">
          <text class="row-mount-text">归到「{{ item.mountPathText }}」</text>
          <text
            class="row-mount-swap"
            data-index="{{ index }}"
            catchtap="onMountSwapTap"
          >换</text>
        </view>
        <!-- 提醒角标(#36):原话里明确说了日期的行在副文下小字标出;不参与勾选逻辑 -->
        <view wx:if="{{ item.remindAt }}" class="remind-badge">{{ item.remindBadgeText }}</view>
        <!-- 换算候选标注(#36 真机反馈三件 A):日期来自服务端闭集换算,可改可清 -->
        <view wx:if="{{ item.remindAt && item.remindConverted }}" class="row-meta converted-note">(按『{{ item.remindQuote }}』换算,可改可清)</view>
        <!-- 时间没换算小灰标(0.6.0 真机反馈 Fix 4):纯提示,不是换算 -->
        <view wx:if="{{ item.remindVagueQuote }}" class="vague-badge">时间没换算</view>
        <view wx:if="{{ !item.certain && !item.checked && item.status !== 'saved' }}" class="row-warn-line">没听清放在哪儿;补上位置再勾选。</view>

        <view wx:if="{{ item.qualifiersText }}" class="row-meta">限定语:{{ item.qualifiersText }}</view>
        <view wx:if="{{ item.anchorShared }}" class="row-meta warn">这段原话里有两件东西,位置请核对后再勾选</view>
        <view wx:if="{{ item.sourceQuote }}" class="row-meta quote">原话:{{ item.sourceQuote }}</view>
        <view wx:elif="{{ item.status !== 'saved' }}" class="row-meta warn">缺少原话依据，请核对后勾选</view>

        <view wx:if="{{ item.status === 'failed' }}" class="row-fail">
          <text class="fail-msg">{{ item.failMsg }}</text>
          <text wx:if="{{ item.itemId }}" class="fail-link" data-index="{{ index }}" catchtap="onRowDetail">去详情页</text>
        </view>
      </view>
    </view>

    <view class="trust-line">确认后才保存。</view>
    <view class="confirm-dock">
      <button class="btn primary block" loading="{{ batchSaving }}" disabled="{{ batchSaving || checkedCount === 0 }}" bindtap="onSaveBatchTap"><view class="btn-face">{{ rows.length > 1 ? '确认记住 ' + checkedCount + ' 件' : !rows[0].certain && checkedCount === 0 ? '先补充位置' : '确认记住' }}</view></button>
    </view>
  </block>
</view>

</view>
