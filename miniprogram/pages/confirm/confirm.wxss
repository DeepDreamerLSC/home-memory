/* Match the approved prototype while retaining batch and warning states. */
.confirm-page { padding: 40rpx 44rpx 240rpx; }
.c-head { margin: 0; }
.c-title { font-size: 54rpx; font-weight: 600; letter-spacing: -1.6rpx; line-height: 1.35; color: var(--text); }
.c-sub { font-size: 24rpx; color: var(--text-2); margin-top: 16rpx; line-height: 1.6; }
.c-sub:empty { display: none; }
.card { margin: 0; padding: 0; border: 0; background: transparent; box-shadow: none; border-radius: 0; }
.field { margin: 40rpx 0 0; }
.label { margin: 0 0 14rpx; font-size: 22rpx; font-weight: 400; color: var(--text-2); line-height: 1.5; }
.input, .textarea, .winput { display: block; box-sizing: border-box; width: 100%; min-height: 96rpx; padding: 24rpx 28rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--card); color: var(--text); font-size: 28rpx; font-weight: 400; line-height: 1.5; }
.input { height: 96rpx; padding: 0 28rpx; }
.textarea { min-height: 160rpx; }
.mount-preview { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 0 28rpx; background: var(--card-inset); border-radius: 24rpx; margin-top: 36rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.6; }
.mount-check { flex-shrink: 0; font-size: 28rpx; }
.mount-text { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.mount-swap { min-height: 88rpx; display: flex; align-items: center; color: var(--text-2); font-size: 22rpx; flex-shrink: 0; padding-left: 8rpx; }
.sumrow { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; font-size: 24rpx; }
.sumrow.line { border-bottom: 1rpx solid var(--line); }
.k { color: var(--text-2); flex-shrink: 0; }
.v { flex: 1; min-width: 0; color: var(--text); }
.sum-edit { min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--text-2); font-size: 22rpx; }
.sum-edit-face { background: transparent; border: 0; box-shadow: none; font-weight: 400; }
.remind-clear { width: 64rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--text-2); }
.sum-meta, .row-meta { margin-top: 20rpx; color: var(--text-2); font-size: 22rpx; line-height: 1.7; overflow-wrap: anywhere; }
.quote { color: var(--text-2); }
.warn { color: var(--danger); }
.warnbox { border: 1rpx solid var(--danger); background: var(--card); padding: 28rpx; border-radius: 24rpx; margin-top: 28rpx; }
.wtitle { font-size: 28rpx; font-weight: 500; color: var(--danger); }
.whint { font-size: 22rpx; color: var(--text-2); margin: 8rpx 0 20rpx; }
.winput { background: var(--bg); }
.sum-check-row { display: flex; align-items: center; gap: 18rpx; min-height: 88rpx; margin-top: 20rpx; }
.sum-check-label { font-size: 24rpx; color: var(--text); }
.fold { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 34rpx; border-bottom: 1rpx solid var(--line); color: var(--text-2); }
.fold-label { font-size: 24rpx; }
.chev { font-size: 34rpx; }
.chev.open { transform: rotate(90deg); }
.fold-body { padding: 24rpx 28rpx; background: var(--card-inset); border-radius: 0 0 24rpx 24rpx; }
.fold-quote { color: var(--text-2); font-size: 24rpx; line-height: 1.8; white-space: pre-wrap; }
.truncated-banner { margin-top: 24rpx; font-size: 22rpx; line-height: 1.7; color: var(--text-2); }
.batch-card { margin-top: 24rpx; }
.row { padding: 28rpx 0 36rpx; border-bottom: 1rpx solid var(--line); }
.row:last-child { border-bottom: 0; }
.row .field { margin-top: 24rpx; }
.row-head, .row-head-left { display: flex; align-items: center; gap: 16rpx; }
.row-head { justify-content: space-between; }
.check-hit { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; }
.check { width: 38rpx; height: 38rpx; box-sizing: border-box; border: 1rpx solid var(--text-3); border-radius: 12rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.check.on { background: var(--go-bg); border-color: var(--go-bg); color: var(--go-fg); }
.check.fixed { opacity: .6; }
.flag { font-size: 22rpx; color: var(--danger); }
.st { font-size: 22rpx; }
.st.saved { color: var(--text-2); }
.st.saving { color: var(--text-2); }
.st.failed { color: var(--danger); }
.sum-status { padding-top: 20rpx; }
.row-mount { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; background: var(--card-inset); border-radius: 24rpx; margin-top: 24rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-2); }
.row-mount-text { flex: 1; min-width: 0; }
.row-mount-swap { min-height: 88rpx; display: flex; align-items: center; }
.remind-badge, .vague-badge { display: inline-block; margin-top: 16rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: var(--card-inset); color: var(--text-2); font-size: 22rpx; }
.row-warn-line { font-size: 22rpx; color: var(--danger); margin-top: 18rpx; line-height: 1.6; }
.row-fail { margin-top: 24rpx; padding: 20rpx; border-radius: 20rpx; background: var(--card-inset); font-size: 22rpx; color: var(--danger); line-height: 1.7; }
.fail-link { display: inline-block; margin-left: 16rpx; text-decoration: underline; }
.confirm-dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; background: var(--bg); padding: 24rpx 40rpx calc(8rpx + env(safe-area-inset-bottom) / 2); border-top: 1rpx solid var(--line); }
.confirm-dock .btn { border-radius: 28rpx; padding: 0; box-shadow: none; background: var(--go-bg); color: var(--go-fg); border: 0; width: 100%; min-height: 98rpx; margin: 0; }
.confirm-dock .btn-face { font-size: 28rpx; font-weight: 500; min-height: 98rpx; border: 0; border-radius: 28rpx; box-shadow: none; background: transparent; color: inherit; display: flex; align-items: center; justify-content: center; padding: 0 24rpx; }
.confirm-dock .btn[disabled] { opacity: .45; }
.trust-line { text-align: center; color: var(--text-2); font-size: 20rpx; line-height: 1.6; margin: 16rpx 0 0; }

.manual-note-toggle { min-height: 88rpx; display: flex; align-items: center; margin-top: 20rpx; font-size: 24rpx; color: var(--text-2); }

/* ---------- 数量行(issue #102 Q1,Q0-CONTRACT §4.6/§10.3) ---------- */
.qty-inline { display: flex; align-items: center; gap: 16rpx; }
.qty-inline .qty-num { flex: 1; min-width: 0; }
.qty-stepper { display: flex; align-items: center; gap: 8rpx; }
.qty-step-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: var(--card-inset, #f2f2f2); font-size: 30rpx; color: var(--text, #222); }
.qty-step-num { min-width: 56rpx; text-align: center; font-size: 28rpx; color: var(--text, #222); }
.qty-unit-btn { padding: 8rpx 16rpx; border-radius: 12rpx; background: var(--card-inset, #f2f2f2); font-size: 24rpx; color: var(--text, #222); }
.qty-chev { margin-left: 6rpx; opacity: .55; }
.qty-badge { margin-left: 10rpx; font-size: 20rpx; color: var(--text-2, #999); }
.sumrow .qty-stepper { justify-content: flex-end; flex: 1; }
.row-qty { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.row-qty-label { font-size: 24rpx; color: var(--text-2, #999); }
