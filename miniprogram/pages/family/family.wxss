/* 家庭管理页(issue #34 P1-B):复用全局卡片/条目体系,仅补本页特有样式 */

.notice-block {
  background: var(--banner-bg);
  border: 3rpx solid var(--banner-line);
  border-radius: 30rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.notice-line {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.7;
}

.notice-line + .notice-line {
  margin-top: 8rpx;
}

/* 勾选确认(创建「从空白开始」明示的硬前置) */
.ack-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.ack-box {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--text-3);
  margin: 4rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ack-box.checked {
  background: var(--accent);
  border-color: var(--accent-shadow);
}

.ack-tick {
  color: var(--text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.ack-text {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.6;
}

/* 成员行右侧操作 */
.row-action {
  flex: none;
  align-self: center;
  color: var(--text-2);
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.row-action.danger {
  color: var(--danger);
  border-color: var(--danger-shadow);
}

.tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-dim);
  color: var(--text-2);
  font-size: 22rpx;
  vertical-align: middle;
}

.share-btn {
  margin-top: 16rpx;
}

.trial-note {
  margin-top: 16rpx;
  color: var(--text-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.invite-title {
  margin: 24rpx 0 8rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

/* 取消链接(照首页 mode-link 口径,该类定义在首页 wxss,此处页面级补齐;原型 sublnk 12.5px) */
.mode-link {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--text-2);
  text-align: center;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像昵称资料卡 */
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent-dim, #f3edd9);
}
.item-row .avatar-img {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3, #a39d8d);
}
.profile-nick {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--card-inset, #f1ede0);
  color: var(--text, #191919);
  font-size: 28rpx;
}
.btn.sm {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
