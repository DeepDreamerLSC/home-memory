/* 家庭管理页(issue #34 P1-B):复用全局卡片/条目体系,仅补本页特有样式 */

.notice-block {
  background: var(--banner-bg);
  border: 3rpx solid var(--banner-line);
  border-radius: 30rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.notice-line {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.7;
}

.notice-line + .notice-line {
  margin-top: 8rpx;
}

/* 勾选确认(创建「从空白开始」明示的硬前置) */
.ack-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.ack-box {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--text-3);
  margin: 4rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ack-box.checked {
  background: var(--accent);
  border-color: var(--accent-shadow);
}

.ack-tick {
  color: var(--text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.ack-text {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.6;
}

/* 成员行右侧操作 */
.row-action {
  flex: none;
  align-self: center;
  color: var(--text-2);
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.row-action.danger {
  color: var(--danger);
  border-color: var(--danger-shadow);
}

.tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-dim);
  color: var(--text-2);
  font-size: 22rpx;
  vertical-align: middle;
}

.share-btn {
  margin-top: 16rpx;
}

.trial-note {
  margin-top: 16rpx;
  color: var(--text-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.invite-title {
  margin: 24rpx 0 8rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

/* 取消链接(照首页 mode-link 口径,该类定义在首页 wxss,此处页面级补齐;原型 sublnk 12.5px)
   (Fix 1:次级文字链热区抬到 ≥88rpx,line-height:1 居中) */
.mode-link {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--text-2);
  text-align: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 头像昵称资料卡 */
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent-dim, #f3edd9);
}
.item-row .avatar-img {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3, #a39d8d);
}
.profile-nick {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--card-inset, #f1ede0);
  color: var(--text, #191919);
  font-size: 28rpx;
}
.btn.sm {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* ============ 顶部当前家庭行:点开可切换(十七轮 B 线;原型 F1 rowbtn) ============ */
.fam-switch-row {
  cursor: pointer;
}

.fam-switch-hover {
  background: var(--card-inset);
  border-radius: 14rpx;
}

.fam-switch-chev {
  font-size: 34rpx;
  color: var(--text-3);
  line-height: 1;
  align-self: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ============ 切换家庭三选弹层(与首页/item 弹层同款样式) ============ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: none;
  align-items: flex-end;
  z-index: 60;
}

.sheet-mask.open {
  display: flex;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

/* 弹层动作行(Fix 1 口径:热区=元素 ≥88rpx,纵向 flex 居中) */
.sheet-act {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--card);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sheet-act-hover {
  background: var(--card-inset);
}

.sheet-act.disabled {
  opacity: 0.55;
}

.sheet-act-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.sheet-act-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.3;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 24rpx;
  line-height: 1;
}
