.appearance-page { min-height:100vh; box-sizing:border-box; padding:40rpx 44rpx calc(208rpx + env(safe-area-inset-bottom)); background:var(--bg); color:var(--text); }
.page-title { font-size:48rpx; line-height:1.35; font-weight:600; letter-spacing:-1rpx; }
.setting-sub { font-size:24rpx; color:var(--text-2); margin:16rpx 0 42rpx; }
.group-title { font-size:26rpx; font-weight:500; margin:30rpx 0 18rpx; }
.palette-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx; }
button { box-sizing:border-box; }
button::after { border:none; }
button.palette { width:100%; padding:10rpx; border:2rpx solid var(--line); background:var(--card); border-radius:20rpx; color:var(--text); margin:0; }
button.palette.selected { border-color:var(--go-bg); }
.swatches { display:flex; height:56rpx; border-radius:10rpx; overflow:hidden; }
.swatches view { flex:1; }
.palette-label { display:flex; justify-content:space-between; font-size:22rpx; margin-top:9rpx; line-height:1.6; }
.mode-control { display:flex; gap:6rpx; padding:6rpx; background:var(--card-inset); border-radius:22rpx; }
.mode-control button { min-height:88rpx; flex:1; margin:0; padding:0 5rpx; font-size:23rpx; color:var(--text-2); background:transparent; display:flex; align-items:center; justify-content:center; border-radius:18rpx; }
.mode-control button.active { background:var(--card); color:var(--text); }
.theme-preview { margin-top:32rpx; padding:26rpx; background:var(--card); border:1rpx solid var(--line); border-radius:28rpx; }
.preview-head,.preview-home-heading { display:flex; justify-content:space-between; align-items:center; font-size:28rpx; font-weight:500; }
.avatar-placeholder { width:58rpx; height:58rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:var(--card-inset); color:var(--text); font-size:24rpx; border:1rpx solid var(--line); }
.mini-rooms { display:flex; gap:16rpx; margin:20rpx 0; }
.mini-rooms>view { flex:1; background:var(--room-bg); border-radius:18rpx; overflow:hidden; }
.mini-rooms image { display:block; width:100%; height:128rpx; }
.mini-rooms text { display:block; background:var(--bg); font-size:22rpx; padding:12rpx 18rpx; }
.mini-voice { background:var(--go-bg); color:var(--go-fg); padding:18rpx; text-align:center; font-size:23rpx; border-radius:18rpx; }
.preview-caption { display:flex; align-items:center; justify-content:space-between; color:var(--text-2); font-size:21rpx; margin-top:4rpx; }
.preview-caption button { color:var(--text-2); background:transparent; padding:0; margin:0; font-size:22rpx; min-height:88rpx; display:flex; align-items:center; }
.scope-note { font-size:22rpx; color:var(--text-2); margin-top:26rpx; line-height:1.7; }
button.restore { font-size:23rpx; color:var(--text-2); background:transparent; min-height:88rpx; display:flex; align-items:center; justify-content:center; margin-top:10rpx; }
.appearance-dock { position:fixed; bottom:0; left:0; right:0; padding:16rpx 40rpx calc(8rpx + env(safe-area-inset-bottom)/2); background:var(--bg); border-top:1rpx solid var(--line); z-index:4; }
.dock-note { text-align:center; color:var(--text-2); font-size:21rpx; margin-bottom:14rpx; }
.dock-actions { display:flex; gap:20rpx; }
button.apply { flex:1; background:var(--go-bg); color:var(--go-fg); min-height:98rpx; display:flex; align-items:center; justify-content:center; border-radius:28rpx; font-size:27rpx; margin:0; }
button.apply[disabled] { opacity:.6; }
button.adjust { background:transparent; color:var(--text-2); margin:0; padding:0 16rpx; font-size:24rpx; min-height:98rpx; display:flex; align-items:center; }
.home-meta { display:flex; justify-content:space-between; color:var(--text-2); font-size:23rpx; margin:14rpx 0 38rpx; }
.preview-search { padding:22rpx; border:1rpx solid var(--line); border-radius:28rpx; background:var(--card); color:var(--text-2); font-size:25rpx; }
.preview-rooms { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24rpx; }
.preview-rooms>view { background:var(--card); border:1rpx solid var(--line); border-radius:30rpx; overflow:hidden; }
.preview-rooms image { display:block; width:100%; height:196rpx; background:var(--room-bg); }
.preview-rooms>view>view { display:flex; justify-content:space-between; align-items:center; padding:22rpx; font-size:27rpx; }
.preview-rooms>view>view>text+text { font-size:21rpx; color:var(--text-2); }
.example-note { font-size:21rpx; color:var(--text-2); margin-top:16rpx; }
.preview-reminder { padding:26rpx 0; font-size:22rpx; border-bottom:1rpx solid var(--line); color:var(--text-2); }
.sample-item { display:flex; align-items:center; gap:20rpx; padding:16rpx 0; }
.sample-item image { width:86rpx; height:86rpx; border-radius:20rpx; background:var(--card-inset); }
.sample-item text { display:block; font-size:25rpx; }
.sample-item text+text { font-size:22rpx; color:var(--text-2); margin-top:8rpx; }
.error { color:var(--danger); font-size:24rpx; padding:20rpx 0; }
