<view class="appearance-page" style="{{previewStyle}}">
  <block wx:if="{{!homePreview}}">
    <view class="page-title">主题配色</view>
    <view class="setting-sub">选一套顺眼的颜色。</view>
    <view class="group-title">柔和配色</view>
    <view class="palette-grid">
      <button wx:for="{{softPalettes}}" wx:key="id" class="palette {{draft.palette === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onPaletteTap" aria-label="{{item.name}}，{{draft.palette === item.id ? '已选中' : '未选中'}}">
        <view class="swatches"><view wx:for="{{item.swatches}}" wx:for-item="color" wx:key="*this" style="background:{{color}}"></view></view>
        <view class="palette-label"><text>{{item.name}}</text><text wx:if="{{draft.palette === item.id}}">✓</text></view>
      </button>
    </view>
    <view class="group-title">鲜明配色</view>
    <view class="palette-grid">
      <button wx:for="{{vividPalettes}}" wx:key="id" class="palette {{draft.palette === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onPaletteTap" aria-label="{{item.name}}，{{draft.palette === item.id ? '已选中' : '未选中'}}">
        <view class="swatches"><view wx:for="{{item.swatches}}" wx:for-item="color" wx:key="*this" style="background:{{color}}"></view></view>
        <view class="palette-label"><text>{{item.name}}</text><text wx:if="{{draft.palette === item.id}}">✓</text></view>
      </button>
    </view>
    <view class="group-title">明暗</view>
    <view class="mode-control"><button wx:for="{{modes}}" wx:key="id" class="{{draft.mode === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onModeTap" aria-label="{{item.name}}，{{draft.mode === item.id ? '已选中' : '未选中'}}">{{item.name}}</button></view>
    <view class="theme-preview">
      <view class="preview-head"><text>家里有什么</text><view class="avatar-placeholder">我</view></view>
      <view class="mini-rooms"><view><image src="{{artPrefix}}living{{artSuffix}}.png" mode="aspectFit"/><text>客厅</text></view><view><image src="{{artPrefix}}bedroom{{artSuffix}}.png" mode="aspectFit"/><text>卧室</text></view></view>
      <view class="mini-voice">按住说话</view>
      <view class="preview-caption"><text>效果预览</text><button bindtap="onPreviewTap">在首页看看 ↗</button></view>
    </view>
    <view class="scope-note">只影响你的界面，切换家庭后也保留。</view>
    <button class="restore" bindtap="onRestoreTap">恢复默认配色</button>
  </block>
  <block wx:else>
    <view class="preview-home-heading"><view class="page-title">家里有什么</view><view class="avatar-placeholder">我</view></view>
    <view class="home-meta"><text>已记住 48 件</text><text>我的家⌄</text></view>
    <view class="preview-search">⌕　搜索物品</view>
    <view class="group-title">按房间找</view>
    <view class="preview-rooms"><view wx:for="{{[{id:'living',name:'客厅',count:18},{id:'bedroom',name:'卧室',count:12},{id:'study',name:'书房',count:9},{id:'kitchen',name:'厨房',count:9}]}}" wx:key="id"><image src="{{artPrefix}}{{item.id}}{{artSuffix}}.png" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.count}} 件 ›</text></view></view></view>
    <view class="example-note">示例首页 · {{previewName}}</view>
    <view class="preview-reminder" wx:if="{{draft.expiry}}">◷　有 2 件物品即将到期</view>
    <block wx:if="{{draft.recent}}"><view class="group-title">最近记住</view><view class="sample-item"><image src="{{artPrefix}}key{{artSuffix}}.png" mode="aspectFit"/><view><text>备用钥匙</text><text>客厅 · 玄关柜第二个抽屉</text></view></view></block>
  </block>
  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>
  <view class="appearance-dock" style="{{previewStyle}}">
    <view class="dock-note">{{homePreview ? '正在预览主题' : '预览中的配色，应用后才会保留。'}}</view>
    <view class="dock-actions"><button wx:if="{{homePreview}}" class="adjust" bindtap="onAdjustTap">返回调整</button><button class="apply" bindtap="onApplyTap" loading="{{saving}}" disabled="{{saving}}">{{homePreview ? '使用这个主题' : '应用主题'}}</button></view>
  </view>
</view>
