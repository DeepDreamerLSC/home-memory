<view class="page">
  <!-- 令牌预检中 -->
  <view wx:if="{{ phase === 'loading' }}" class="card">
    <view class="empty-text">正在确认邀请…</view>
  </view>

  <!-- 手输邀请码(体验版兜底:分享卡片受限时,家人复制邀请码手动加入) -->
  <block wx:elif="{{ phase === 'manual' }}">
    <view class="card">
      <view class="join-icon">家</view>
      <view class="join-title">输入邀请码</view>
      <view class="hint">家人在「家庭 → 邀请家人」生成邀请后可复制邀请码发给你,粘贴到下面。</view>
      <input
        class="token-input"
        value="{{ manualToken }}"
        placeholder="粘贴邀请码"
        maxlength="64"
        bindinput="onManualTokenInput"
      />
      <button class="btn primary block" loading="{{ joining }}" bindtap="onManualSubmitTap">
        <view class="btn-face">下一步</view>
      </button>
      <view class="mode-link" bindtap="onCloseTap">返回</view>
    </view>
  </block>

  <!-- 确认加入:家庭名 + 隐私明示,一步确认 -->
  <block wx:elif="{{ phase === 'confirm' }}">
    <view class="card">
      <view class="join-icon">家</view>
      <view class="join-title">加入「{{ familyName }}」?</view>
      <view class="hint">家人邀请你共用一个家庭,一起记东西放哪儿了。</view>

      <view class="notice-block">
        <view class="notice-line">· {{ privacyNotice }}</view>
        <view class="notice-line">· {{ blankNotice }},随时可以退出</view>
      </view>

      <button class="btn primary block" loading="{{ joining }}" bindtap="onJoinTap">
        <view class="btn-face">确认加入</view>
      </button>
      <view class="mode-link" bindtap="onCloseTap">暂不加入</view>
    </view>
  </block>

  <!-- 失败/已失效:如实文案 + 可重新输入或关闭 -->
  <view wx:elif="{{ phase === 'error' }}" class="card">
    <view class="join-icon">!</view>
    <view class="join-title">无法加入</view>
    <view class="hint">{{ errorText }}</view>
    <view class="trial-note">
      提示:邀请可能已过期、被撤销或家庭已解散;体验版阶段,需先被添加为体验成员。
    </view>
    <button class="btn block" bindtap="onManualRetryTap"><view class="btn-face">重新输入邀请码</view></button>
    <view class="mode-link" bindtap="onCloseTap">关闭</view>
  </view>
</view>
