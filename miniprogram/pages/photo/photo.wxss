/*
 * 拍照识物确认页样式(#3):设计令牌全部取自 app.wxss(奶油白底/白卡细描边/
 * 明黄唯一强调/墨底黄字 CTA+硬投影)与 voice-bar.wxss 的 recsheet 形态,
 * 不新造颜色(深色模式由 app.wxss 变量自动跟随)。
 * 尺寸换算:原型 px × 2 = rpx。
 */

.photo-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ================ 入口态 ================ */
.entry {
  padding: 140rpx 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.entry-ico {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}
.entry-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
}
.entry-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.6;
}
.entry-btn {
  margin-top: 56rpx;
}
.entry-hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}
.entry-hint.dim {
  color: var(--text-3);
}

/* ================ 照片=证据区(默认折叠;展开等比零裁切) ================ */
.ph-sub {
  padding: 14rpx 24rpx 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.5;
}
.photoWrap {
  position: relative;
  width: 100%;
  background: #000;
  overflow: hidden;
}
.photoWrap.collapsed {
  height: 300rpx;
}
.ph-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ph-img.dim {
  filter: brightness(0.55) blur(1px);
}
.photoWrap.collapsed .bbox {
  display: none;
}
.evTap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.evChip {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 99rpx;
  padding: 18rpx 32rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--text);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
  text-align: center;
}
.evChip .e2 {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  font-weight: 600;
  margin-top: 2rpx;
}

/* ================ 识别框(墨=AI 预选,黄虚=低可信,红虚=用户圈选) ================ */
.bbox {
  position: absolute;
  border: 5rpx solid var(--go-bg);
  border-radius: 12rpx;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.55);
}
.bbox .tag {
  position: absolute;
  top: -22rpx;
  left: -4rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 700;
}
.bbox.amber {
  border-color: var(--accent-shadow);
  border-style: dashed;
}
.bbox.amber .tag {
  background: var(--accent);
  color: var(--text);
}
.bbox.user {
  border: 6rpx dashed var(--danger);
  border-radius: 16rpx;
}
.bbox.user .tag {
  background: var(--danger);
  color: #fff;
}
.bbox.pulse {
  box-shadow: 0 0 0 10rpx rgba(255, 225, 90, 0.75);
  transform: scale(1.02);
}
.bbox.drawing {
  z-index: 6;
}
.ask {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  z-index: 7;
}
.circle-entry {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  z-index: 7;
}

/* ================ 位置栏 ================ */
.locbar {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 26rpx;
  display: flex;
  gap: 20rpx;
}
.locbar .ico {
  font-size: 36rpx;
  line-height: 1.3;
}
.locbar .main {
  flex: 1;
  min-width: 0;
}
.locbar .lb {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 600;
}
.locbar .lv {
  font-size: 30rpx;
  font-weight: 800;
  margin: 6rpx 0 4rpx;
  color: var(--text);
}
.locbar .lv .pen {
  color: var(--text-3);
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 8rpx;
}
.locbar .lc {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.locbar .chip {
  border-radius: 99rpx;
  padding: 10rpx 22rpx;
  font-size: 23rpx;
}
.locbar .c1 {
  background: var(--vb-hold-bg);
  color: var(--text);
  font-weight: 700;
}
.locbar .c2 {
  background: var(--card-inset);
  color: var(--text-2);
}
.locbar .c3 {
  border: 1rpx solid var(--vb-btn-line);
  color: var(--text-2);
}
.locbar .hint {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 14rpx;
  line-height: 1.5;
}

/* ================ 横幅 ================ */
.warn {
  background: var(--banner-bg);
  border: 1rpx solid var(--banner-line);
  border-radius: 26rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.55;
}

/* C3:证据待关联提示(沿用 warn 容器与 btn go 按钮,样式令牌不新造) */
.evretry {
  display: flex;
  flex-direction: column;
}
.evretry .evretry-btn {
  margin-top: 14rpx;
}

/* ================ 清单(三态) ================ */
.listhead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 32rpx 12rpx;
  font-size: 25rpx;
  color: var(--text-3);
  font-weight: 700;
}
.listhead .selall {
  color: var(--text);
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 8rpx;
}
.list {
  padding: 8rpx 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.row {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.row.keep {
  background: var(--accent-dim);
  border-color: var(--accent-shadow);
}
.row.hl {
  border: 3rpx solid var(--go-bg);
}
.row.done {
  border-color: var(--go-bg);
}
.row-hover {
  filter: brightness(0.96);
}
.ck {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border: 3rpx solid var(--vb-btn-line);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--go-fg);
  background: var(--card);
}
.row.keep .ck {
  background: var(--go-bg);
  border-color: var(--go-bg);
}
.row.done .ck {
  background: var(--go-bg);
  border-color: var(--go-bg);
}
.row .mid {
  flex: 1;
  min-width: 0;
}
.row .nm {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.row .nm-text {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  word-break: break-all;
}
.row .src {
  font-size: 19rpx;
  padding: 5rpx 14rpx;
  border-radius: 99rpx;
  flex: none;
  font-weight: 700;
  line-height: 1.2;
}
.src.candidate {
  background: var(--card-inset);
  color: var(--text-2);
}
.src.keep,
.src.voice {
  background: var(--accent);
  color: var(--text);
}
.src.boxsel {
  background: var(--danger-bg);
  color: var(--danger);
}
.src.manual {
  background: var(--card-inset);
  color: var(--text-2);
}
.src.done {
  background: var(--go-bg);
  color: var(--go-fg);
}
.row .meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  line-height: 1.5;
}
.row .failmsg {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 6rpx;
  line-height: 1.5;
}
.step {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.stepBtn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--vb-btn-line);
  background: var(--card);
  color: var(--text-2);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.stepNum {
  min-width: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 700;
}
.addmanual {
  border: 2rpx dashed var(--vb-btn-line);
  border-radius: 32rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 600;
  background: var(--card);
}

/* ================ 底部:按住胶囊 + 保存 ================ */
.botbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: var(--vb-bg);
  border-top: 1rpx solid var(--vb-line);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.hold {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  background: transparent;
  transition: filter 0.12s ease, transform 0.12s ease;
}
.hold-face {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 30rpx;
  background: var(--vb-hold-bg);
  color: var(--vb-hold-fg);
  min-height: 78rpx;
  padding: 0 28rpx 0 12rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hold.pressed .hold-face {
  filter: brightness(0.94);
  transform: scale(0.985);
}
.hold.busy .hold-face {
  opacity: 0.78;
}
.hold.cancel .hold-face {
  opacity: 0.92;
}
.micdot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--vb-mic-bg);
  color: var(--vb-mic-fg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
}
.mic-cap {
  width: 15rpx;
  height: 22rpx;
  border-radius: 8rpx;
  background: var(--vb-mic-fg);
}
.mic-stand {
  width: 3rpx;
  height: 8rpx;
  background: var(--vb-mic-fg);
  margin-top: 3rpx;
}
.mic-base {
  width: 21rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--vb-mic-fg);
  margin-top: 3rpx;
}
.mic-seconds {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--vb-hold-fg);
  line-height: 1;
}
.hold-label {
  flex: 1;
  min-width: 0;
}
.hold-label .l2 {
  display: block;
  font-size: 19rpx;
  color: var(--text-3);
  font-weight: 600;
  margin-top: 2rpx;
}
.saveSm {
  flex: none;
  min-height: 88rpx;
  padding: 11rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 0 var(--vb-cta-shadow);
  line-height: 1;
}
.saveSm.disabled {
  opacity: 0.4;
}
.btn-hover {
  opacity: 0.88;
}

/* ================ 页内按钮(view 基类;热区 88 = 面 76 + 透明上下 6,app.wxss 同款纪律) ================ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
  background: transparent;
}
.btn .btn-face {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
.btn.quiet .btn-face {
  background: transparent;
  color: var(--text-2);
  border: 3rpx solid var(--vb-btn-line);
}
.btn.go .btn-face {
  background: var(--go-bg);
  color: var(--go-fg);
  box-shadow: 0 8rpx 0 var(--vb-cta-shadow);
}
.btn.go.disabled .btn-face {
  opacity: 0.45;
}

/* ================ 录音浮层(recsheet,复刻 voice-bar 形态) ================ */
.recback {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.22);
}
.recsheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 45;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  padding: 32rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  text-align: center;
  animation: recpop 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.35);
}
@media (prefers-color-scheme: dark) {
  .recsheet {
    background: rgba(30, 30, 30, 0.92);
  }
  .recmic {
    background: #2e2e2e;
  }
  .recmic .mic-cap,
  .recmic .mic-stand,
  .recmic .mic-base {
    background: #f5f4f0;
  }
}
@keyframes recpop {
  0% {
    transform: translateY(92rpx) scale(0.97);
    opacity: 0;
  }
  60% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}
.rec-title {
  font-size: 33rpx;
  font-weight: 800;
  color: var(--text);
}
.recrow {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.recmic {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
  animation: recpulse 1.6s infinite;
}
.recmic .mic-cap {
  width: 30rpx;
  height: 44rpx;
  border-radius: 15rpx;
  background: #191919;
}
.recmic .mic-stand {
  width: 6rpx;
  height: 14rpx;
  background: #191919;
  margin-top: 6rpx;
}
.recmic .mic-base {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #191919;
  margin-top: 6rpx;
}
@keyframes recpulse {
  0% {
    box-shadow: 0 0 0 20rpx var(--accent-dim);
  }
  70% {
    box-shadow: 0 0 0 52rpx transparent;
  }
  100% {
    box-shadow: 0 0 0 20rpx transparent;
  }
}
.wave {
  display: flex;
  gap: 8rpx;
  align-items: center;
  height: 60rpx;
}
.wave .wv {
  width: 10rpx;
  border-radius: 6rpx;
  background: var(--go-bg);
  animation: wv 1s infinite ease-in-out;
}
@keyframes wv {
  0%,
  100% {
    transform: scaleY(0.55);
  }
  50% {
    transform: scaleY(1);
  }
}
.rec-hint {
  max-width: 540rpx;
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.6;
}
.rec-cta {
  width: 100%;
  max-width: 540rpx;
  min-height: 66rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}
.rec-cancel {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  text-decoration: underline;
  text-underline-offset: 6rpx;
  line-height: 1;
}

/* ================ 弹层通用(dim + sheet) ================ */
.dim {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 17, 20, 0.4);
  z-index: 50;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  z-index: 51;
  animation: sheetup 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.35);
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
}
@keyframes sheetup {
  0% {
    transform: translateY(55%);
  }
  60% {
    transform: translateY(-3%);
  }
  to {
    transform: translateY(0);
  }
}
.grip {
  width: 76rpx;
  height: 9rpx;
  border-radius: 99rpx;
  background: var(--line);
  margin: 0 auto 24rpx;
}
.minisheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 51;
  background: var(--bg);
  border-radius: 36rpx;
  padding: 28rpx 32rpx;
  animation: recpop 0.25s ease;
}
.mini-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
.mini-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.5;
}
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  margin: 0 0 20rpx;
  padding: 22rpx 26rpx;
}
.card.card-mb {
  margin-bottom: 24rpx;
}
.card .ct {
  font-size: 23rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card .ct .audio {
  font-size: 21rpx;
  color: var(--text-2);
  background: var(--card-inset);
  border-radius: 99rpx;
  padding: 6rpx 18rpx;
  font-weight: 700;
}
.trans {
  font-size: 30rpx;
  line-height: 1.7;
  font-weight: 700;
  color: var(--text);
}
.lockTip {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--card-inset);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.lockTip .lockb {
  font-weight: 800;
  color: var(--text);
}
.drow {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.drow:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.dck {
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  flex: none;
  border: 3rpx solid var(--vb-btn-line);
  border-radius: 10rpx;
  background: var(--card);
  color: var(--go-fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.dck.on {
  background: var(--go-bg);
  border-color: var(--go-bg);
}
.drow .dc {
  flex: 1;
  min-width: 0;
}
.drow .df {
  font-size: 21rpx;
  color: var(--text-3);
  font-weight: 700;
  margin-bottom: 6rpx;
}
.dline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 27rpx;
  flex-wrap: wrap;
}
.dline .old {
  color: var(--danger);
  text-decoration: line-through;
}
.dline .arr {
  color: var(--text-3);
}
.dline .new {
  color: var(--text);
  font-weight: 800;
  background: linear-gradient(transparent 65%, var(--accent) 65%);
}
.why {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 16rpx;
  line-height: 1.5;
}
.pickrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx dashed var(--line);
}
.pickrow:last-child {
  border-bottom: none;
}
.pickrow .did {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 700;
}
.pickrow .pickname {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.pickrow .chev {
  color: var(--text-3);
  font-size: 40rpx;
  font-weight: 300;
}
.addline {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}
.addline .addnote {
  font-size: 23rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 8rpx;
}
.sheet-acts {
  display: flex;
  gap: 20rpx;
}
.sheet-acts .btn,
.block-sheet {
  flex: 1;
}
.keepTip {
  font-size: 23rpx;
  color: var(--text-2);
  background: var(--banner-bg);
  border: 1rpx solid var(--banner-line);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
  line-height: 1.55;
}
.sheet-h3 {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
  color: var(--text);
}
.sheet-conf {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 26rpx;
}
.bigline {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}
.excline {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--text);
}
.excline.dim2 {
  color: var(--text-3);
}
.sumline {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
}

/* ================ 手动编辑面板(屏④) ================ */
.fld {
  margin-bottom: 26rpx;
}
.flabel {
  display: block;
  font-size: 23rpx;
  color: var(--text-3);
  font-weight: 700;
  margin-bottom: 14rpx;
}
.cand {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cand-chip {
  border: 3rpx solid var(--vb-btn-line);
  border-radius: 99rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--card);
}
.cand-chip.on {
  border-color: var(--go-bg);
  background: var(--go-bg);
  color: var(--go-fg);
  font-weight: 800;
}
.cand-chip .star {
  font-size: 20rpx;
  color: var(--accent);
  margin-left: 6rpx;
}
.inp {
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 29rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card);
  color: var(--text);
}
.inp .inp-pre {
  color: var(--text-3);
}
.inp .inp-val {
  color: var(--text);
  font-weight: 700;
}
.inp .pen {
  color: var(--text-3);
  font-size: 26rpx;
}
.inp.kindline {
  margin-top: 16rpx;
}
.clear-remind {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 6rpx 0;
}

/* ================ 圈选模式(屏⑤) ================ */
.circle-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.circle-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
}
.backchip {
  background: transparent;
}
.backchip-face {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 99rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-2);
}
.backchip-hover {
  filter: brightness(0.96);
}
.circle-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}
.hintbar {
  background: var(--bg);
  border-bottom: 1rpx solid var(--line);
  padding: 18rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-2);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.hintbar .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  flex: none;
  animation: blink 1.2s infinite;
}
@keyframes blink {
  50% {
    opacity: 0.25;
  }
}
.circle-wrap {
  touch-action: none;
}
.result {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  margin: 24rpx;
  padding: 26rpx 28rpx;
}
.result .rt {
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--text);
  flex-wrap: wrap;
}
.result .rc {
  font-size: 21rpx;
  color: var(--text);
  background: var(--accent);
  border-radius: 10rpx;
  padding: 5rpx 14rpx;
  font-weight: 700;
}
.result .rd {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.55;
}
.result-acts {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.result-acts .btn {
  flex: 1;
}
.circle-note {
  margin: 0 48rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  text-align: center;
}

/* ================ 云端识别授权(B4):拒绝后识别入口灰化 + 提示 ================ */
.circle-entry.disabled {
  opacity: 0.4;
}

.vl-auth-hint {
  position: absolute;
  right: 12rpx;
  bottom: 64rpx;
  max-width: 70%;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.5;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  z-index: 7;
}

/* 快速核实条(真机反馈 2026-10-17):一键三档,替代原隐蔽的「全选/清空」小字 */
.qkbar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 4rpx;
}
.qk-chip {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}
.qk-chip.go {
  background: var(--go-bg);
  color: var(--go-fg);
  box-shadow: 0 5rpx 0 var(--cta-shadow);
}
.qk-chip.hi {
  background: var(--accent-dim);
  color: var(--text);
  border: 2rpx solid var(--accent-shadow);
}
.qk-chip.no {
  background: var(--card);
  color: var(--text-2);
  border: 2rpx solid var(--vb-btn-line);
}
.qk-hover {
  filter: brightness(0.94);
  transform: scale(0.985);
}

/* 照片证据条冻结置顶(真机反馈 2026-10-17):收起态随滚动吸顶,清单再长照片始终可见;
   展开态(46vh 限高)保持文档流,避免吸顶占掉半个屏。 */
.photoWrap.collapsed {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 5;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
}

/* ---- 微交互复用包(2026-10-17):勾选画勾 / 照片条高度过渡 / 保存庆祝胶囊 ---- */
/* 勾选画勾:行进入保留态时对勾弹出一次(类切换触发,不改内容) */
.ck {
  transition: background-color 0.18s ease-out, border-color 0.18s ease-out;
}
.row.sel .ck {
  animation: ckpop 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.35);
}
@keyframes ckpop {
  0% {
    transform: scale(0.7);
  }
  60% {
    transform: scale(1.15);
  }
  to {
    transform: scale(1);
  }
}
.row {
  transition: background-color 0.18s ease-out, border-color 0.18s ease-out;
}
/* 照片条展开/收起高度过渡(展开态 JS 像素高,收起 300rpx,二者显式可过渡) */
.photoWrap {
  transition: height 0.25s ease-out;
}
/* 保存庆祝胶囊:墨底黄字+对勾弹出+自动收(替代一闪而过的 toast,反馈闭环) */
.celebrate {
  position: fixed;
  left: 50%;
  bottom: 220rpx;
  transform: translateX(-50%);
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 36rpx;
  border-radius: 99rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
  animation: celpop 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.35);
}
@keyframes celpop {
  0% {
    transform: translateX(-50%) translateY(30rpx) scale(0.9);
    opacity: 0;
  }
  60% {
    transform: translateX(-50%) translateY(-6rpx) scale(1.03);
  }
  to {
    transform: translateX(-50%) translateY(0) scale(1);
    opacity: 1;
  }
}

/* 层级预览行(2026-10-18):点按手动改拆分层级(› 连接) */
.lv.locpath {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}

/* 入口态识别中:照片限高预览+蒙层文案(2026-10-18;限高由 JS photoExpandStyle 保证) */
.entry-photo {
  position: relative;
  margin: 24rpx auto 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}
.entry-photo-veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom) * 0);
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.62));
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.entry-photo-veil .e2 {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.85;
}

/* ---------- 数量区(issue #102 Q1):步进器 + 单位选择器 + 待核对标 ---------- */
.qtywrap { display: flex; align-items: center; gap: 10rpx; }
.qty-pending { font-size: 18rpx; color: var(--text-2, #999); margin-right: 4rpx; }
.step-unit-btn { padding: 6rpx 12rpx; border-radius: 10rpx; background: rgba(0,0,0,.06); font-size: 22rpx; }
