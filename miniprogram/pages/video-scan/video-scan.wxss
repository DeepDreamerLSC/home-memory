.page {
  min-height: 100vh;
  padding: 40rpx 44rpx 64rpx;
  box-sizing: border-box;
  background: var(--bg, #f4efe3);
  color: var(--text);
}
.hero { padding: 12rpx 8rpx 24rpx; }
.hero-title { font-size: 54rpx; font-weight: 600; letter-spacing: -1.6rpx; }
.hero-sub { margin-top: 12rpx; font-size: 25rpx; line-height: 1.55; color: var(--text-2); }
.card {
  margin: 0 0 22rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  background: var(--card, #fffdf7);
  border: 1rpx solid var(--line);
  box-shadow: none;
}
.center-card { text-align: center; padding: 44rpx 30rpx; }
.empty-face { font-size: 58rpx; }
.empty-title { margin-top: 10rpx; font-size: 34rpx; font-weight: 800; }
.empty-sub { margin-top: 12rpx; font-size: 25rpx; line-height: 1.5; color: var(--text-2); }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 29rpx; font-weight: 800; }
.text-action { color: var(--go-bg, #1d1c18); font-size: 24rpx; font-weight: 700; padding: 8rpx 0 8rpx 20rpx; }
.hint { margin-top: 12rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-3); }
.progress-line { margin-top: 18rpx; font-size: 26rpx; }
.primary-btn {
  margin-top: 22rpx;
  padding: 22rpx 18rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  background: var(--go-bg, #1d1c18);
  color: var(--go-fg, #fff4c7);
  box-shadow: 0 6rpx 0 var(--vb-cta-shadow, #b78c16);
}
.primary-btn.disabled { opacity: 0.55; box-shadow: none; }
.primary-btn.done-back { padding: 30rpx 18rpx; font-size: 34rpx; border-radius: 20rpx; }
.secondary-btn {
  margin-top: 14rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid var(--line, rgba(29, 28, 24, 0.2));
  background: transparent;
}
.notice { margin-bottom: 18rpx; padding: 18rpx 20rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.5; background: var(--banner-bg, #fff3c4); }
.notice.warn { background: var(--banner-bg, #fff0cf); }
.notice.danger { background: var(--danger-bg, #ffe1dc); color: var(--danger, #8b2318); }
.empty-small { padding: 20rpx 0; font-size: 24rpx; color: var(--text-3); }
.text-input {
  margin-top: 14rpx;
  min-height: 76rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--card-inset, #f7f2e7);
  font-size: 26rpx;
}
.stats-line { margin-top: 14rpx; font-size: 25rpx; font-weight: 800; color: var(--text-2, #7a5c08); }
.check {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--text-3, rgba(29, 28, 24, 0.35));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  background: transparent;
}
.check.on { background: var(--go-bg, #1d1c18); color: var(--go-fg, #fff4c7); border-color: var(--go-bg, #1d1c18); }
.draft-card { margin-top: 16rpx; padding: 16rpx; border-radius: 18rpx; background: var(--card, #fbf7ed); border: 2rpx solid var(--line, rgba(29, 28, 24, 0.1)); }
.draft-head { display: flex; align-items: center; gap: 12rpx; }
.name-input { flex: 1; min-height: 72rpx; font-size: 28rpx; font-weight: 800; }
.tiny-danger { flex: 0 0 auto; padding: 10rpx 6rpx; font-size: 22rpx; color: var(--danger, #b02a1b); }
.target-row { margin-top: 10rpx; padding: 14rpx 12rpx; border-radius: 12rpx; background: var(--card-inset, #efe8d8); font-size: 23rpx; color: var(--text-2, #5f5437); }
.draft-meta { margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); }
/* §2.1 草稿卡 >8 高亮警示行(与组卡 sgc-warn 同一冻结文案,sceneHighlightWarningText 单一来源) */
.draft-warn { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: var(--danger, #b02a1b); }
.manual-times { margin-top: 10rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; font-size: 22rpx; color: var(--text-2); }
.time-input { width: 100rpx; min-height: 58rpx; padding: 0 10rpx; border-radius: 10rpx; background: var(--card, #fff); text-align: center; font-size: 24rpx; }
.draft-actions { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.mini-btn { padding: 10rpx 16rpx; border-radius: 999rpx; border: 2rpx solid var(--line, rgba(29, 28, 24, 0.18)); font-size: 22rpx; font-weight: 700; }
.privacy-note { margin: 16rpx 4rpx 0; font-size: 21rpx; line-height: 1.55; color: var(--text-3); }

/* ---------- 数量输入(issue #102 Q3):步进器 + 单位选择器 + 线索数≠件数提示 ---------- */
.qtyrow { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; flex-wrap: wrap; }
.qty-label { font-size: 22rpx; color: var(--text-3, #999); }
.step { display: flex; align-items: center; gap: 8rpx; }
.stepBtn { width: 52rpx; height: 52rpx; border-radius: 999rpx; border: 2rpx solid rgba(29,28,24,.18); display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 800; }
.stepNum { min-width: 64rpx; text-align: center; font-size: 28rpx; font-weight: 800; }
.step-unit-btn { padding: 8rpx 14rpx; border-radius: 10rpx; background: rgba(0,0,0,.06); font-size: 22rpx; }
.qty-pending { font-size: 20rpx; color: var(--text-2, #999); }

/* ---------- 「归到」逐层选择器(#116 PR A):遮罩 + 底部面板(D1 页同款形态) ---------- */
.layer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}
.layer {
  width: 100%;
  max-height: 72vh;
  background: var(--card, #fffdf7);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.layer-scroll { max-height: 46vh; margin: 12rpx 0; }
.crumb-line { margin-top: 10rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: var(--card-inset, #f7f2e7); font-size: 23rpx; color: var(--text-2); font-weight: 700; }
.option-row {
  padding: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.option-row:active { background: var(--card-inset, #f7f2e7); }
.option-current { background: var(--card-inset, #efe8d8); }
.item-main { flex: 1; min-width: 0; }
.item-name { font-size: 27rpx; font-weight: 800; }
.item-location { margin-top: 4rpx; font-size: 21rpx; color: var(--text-3); }
.pick-check { flex: 0 0 auto; padding: 8rpx 16rpx; border-radius: 999rpx; border: 2rpx solid var(--line, rgba(29, 28, 24, 0.2)); font-size: 22rpx; font-weight: 800; }
.pick-check.drill { border-style: dashed; color: var(--text-2); font-weight: 700; }
.layer-btns { display: flex; gap: 12rpx; }
.layer-btns .secondary-btn { margin-top: 14rpx; flex: 1; }
.layer-btns .primary-btn { margin-top: 14rpx; flex: 1; }
/* 「归到」行与既有 target-row 同款底色,仅字重区分 */
.node-row { font-weight: 700; color: var(--text-2, #5f5437); }

/* ⑥(#121 批次乙)「归到」选择器行语义图标:资产在场才渲染(现状无徽章,零漂移);
   明暗由全局 .theme-light/.theme-dark(appearance 变量)自动跟随 */
.option-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.option-icon .loc-icon {
  width: 44rpx;
  height: 44rpx;
}
