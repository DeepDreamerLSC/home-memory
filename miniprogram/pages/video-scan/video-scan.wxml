<view class="appearance-root" style="{{themeStyle}}">
<view class="page">
  <view class="hero">
    <view class="hero-title">🎬 拍视频找多件</view>
    <view class="hero-sub">抽屉/柜子录一段视频，AI 给线索；你逐件勾选、改名、拆分或补件后才保存。同名不代表同一件，原视频确认前不上传。</view>
  </view>

  <!-- L2 断点续扫:识别中断(有已落盘进度且未到总帧数)时给续扫入口 + 重新扫描次选 -->
  <view
    wx:if="{{!busy && (phase === 'idle' || phase === 'review' || phase === 'failed') && scannedFrameIndexes.length > 0 && scannedFrameIndexes.length < framesTotal}}"
    class="card"
  >
    <view class="section-title">上次识别中断</view>
    <view class="hint">已识别 {{scannedFrameIndexes.length}} 帧，继续识别剩余 {{framesTotal - scannedFrameIndexes.length}} 帧</view>
    <view class="primary-btn" bindtap="onResumeScanTap">继续识别剩余 {{framesTotal - scannedFrameIndexes.length}} 帧</view>
    <view class="secondary-btn" bindtap="onRescanTap">重新扫描</view>
  </view>

  <view wx:if="{{phase === 'idle'}}" class="card center-card">
    <view class="empty-face">📦</view>
    <view class="empty-title">录一段抽屉或柜子</view>
    <view class="empty-sub">建议 5–30 秒，慢慢扫过要记录的区域。AI 只给候选，不会自动入库。</view>
    <view class="primary-btn" bindtap="onChooseVideoTap">开始录/选视频</view>
  </view>

  <view wx:if="{{phase === 'scanning'}}" class="card">
    <view class="section-title">正在找物品线索…</view>
    <view class="progress-line">{{progressText}}</view>
    <view class="hint">只把单帧临时发到云端 AI；base64 用完即弃，原视频不会在确认前上传。</view>
    <view class="secondary-btn" bindtap="onCancelScanTap">取消识别</view>
  </view>

  <block wx:if="{{phase === 'review' || phase === 'uploading' || phase === 'committing'}}">
    <view wx:if="{{failureText}}" class="notice warn">{{failureText}}</view>
    <view wx:if="{{errorText}}" class="notice danger">{{errorText}}</view>
    <view wx:if="{{resultText}}" class="notice">{{resultText}}</view>

    <view class="card">
      <view class="section-title">这次视频的位置</view>
      <input class="text-input" value="{{batchLocation}}" placeholder="例如：书房 · 右侧抽屉" bindinput="onBatchLocationInput" />
      <view class="hint">新物品默认继承这个位置；可在每件草稿里单独改。已有物品不会改位置。</view>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-title">AI 线索</view>
        <view class="text-action" bindtap="onRestartTap">重拍</view>
      </view>
      <view wx:if="{{observations.length > 0}}" class="stats-line">{{sceneStats.topLineText}}</view>
      <view class="hint">组数不是物品件数;同名线索不会被自动合并</view>
      <view wx:if="{{observationGroups.length === 0}}" class="empty-small">没有 AI 线索。可直接补一件，或重拍。</view>
      <scene-group-card
        wx:for="{{observationGroups}}"
        wx:for-item="group"
        wx:key="nameKey"
        group="{{group}}"
        busy="{{busy}}"
        bind:obsToggle="onObservationToggle"
        bind:obsPreview="onObsImageTap"
        bind:confirmSingle="onGroupConfirmSingle"
        bind:confirmMulti="onGroupConfirmMulti"
        bind:defer="onGroupDefer"
        bind:generatePerObs="onGenerateDraftsTap"
      />
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-title">待确认物品({{draftViews.length}})</view>
        <view class="text-action" bindtap="onAddManualDraftTap">＋ 补一件</view>
      </view>
      <view wx:if="{{draftViews.length === 0}}" class="empty-small">先勾选线索生成草稿，或点「补一件」。</view>
      <view wx:for="{{draftViews}}" wx:for-item="d" wx:for-index="idx" wx:key="draftKey" class="draft-card">
        <view class="draft-head">
          <view class="check {{d.checked ? 'on' : ''}}" data-index="{{idx}}" bindtap="onDraftCheckedTap">{{d.checked ? '✓' : ''}}</view>
          <input class="name-input" value="{{d.name}}" placeholder="物品名称" data-index="{{idx}}" bindinput="onDraftNameInput" />
          <view class="tiny-danger" data-index="{{idx}}" bindtap="onDraftRemoveTap">移除</view>
        </view>
        <view class="target-row" data-index="{{idx}}" bindtap="onDraftTargetTap">{{d.targetText}} ›</view>
        <view wx:if="{{d.target === 'new'}}" class="target-row node-row" data-index="{{idx}}" bindtap="onDraftNodeTap">归到：{{d.nodeText || '不选，只按文字记录'}} ›</view>
        <input wx:if="{{d.target === 'new'}}" class="text-input" value="{{d.locationText}}" placeholder="这件放在哪里" data-index="{{idx}}" bindinput="onDraftLocationInput" />
        <input wx:if="{{d.target === 'new'}}" class="text-input" value="{{d.note}}" placeholder="备注（可选）" data-index="{{idx}}" bindinput="onDraftNoteInput" />
        <view wx:if="{{d.target === 'new'}}" class="qtyrow">
          <text class="qty-label">数量</text>
          <view class="step">
            <view class="stepBtn" data-index="{{idx}}" data-d="{{ -1 }}" bindtap="onDraftQtyStep">−</view>
            <text class="stepNum">{{d.qty}}</text>
            <view class="stepBtn" data-index="{{idx}}" data-d="{{ 1 }}" bindtap="onDraftQtyStep">+</view>
          </view>
          <picker class="step-unit" range="{{unitOptions}}" value="{{d.unitIndex}}" data-index="{{idx}}" bindchange="onDraftUnitChange">
            <view class="step-unit-btn">{{d.unit}} ▾</view>
          </picker>
          <text wx:if="{{!d.quantitySet}}" class="qty-pending">不填按 1 {{d.unit}} · 线索数不代表件数</text>
        </view>
        <view class="draft-meta">{{d.observationCount}} 条线索 · {{d.highlightCount}} 条用户确认高亮{{d.isManual ? ' · 手动补件' : ''}}{{d.quantitySet ? ' · ×' + d.qty + d.unit : ''}}</view>
        <view wx:if="{{d.highlightWarning}}" class="draft-warn">{{d.highlightWarning}}</view>
        <view wx:if="{{d.isManual}}" class="manual-times">
          <view>仅时间窗可无框：</view>
          <input class="time-input" type="digit" value="{{d.startSecText}}" data-index="{{idx}}" data-field="start" bindinput="onDraftManualTimeInput" /> 秒 —
          <input class="time-input" type="digit" value="{{d.endSecText}}" data-index="{{idx}}" data-field="end" bindinput="onDraftManualTimeInput" /> 秒
        </view>
        <view class="draft-actions">
          <view class="mini-btn" data-key="{{d.draftKey}}" bindtap="onDraftMergeSelectTap">{{d.mergeSelected ? '取消合并选择' : '选择合并'}}</view>
          <view wx:if="{{d.highlightCount > 1}}" class="mini-btn" data-index="{{idx}}" bindtap="onDraftSplitTap">拆成多件</view>
        </view>
      </view>
      <view wx:if="{{mergeSelectedKeys.length > 0}}" class="primary-btn" bindtap="onMergeDraftsTap">合并选中的新建物品草稿</view>
    </view>

    <view class="privacy-note">确认保存后才会上传原视频。每件物品各存一行证据和各自的高亮；同一视频可被多件物品引用。删除某件物品时，只有最后一条引用消失才删原视频。</view>
    <view wx:if="{{busy}}" class="primary-btn disabled">处理中…</view>
    <view wx:else class="primary-btn" bindtap="onSaveTap">确认并保存 {{sceneStats.checkedDraftCount}} 件</view>
  </block>

  <view wx:if="{{phase === 'partial'}}" class="card">
    <view class="section-title">视频已上传，关联尚未全部完成</view>
    <view wx:if="{{errorText}}" class="notice danger">{{errorText}}</view>
    <view wx:if="{{resultText}}" class="notice">{{resultText}}</view>
    <view class="hint">重试会使用同一份确认内容（同 scene_id / operation_id / highlights），已成功项不会重复创建；不会按名称自动合并。</view>
    <view wx:if="{{busy}}" class="primary-btn disabled">处理中…</view>
    <view wx:else class="primary-btn" bindtap="onRetryCommitTap">重试剩余关联</view>
    <view class="secondary-btn" bindtap="onDiscardPendingTap">放弃待关联视频</view>
  </view>

  <view wx:if="{{phase === 'done'}}" class="card center-card">
    <view class="empty-face">✓</view>
    <view class="empty-title">已保存</view>
    <view class="empty-sub">{{resultText}}</view>
    <view class="privacy-note">视频默认不在详情页自动播放；需要你点开才播放。</view>
    <view class="primary-btn done-back" bindtap="onDoneBackTap">返回</view>
  </view>

  <view wx:if="{{phase === 'failed'}}" class="card center-card">
    <view class="empty-face">⚠</view>
    <view class="empty-title">这次没有完成</view>
    <view class="empty-sub">{{errorText}}</view>
    <view class="primary-btn" bindtap="onRestartTap">重新选择视频</view>
  </view>

  <!-- 「归到」逐层选择器(#116 PR A):复用 D1 弹层模式;从家第一层起逐层下钻,
       家根本身不可挂(nodeSelectorCanPick 控制),既有 locations list 零新读侧 action -->
  <view wx:if="{{nodeSelectorVisible}}" class="layer-mask" bindtap="onNodeSelectorCloseTap">
    <view class="layer" catchtap="noop">
      <view class="card-title">归到哪个位置</view>
      <view class="hint">从家里的第一层开始逐层选；不选就只按文字记录，不会挂到位置树。</view>
      <view class="crumb-line">{{nodeSelectorPathText}}</view>
      <scroll-view scroll-y class="layer-scroll">
        <view wx:if="{{nodeSelectorCanPick}}" class="option-row option-current" bindtap="onNodePickCurrentTap">
          <view class="item-main">
            <view class="item-name">就归「{{nodeSelectorCurrentName}}」</view>
            <view class="item-location">{{nodeSelectorPathText}}</view>
          </view>
          <view class="pick-check">选</view>
        </view>
        <view
          wx:for="{{nodeSelectorOptions}}"
          wx:key="locationId"
          class="option-row"
          data-node-id="{{item.locationId}}"
          bindtap="onNodeOptionTap"
        >
          <view wx:if="{{item.icon}}" class="option-icon"><image class="loc-icon theme-light" src="{{item.icon}}" mode="aspectFit"/><image class="loc-icon theme-dark" src="{{item.iconDark}}" mode="aspectFit"/></view>
          <view class="item-main">
            <view class="item-name">{{item.name}}（{{item.itemCount}} 件）</view>
            <view class="item-location">{{item.pathText}}</view>
          </view>
          <view wx:if="{{item.hasChildren}}" class="pick-check drill" data-node-id="{{item.locationId}}" catchtap="onNodeDrillTap">下级 ›</view>
          <view class="pick-check">选</view>
        </view>
        <view wx:if="{{!nodeSelectorLoading && nodeSelectorOptions.length === 0}}" class="empty-small">这一层下面没有更细的位置。</view>
        <view wx:if="{{nodeSelectorLoading}}" class="empty-small">正在加载…</view>
        <view wx:if="{{nodeSelectorError}}" class="notice danger">{{nodeSelectorError}}</view>
      </scroll-view>
      <view class="layer-btns">
        <view wx:if="{{nodeSelectorCanBack}}" class="secondary-btn" bindtap="onNodeSelectorBackTap">上一层</view>
        <view wx:if="{{nodeSelectorFor >= 0}}" class="secondary-btn" bindtap="onNodeSelectorClearTap">不挂，只记文字</view>
        <view class="primary-btn" bindtap="onNodeSelectorCloseTap">取消</view>
      </view>
    </view>
  </view>
</view>

</view>
