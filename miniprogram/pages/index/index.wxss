/* 首页样式:品牌「我靠东西呢」(其余复用 app.wxss) */

/* 品牌头部 */
.brand {
  padding: 24rpx 32rpx 8rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 800;
  color: #191919;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #8a8577;
}

/* 搜索执行按钮:紧凑方块,明确可点 */
.search-go {
  width: 88rpx;
  height: 76rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #191919;
  color: #ffe15a;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.search-go.busy {
  opacity: 0.5;
}

/* 模式切换:次级链接 */
.mode-link {
  font-size: 26rpx;
  color: #4c483e;
  padding: 8rpx 20rpx;
  border: 2rpx solid #e8e3d6;
  border-radius: 999rpx;
  background: #faf8f2;
}

/* 语音状态行 */
.voice-state {
  font-size: 26rpx;
  color: #4c483e;
  margin: 8rpx 0 16rpx;
  min-height: 40rpx;
}

/* 按住说话:实心大按钮,一屏唯一强调面 */
.talk-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 8rpx 0 20rpx;
  padding: 56rpx 0;
  background: #ffe15a;
  border: none;
  border-radius: 28rpx;
  color: #191919;
  user-select: none;
  box-shadow: 0 6rpx 0 #e5c431;
}

.talk-btn.busy {
  background: #f3edd9;
  box-shadow: none;
  color: #8a8577;
}

.talk-btn.cancel {
  background: #fdecec;
  box-shadow: 0 6rpx 0 #ecc2c0;
  color: #d93025;
}

.talk-icon {
  font-size: 34rpx;
  font-weight: 700;
}

.talk-label {
  font-size: 26rpx;
  opacity: 0.75;
}

.partial-text {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #faf8f2;
  border: 2rpx solid #e8e3d6;
  font-size: 28rpx;
  color: #191919;
  line-height: 1.5;
}

.example {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a39d8d;
  text-align: center;
}
