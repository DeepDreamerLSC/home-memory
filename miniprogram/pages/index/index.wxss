/* Approved ui-polish-v1 prototype: dimensions are px × 2 in rpx. */
.home-page { padding: 40rpx 44rpx 220rpx; }
.heading-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.mtitle { font-size: 54rpx; font-weight: 600; letter-spacing: -1.6rpx; line-height: 1.35; min-width: 0; flex: 1; overflow-wrap: anywhere; }
.home-sub { font-size: 24rpx; line-height: 1.45; color: var(--text-2); margin-top: 16rpx; }
.fam-chip { display: flex; align-items: center; gap: 10rpx; min-height: 88rpx; margin: -8rpx 0; padding-left: 16rpx; flex-shrink: 0; font-size: 22rpx; color: var(--text-2); }
.fam-chip .ui-icon { width: 26rpx; height: 26rpx; }
.fam-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #899276; margin-right: 4rpx; }
.ui-icon { display: block; width: 28rpx; height: 28rpx; flex-shrink: 0; }
.backchip { display: inline-flex; align-items: center; min-height: 88rpx; margin: -16rpx 0 14rpx; font-size: 30rpx; color: var(--text-2); }
.refresh-flag { color: var(--text-3); font-size: 20rpx; margin-top: 8rpx; }
.searchbar { display: flex; align-items: center; gap: 20rpx; border: 1rpx solid var(--line); background: var(--card); border-radius: 30rpx; padding: 10rpx 10rpx 10rpx 28rpx; margin: 48rpx 0 44rpx; }
.searchbar > .ui-icon { width: 36rpx; height: 36rpx; }
.search-input { min-width: 0; flex: 1; font-size: 26rpx; height: 76rpx; background: transparent; color: var(--text); }
.search-go-hit { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; margin: -6rpx; flex-shrink: 0; }
.search-go { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 22rpx; background: var(--go-bg); color: var(--go-fg); font-size: 36rpx; font-weight: 400; }
.section-label { font-size: 28rpx; font-weight: 600; margin: 0 0 26rpx; }
.heading-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
button.map-add { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; color: var(--text); font-size: 42rpx; font-weight: 400; line-height: 1; }
.map-add::after, .location-hint button::after { border: none; }
.map-add[disabled] { opacity: .45; }
.location-hint { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: -24rpx 0 24rpx; padding: 0 24rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--card-inset); color: var(--text-2); font-size: 22rpx; line-height: 1.5; }
.location-hint > text { flex: 1; min-width: 0; }
.location-hint button { width: auto; min-width: 88rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 88rpx; margin: 0 -12rpx 0 0; padding: 0 12rpx; background: transparent; color: var(--text-2); font-size: 22rpx; line-height: 1.4; }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-top: 34rpx; }
.section-header .section-label { margin-bottom: 0; }
.recent-more { min-height: 60rpx; display: flex; align-items: center; color: var(--text-2); font-size: 22rpx; }
.roomgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.roomtile { min-width: 0; background: var(--card); border: 1rpx solid var(--line); border-radius: 34rpx; overflow: hidden; transition: opacity .15s; }
.roomtile-active { opacity: .72; }
.room-art { height: 206rpx; background: var(--room-bg, var(--card-inset)); display: flex; align-items: center; justify-content: center; }
.room-image { width: 300rpx; max-width: 100%; height: 206rpx; display: block; }
.room-info { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 24rpx 26rpx; }
.room-copy { flex: 1; min-width: 0; }
.rname { font-size: 28rpx; font-weight: 500; color: var(--text); line-height: 1.4; overflow-wrap: anywhere; }
.rcount { font-size: 20rpx; color: var(--text-2); margin-top: 6rpx; }
.due-banner { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 0 22rpx; margin: 22rpx 0 34rpx; border-bottom: 1rpx solid var(--line); color: var(--text-2); font-size: 22rpx; }
.due-banner-text { flex: 1; }
.unmounted-entry { display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid var(--line); padding: 24rpx 0; margin-top: 12rpx; }
.unmounted-symbol { width: 60rpx; height: 60rpx; border-radius: 18rpx; background: var(--card-inset); display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--text-2); }
.result-card { background: transparent; }
.result-row { display: flex; align-items: center; gap: 26rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.result-row:last-child { border-bottom: 0; }
.item-icon { width: 90rpx; height: 90rpx; border-radius: 24rpx; background: var(--card-inset); overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.item-art { display: block; width: 70rpx; height: 70rpx; }
.item-photo { width: 90rpx; height: 90rpx; }
.item-main { min-width: 0; flex: 1; }
.item-name { font-size: 26rpx; font-weight: 500; color: var(--text); line-height: 1.5; overflow-wrap: anywhere; }
.item-location { color: var(--text-2); font-size: 22rpx; margin-top: 10rpx; line-height: 1.5; overflow-wrap: anywhere; }
.item-date { color: var(--text-3); font-size: 20rpx; align-self: flex-start; padding-top: 6rpx; flex-shrink: 0; }
.neutral-icon { font-size: 30rpx; color: var(--text-2); }
.unverified-tag { color: var(--text-3); font-size: 20rpx; }
.video-badge { margin-left: 12rpx; font-size: 20rpx; color: var(--text-2); }
.video-badge.unavailable { opacity: .6; }
/* 数量槽(issue #102 Q1,Q0-CONTRACT §10.1):已确认「×N单位」;未确认「待核对」中性标记 */
.qty-badge { margin-left: 12rpx; font-size: 20rpx; color: var(--text-2); white-space: nowrap; }
.qty-badge.unconfirmed { opacity: .7; }
.direct-label { margin-top: 36rpx; }
.manage-link, .collapse-link, .recent-retry { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: var(--text-2); margin-top: 30rpx; }
.resume-banner, .stale-banner { padding: 22rpx 24rpx; margin-top: 20rpx; font-size: 22rpx; line-height: 1.6; border-radius: 24rpx; background: var(--card-inset); color: var(--text-2); }
.resume-banner text { float: right; color: var(--text); }
.empty-home { padding: 28rpx 16rpx 20rpx; text-align: center; }
.empty-art { display: block; width: 420rpx; height: 300rpx; max-width: 100%; margin: 0 auto 36rpx; }
.empty-title { font-size: 40rpx; font-weight: 500; line-height: 1.5; }
.empty-sub { font-size: 24rpx; line-height: 1.8; color: var(--text-2); margin-top: 20rpx; }
.text-action { min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text-2); }
.empty-note, .fail-view, .empty-map { text-align: center; padding: 64rpx 16rpx; font-size: 28rpx; line-height: 1.8; }
.fail-title { font-size: 34rpx; font-weight: 500; }
.fail-sub, .tiny-center { color: var(--text-2); font-size: 22rpx; margin-top: 20rpx; text-align: center; }
.skel-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.skel-tile { height: 336rpx; border-radius: 34rpx; background: var(--card-inset); overflow: hidden; position: relative; }
.skel-shimmer { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, var(--card), transparent); animation: shimmer 1.5s infinite; }
@keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
/* Keep themed artwork mutually exclusive despite component display declarations. */
.home-page .theme-light { display: block; }
.home-page .theme-dark { display: none; }
@media (prefers-color-scheme: dark) {
  .home-page .theme-light { display: none; }
  .home-page .theme-dark { display: block; }
}
.sheet-mask { position: fixed; inset: 0; background: rgba(23,29,24,.4); display: none; align-items: flex-end; z-index: 60; }
.sheet-mask.open { display: flex; }
.sheet { box-sizing: border-box; width: 100%; background: var(--bg); border-radius: 44rpx 44rpx 0 0; padding: 32rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 36rpx; font-weight: 500; color: var(--text); margin-bottom: 16rpx; }
.sheet-act { display: flex; flex-direction: column; justify-content: center; min-height: 104rpx; padding: 22rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--line); }
.sheet-act.disabled { opacity: .55; }
.sheet-act-name { font-size: 28rpx; font-weight: 500; color: var(--text); line-height: 1.5; }
.sheet-act-sub { font-size: 22rpx; color: var(--text-2); margin-top: 6rpx; line-height: 1.5; }
.sheet-close { display: flex; align-items: center; justify-content: center; min-height: 88rpx; color: var(--text-2); font-size: 26rpx; margin-top: 16rpx; }
.searchbar .search-input { padding: 0; border: 0; border-radius: 0; min-height: 0; box-sizing: border-box; }
/* First-use entry follows the approved empty state, with its own voice controls. */
.empty-home { padding: 36rpx 16rpx 20rpx; }
.empty-home .empty-art { margin-bottom: 36rpx; }
.empty-home .empty-title { font-size: 44rpx; }
.empty-home .empty-sub { margin: 24rpx 0 50rpx; }
.voice-cta { min-height: 102rpx; display: flex; align-items: center; justify-content: center; gap: 22rpx; background: var(--vb-hold-bg); color: var(--vb-hold-fg); border-radius: 28rpx; }
.voice-cta.pressed { opacity: .8; }
.voice-cta.cancel { background: var(--danger); color: var(--card); }
.cta-label { font-size: 28rpx; font-weight: 500; }
.cta-micdot { width: 58rpx; height: 58rpx; border-radius: 50%; background: var(--vb-mic-bg); display: flex; align-items: center; justify-content: center; position: relative; flex-shrink: 0; color: #30372c; }
.mic-cap { width: 13rpx; height: 23rpx; border: 3rpx solid #30372c; border-radius: 12rpx; position: absolute; top: 12rpx; }
.mic-stand { width: 25rpx; height: 24rpx; border: 3rpx solid #30372c; border-top: 0; border-radius: 0 0 18rpx 18rpx; position: absolute; top: 21rpx; }
.mic-seconds { font-size: 22rpx; font-weight: 500; }
.partial-text { color: var(--text-2); font-size: 24rpx; margin-top: 20rpx; line-height: 1.7; }
.empty-trust { font-size: 20rpx; color: var(--text-2); line-height: 1.6; margin-top: 12rpx; }

.first-use-context { display: flex; align-items: center; justify-content: flex-end; }

.home-meta { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.home-meta .home-sub { margin-top:0; }
.home-meta .fam-chip { min-height:64rpx; margin:0; padding:0; }
.home-avatar { width:88rpx; min-width:88rpx; height:88rpx; min-height:88rpx; margin:0; padding:6rpx; border-radius:50%; background:var(--card-inset); color:var(--text); font-size:32rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.home-avatar::after { border:0; }
.home-avatar image { width:100%; height:100%; border-radius:50%; }
.first-use-context { display:flex; align-items:center; justify-content:space-between; }
.home-person { position:relative; width:48rpx; height:60rpx; }
.home-person view:first-child { position:absolute; width:22rpx; height:22rpx; border:2rpx solid var(--text-2); border-radius:50%; left:13rpx; top:4rpx; }
.home-person view:last-child { position:absolute; width:42rpx; height:24rpx; border:2rpx solid var(--text-2); border-bottom:0; border-radius:50% 50% 0 0; left:3rpx; bottom:4rpx; }

button.home-avatar { flex:0 0 88rpx; min-width:88rpx; max-width:88rpx; box-sizing:border-box; }
button.home-avatar { margin:0; padding:6rpx; }

button.location-act { width: 100%; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; background: transparent; border-radius: 0; text-align: left; line-height: 1.5; color: var(--text); font-size: 28rpx; }
button.location-act::after { border: none; }
button.location-act.sheet-close { color: var(--text-2); font-size: 26rpx; }
button.location-delete { color: var(--danger, #b44d43); }
