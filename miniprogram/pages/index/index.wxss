/* 首页样式:参考图 v3——黄块主视觉 + 黑圆麦克风,跟随系统深浅色(颜色变量见 app.wxss) */

/* 品牌头部 */
.brand {
  padding: 24rpx 32rpx 8rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 找东西:独立区,内嵌深槽 + 圆形执行钮 */
.search-wrap {
  margin: 16rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

/* 「找」按钮外包透明热区:视觉圆 80rpx 不变,实际可点范围四周外扩 */
.search-go-hit {
  flex-shrink: 0;
  /* 左侧 16rpx 恰好接上原按钮与输入框的间距,视觉位置不变;其余方向各外扩 20rpx */
  padding: 20rpx 20rpx 20rpx 16rpx;
  /* 负边距抵消上下外扩占用的行高,布局与改前一致 */
  margin: -20rpx 0;
}

.search-go {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--go-bg);
  color: var(--go-fg);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
}

.search-go.busy {
  opacity: 0.5;
}

/* 按住说话:明黄大块 + 黑圆麦克风,一屏唯一强调面 */
.talk-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 16rpx 0 20rpx;
  padding: 48rpx 0 44rpx;
  background: var(--accent);
  border: none;
  border-radius: 32rpx;
  color: #191919;
  user-select: none;
  box-shadow: 0 8rpx 0 var(--accent-shadow);
}

.talk-btn.busy {
  background: var(--accent-dim);
  box-shadow: none;
}

.talk-btn.cancel {
  background: var(--danger-bg);
  box-shadow: 0 8rpx 0 var(--danger-shadow);
}

/* 麦克风图形:整个黄块即按钮,图形默认黑色;取消态随文案转红 */
.mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  --mic: #191919;
}

.talk-btn.cancel .mic-icon {
  --mic: var(--danger);
}

.mic-cap {
  width: 32rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: var(--mic, #191919);
}

.mic-stand {
  width: 6rpx;
  height: 16rpx;
  background: var(--mic, #191919);
  margin-top: 6rpx;
}

.mic-base {
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--mic, #191919);
  margin-top: 4rpx;
}

.mic-seconds {
  color: #191919;
  font-size: 44rpx;
  font-weight: 700;
}

.talk-btn.busy .mic-icon {
  opacity: 0.45;
}

.talk-label {
  font-size: 30rpx;
  font-weight: 700;
}

.talk-btn.busy .talk-label {
  color: var(--text-2);
  font-weight: 400;
}

.talk-btn.cancel .talk-label {
  color: var(--danger);
}

.partial-text {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--card-inset);
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.example {
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}

/* 模式切换:块下方居中的次级链接 */
.mode-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
  text-align: center;
}

/* 未完成草稿恢复横幅 */
.resume-banner {
  margin: 12rpx 32rpx 0;
  padding: 18rpx 24rpx;
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text);
}

/* 品牌行:左标题右头像 */
.brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.brand-main {
  flex: 1;
  min-width: 0;
}
.home-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}
.home-avatar-btn::after {
  border: none;
}
.home-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--accent-dim, #f3edd9);
}
.home-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-3, #a39d8d);
  font-weight: 600;
}

/* 昵称弹窗 */
.nick-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.nick-card {
  width: 580rpx;
  padding: 40rpx 36rpx 28rpx;
  border-radius: 28rpx;
  background: var(--card, #ffffff);
}
.nick-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text, #191919);
}
.nick-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3, #a39d8d);
}
.nick-input {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--card-inset, #f1ede0);
  color: var(--text, #191919);
  font-size: 30rpx;
}
.nick-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}
.nick-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: var(--card-inset, #f1ede0);
  color: var(--text-2, #4c483e);
  font-size: 28rpx;
}
.nick-btn.primary {
  background: var(--go-bg, #191919);
  color: #fff;
}
