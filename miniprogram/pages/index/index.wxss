/*
 * 首页样式(issue #45 冻结原型 H0/H1/H1b/X1/X2):
 * - 家庭地图两列格子 + 容器视图整页切换(抬头随容器变,返回胶囊逐层退回);
 * - H0 大语音 CTA 与语音条同用 --vb-* 冻结配色(九/十轮);
 * - 尺寸按原型 px×2=rpx(375px 画布基准),颜色只用全局 CSS 变量(app.wxss)。
 */

/* ============ 品牌头部与家庭上下文入口(原型 brand-row,内容边距 18px=36rpx) ============ */
.brand {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 36rpx 36rpx 0;
}

.brand-main {
  flex: 1;
  min-width: 0;
}

.brand-name {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

/* 家庭上下文头:共享=「我们家」+圆点;个人=「我的家」(原型 fam-chip)
   (#36 真机反馈 Fix 1:热区 88 = 面 66(原 88 × 0.75)+ 透明上下 11,flex 居中 + line-height:1) */
.fam-chip {
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.fam-chip-face {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.fam-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent-shadow);
  flex-shrink: 0;
}

.fam-caret {
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1;
}

/* 未完成草稿恢复横幅 */
.resume-banner {
  margin: 24rpx 36rpx 0;
  padding: 18rpx 24rpx;
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text);
}

/* 刷新失败:保留旧内容,如实提示(与 locations 页同款) */
.stale-banner {
  margin: 24rpx 36rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--banner-bg);
  border: 2rpx solid var(--banner-line);
  font-size: 24rpx;
  color: var(--text);
}

/* ============ 到期横幅(#36,原型 .remind-banner:家里层、有过期/临期才显示)
   (Fix 1 压扁:padding 22→16,行内容紧凑;热区=元素 88rpx) ============ */
.due-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 2rpx solid var(--danger-shadow);
  background: var(--danger-bg);
  color: var(--danger);
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 750;
  min-height: 88rpx;
  box-sizing: border-box;
}

.due-banner-hover {
  opacity: 0.82;
}

.due-banner-text {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.due-banner-arrow {
  flex: none;
  font-size: 28rpx;
}

/* 中间区域统一左右边距(原型 viewport 18px) */
.map-area {
  margin: 0 36rpx;
}

/* ============ 通用排版(原型 small/note/tiny) ============ */
.pagetitle {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 0.6rpx;
  margin: 12rpx 0;
}

.lead {
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.note {
  background: var(--card-inset);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  margin-top: 24rpx;
}

.note-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.note-text {
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.65;
}

.section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin: 40rpx 0 18rpx;
}

.tiny-center {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 8rpx;
}

/* ============ H0 大语音 CTA(--vb-* 冻结配色,与语音条同族;Fix 1 同步压扁) ============ */
.voice-cta {
  margin-top: 32rpx;
  border: 2rpx solid var(--vb-line);
  border-radius: 38rpx;
  background: var(--vb-bg);
  color: var(--vb-fg);
  box-shadow: 0 10rpx 0 var(--vb-cta-shadow);
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-weight: 750;
  font-size: 31rpx;
  line-height: 1.15; /* 会换行的长标签:等效基线补偿(≤1.2) */
  user-select: none;
  /* 录音中浮层压暗页面时,按住的按钮保持在背板之上可见(原型 V1:按下态仍可见) */
  position: relative;
  z-index: 41;
}

.voice-cta.pressed {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 0 var(--vb-cta-shadow);
}

.voice-cta.busy {
  opacity: 0.78;
}

.voice-cta.cancel {
  opacity: 0.92;
}

/* 麦克风圆点:米黄油底(--vb-hold-bg)+ 单色麦克风图形(Fix 1:96→72 同比例) */
.cta-micdot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--vb-hold-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
}

.cta-micdot .mic-cap {
  width: 18rpx;
  height: 28rpx;
  border-radius: 9rpx;
  background: var(--vb-hold-fg);
}

.cta-micdot .mic-stand {
  width: 4rpx;
  height: 10rpx;
  background: var(--vb-hold-fg);
  margin-top: 4rpx;
}

.cta-micdot .mic-base {
  width: 26rpx;
  height: 4rpx;
  border-radius: 3rpx;
  background: var(--vb-hold-fg);
  margin-top: 4rpx;
}

.cta-micdot .mic-seconds {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--vb-hold-fg);
  line-height: 1;
}

.cta-label {
  text-align: center;
}

.partial-text {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--card-inset);
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

/* 「用文字记」:CTA 下的次级链接(原型 sublnk button;Fix 1:热区抬到 88,文本行 line-height:1 居中) */
.cta-sublnk {
  margin-top: 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
  text-align: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 「用文字记 · 📷 拍照记」并列(#3 H0 次级链接排):单条内的 margin 归并到排上 */
.cta-sublnks {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.cta-sublnks .cta-sublnk {
  margin-top: 0;
}
.cta-sublnk-sep {
  color: var(--text-3);
  font-size: 25rpx;
  line-height: 1;
}

/* 拍照识物常驻入口(#3):brand 区下白卡细描边胶囊,样式用 app.wxss 既有令牌 */
.photo-entry {
  margin: 24rpx 36rpx 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.photo-entry-face {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 16rpx 26rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}
.photo-entry-face .photo-entry-sub {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--text-3);
}
.photo-entry-hover {
  filter: brightness(0.96);
}

/* 拍照批恢复横幅(#3):与草稿横幅同形态,间距略收(两横幅并存时不顶) */
.photo-resume-banner {
  margin-top: 12rpx;
}

/* ============ 搜索(H0/H1/H1b 共用,原型 searchbar) ============ */
.searchbar {
  display: flex;
  align-items: center;
}

.searchbar .search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: var(--text);
}

/* 「找」按钮外包透明热区:视觉方块不变,实际可点范围四周外扩
   (Fix 1 先例本体:视觉/热区分层;面 96→72) */
.search-go-hit {
  flex-shrink: 0;
  padding: 20rpx 20rpx 20rpx 16rpx;
  margin: -20rpx 0;
}

.search-go {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--go-bg);
  color: var(--go-fg);
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1;
}

.search-go.busy {
  opacity: 0.5;
}

/* ============ 搜索空态(H1b:不造假;原型 empty-note 12px) ============ */
.empty-note {
  margin-top: 24rpx;
  border: 2rpx dashed var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  background: var(--card);
}

.empty-note-main {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.empty-note-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.empty-note-btn {
  margin-top: 20rpx;
}

/* 墨底主 CTA(记一件 / 再试一次):视觉/热区分层样式统一收在 app.wxss
   (.btn.ink + .btn-face,#36 真机反馈 Fix 1),本页不再重复定义 */

/* ============ H1b 结果 / 容器条目:卡片内分隔行 ============ */
.result-card {
  background: var(--card);
  border-radius: 36rpx;
  padding: 8rpx 24rpx;
}

.result-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.result-row:last-child {
  border-bottom: none;
}

/* 收起结果:原型 morelink(13px/700;Fix 1:热区 88 + line-height:1 居中) */
.collapse-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  min-height: 88rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  line-height: 1;
}

/* ============ 家庭地图:抬头 / 返回胶囊 / 「⋯」整理 ============ */
.map-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 18rpx;
  min-height: 72rpx;
}

.mtitle {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
}

/* 后台刷新轻量指示(屏上已有内容,不整页 loading) */
.refresh-flag {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

/* 返回胶囊(Fix 1:热区 88 = 面 66(原 88 × 0.75)+ 透明上下 11,flex 居中 + line-height:1) */
.backchip {
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.backchip-face {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--card-inset);
  color: var(--text);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

/* 按压反馈(原型 backchip:active opacity .7) */
.backchip-hover {
  opacity: 0.7;
}

/* 「⋯」整理入口:视觉/热区分层样式统一收在 app.wxss(.more-inline + .more-inline-face) */

/* ============ 房间格子两列(原型 roomgrid/roomtile) ============ */
.roomgrid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.roomtile {
  position: relative;
  width: calc(50% - 10rpx);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  padding: 26rpx 28rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--card);
  color: var(--text);
  min-height: 236rpx;
  transition: transform 0.14s ease;
}

.roomtile.odd {
  margin-right: 0;
}

.roomtile-active {
  transform: scale(0.97);
}

.rico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--card-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-2);
  flex: none;
  line-height: 1;
}

.rname {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
  color: var(--text);
  word-break: break-all;
}

.rcount {
  font-size: 24rpx;
  color: var(--text-2);
}

.roomtile .chev {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 28rpx;
  color: var(--text-3);
  font-weight: 300;
}

/* 「尚未归类」通栏格(#36 真机反馈 Fix 3:可点入未挂物品明细视图;
   Fix 1:padding 24→18、图标块 76→58 同比例压扁) */
.roomtile.wide {
  width: 100%;
  margin-right: 0;
  flex-direction: row;
  align-items: center;
  min-height: 0;
  gap: 20rpx;
  padding: 18rpx 28rpx;
}

.roomtile.wide .rico {
  width: 58rpx;
  height: 58rpx;
  font-size: 28rpx;
  border-radius: 18rpx;
}

.wide-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* ============ 尚未归类明细视图(#36 0.6.0 真机反馈 Fix 3) ============
   行 = 首字块 + 名称 + 原话位置 + 灰标「位置待核实」;行点进物品详情 */
.unmounted-card {
  margin-top: 20rpx;
}

.unverified-tag {
  flex: none;
  margin-left: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--text-3);
  background: var(--card-inset);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.empty-map {
  padding: 40rpx 0;
  font-size: 25rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.7;
}

/* ============ X1 骨架屏(占位几何与真实格子一致;shimmer 扫光=原型 1.3s) ============ */
.skel-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.skel-tile {
  position: relative;
  overflow: hidden;
  width: calc(50% - 10rpx);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  height: 236rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--card);
  box-sizing: border-box;
}

.skel-tile.odd {
  margin-right: 0;
}

.skel-wide {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 96rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--card);
  box-sizing: border-box;
}

/* 扫光带(原型 .skel:after 横向 shimmer) */
.skel-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(90deg, transparent, var(--card-inset), transparent);
  animation: shimmer 1.3s infinite;
  transform: translateX(-100%);
}

@keyframes shimmer {
  from {
    transform: translateX(-100%);
  }

  to {
    transform: translateX(100%);
  }
}

/* ============ X2 失败态(失败的是这次加载,不是记录没了) ============ */
.fail-view {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fail-ico {
  font-size: 80rpx;
  line-height: 1;
}

.fail-title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text);
  margin-top: 16rpx;
  text-align: center;
}

.fail-sub {
  font-size: 25rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
  margin-top: 12rpx;
}

.fail-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* ============ 切换家庭三选弹层(十七轮 B 线;样式与 item 页「⋯」弹层同款) ============ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: none;
  align-items: flex-end;
  z-index: 60;
}

.sheet-mask.open {
  display: flex;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

/* 弹层动作行(Fix 1 口径:热区=元素 ≥88rpx,纵向 flex 居中) */
.sheet-act {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--card);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.sheet-act-hover {
  background: var(--card-inset);
}

.sheet-act.disabled {
  opacity: 0.55;
}

.sheet-act-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.sheet-act-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.3;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 24rpx;
  line-height: 1;
}

/* ============ H1b 结果行证据缩略(#3):照片替代首字图标,角标「留证」 ============ */
/* 缩略只示意「有照片留证」;行内位置仍以文字记录为准(历史语义在详情页展开) */
.item-icon {
  position: relative;
  overflow: hidden;
}

.item-photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.item-photo-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.72);
  color: #fff;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
  padding: 5rpx 8rpx;
  border-radius: 8rpx 0 0 0;
}

/* 底部条右侧「📷 拍照」入口(2026-10-17):与语音胶囊同区=记东西双入口;
   墨底黄字+硬投影+按压下沉,与拍照页「存 N 件」同语言 */
.vb-photo-btn {
  padding: 5rpx 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.vb-photo-face {
  min-width: 120rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 0 var(--vb-cta-shadow);
}
.vb-photo-hover .vb-photo-face {
  filter: brightness(0.94);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 0 var(--vb-cta-shadow);
}

/* ---- 微交互复用包(2026-10-17):房间格子首次浮现 stagger(纯 CSS,刷层重放=进入感) ---- */
.roomtile {
  animation: tileup 0.34s cubic-bezier(0.2, 0.9, 0.3, 1.35) backwards;
}
.roomtile:nth-child(2) { animation-delay: 30ms; }
.roomtile:nth-child(3) { animation-delay: 60ms; }
.roomtile:nth-child(4) { animation-delay: 90ms; }
.roomtile:nth-child(5) { animation-delay: 120ms; }
.roomtile:nth-child(6) { animation-delay: 150ms; }
.roomtile:nth-child(7) { animation-delay: 180ms; }
.roomtile:nth-child(8) { animation-delay: 210ms; }
.roomtile:nth-child(n + 9) { animation-delay: 240ms; }
@keyframes tileup {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
