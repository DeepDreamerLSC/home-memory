<template name="icon">
  <image class="ui-icon theme-light" src="{{ '/assets/icons/' + name + '.png' }}" mode="aspectFit" />
  <image class="ui-icon theme-dark" src="{{ '/assets/icons/' + name + '-dark.png' }}" mode="aspectFit" />
</template>
<view class="page page-with-voice-bar home-page">
  <view wx:if="{{ firstUse && !queried }}" class="first-use-context"><view class="fam-chip" bindtap="onFamilyTap"><text>{{ familyShared ? '我们家' : '我的家' }}</text><template is="icon" data="{{ name: 'down' }}" /></view></view>
  <view wx:if="{{ backLabel }}" class="backchip" bindtap="onBackTap">‹ {{ backLabel }}</view>
  <view wx:if="{{ !firstUse || queried }}" class="heading-row">
    <view class="mtitle">{{ queried ? '找东西' : mapTitle }}</view>
    <view wx:if="{{ isRootView && !unmountedView }}" class="fam-chip" bindtap="onFamilyTap">
      <view class="fam-dot"></view><text>{{ familyShared ? '我们家' : '我的家' }}</text><template is="icon" data="{{ name: 'down' }}" />
    </view>
    <view wx:elif="{{ !isRootView }}" class="more-inline" bindtap="onContainerMore">⋯</view>
  </view>
  <view wx:if="{{ !firstUse && !queried && !unmountedView && rememberedCount !== null }}" class="home-sub">{{ isRootView ? '已记住' : '这里有' }} {{ rememberedCount }} 件</view>
  <view wx:if="{{ mapRefreshing }}" class="refresh-flag">同步中…</view>
  <view wx:if="{{ resumeSession }}" class="resume-banner" bindtap="onResumeTap">{{ resumeSession.count }} 件待核对 <text>继续 ›</text></view>
  <view wx:if="{{ photoResume }}" class="resume-banner" bindtap="onPhotoResumeTap">{{ photoResume.count }} 件{{ photoResume.mode === 'evidence' ? '照片待关联' : '拍照待核对' }} <text>继续 ›</text></view>
  <view wx:if="{{ mapStale }}" class="stale-banner" bindtap="onRetryTap">当前为上次记录 · 点按重试</view>
  <view wx:if="{{ !firstUse || queried }}" class="searchbar">
    <template is="icon" data="{{ name: 'search' }}" />
    <input class="search-input" placeholder="搜索物品" placeholder-class="placeholder" value="{{ queryText }}" confirm-type="search" bindinput="onQueryInput" bindconfirm="onQueryTap" />
    <view class="search-go-hit" hover-class="btn-press" bindtap="onQueryTap"><view class="search-go">{{ querying ? '…' : '→' }}</view></view>
  </view>

  <block wx:if="{{ queried }}">
    <view wx:if="{{ queryError }}" class="error-text">{{ queryError }}</view>
    <block wx:else>
      <view class="section-label">找到 {{ queryResults.length }} 件</view>
      <view wx:if="{{ queryResults.length === 0 }}" class="empty-note">
        <view class="empty-note-main">还没记过「{{ queryKeyword }}」</view>
        <view class="text-action" bindtap="onTextRecordTap">记一件 ›</view>
      </view>
      <view wx:else class="result-card">
        <view wx:for="{{ queryResults }}" wx:key="item_id" class="result-row" data-index="{{ index }}" bindtap="onResultTap">
          <view class="item-icon">
            <image wx:if="{{ item.evidenceUrl }}" class="item-photo" src="{{ item.evidenceUrl }}" mode="aspectFill" />
            <block wx:else><image class="item-art theme-light" src="{{ item.artwork }}" mode="aspectFit" /><image class="item-art theme-dark" src="{{ item.artworkDark }}" mode="aspectFit" /></block>
          </view>
          <view class="item-main"><view class="item-name">{{ item.name }}<text wx:if="{{ item.videoHint }}" class="video-badge {{ item.videoHint.playable ? '' : 'unavailable' }}" catchtap="onResultVideoTap" data-index="{{ index }}">{{ item.videoHint.badgeText }}</text><text wx:if="{{ item.qtyText }}" class="qty-badge {{ item.quantity === null ? 'unconfirmed' : '' }}">{{ item.qtyText }}</text></view><view class="item-location">{{ item.location_text }}</view></view>
          <template is="icon" data="{{ name: 'chevron' }}" />
        </view>
      </view>
    </block>
    <view class="collapse-link" bindtap="onCollapseResultsTap">收起搜索</view>
  </block>
  <block wx:elif="{{ mapLoading }}"><view class="skel-grid"><view class="skel-tile" wx:for="{{ [0, 1, 2, 3] }}" wx:key="*this"><view class="skel-shimmer"></view></view></view></block>
  <block wx:elif="{{ mapError }}"><view class="fail-view"><view class="fail-title">暂时连不上</view><view class="fail-sub">已保存的记录不受影响</view><view class="text-action" bindtap="onRetryTap">重试 ›</view></view></block>
  <block wx:elif="{{ unmountedView }}">
    <view class="result-card"><view wx:for="{{ unmountedItems }}" wx:key="item_id" class="result-row" data-index="{{ index }}" bindtap="onUnmountedRowTap"><view class="item-icon neutral-icon">{{ item.initial }}</view><view class="item-main"><view class="item-name">{{ item.name }}</view><view class="item-location">{{ item.locationText || '位置待补充' }}</view></view><view class="unverified-tag">位置待核实</view></view></view>
    <view wx:if="{{ unmountedCount > unmountedItems.length }}" class="tiny-center">最近 {{ unmountedItems.length }} 件</view>
  </block>
  <block wx:elif="{{ firstUse }}">
    <view class="empty-home">
      <image class="empty-art theme-light" src="/assets/rooms/living.png" mode="aspectFit" /><image class="empty-art theme-dark" src="/assets/rooms/living-dark.png" mode="aspectFit" />
      <view class="empty-title">先记一件东西</view>
      <view class="empty-sub">告诉我物品和位置，下次帮你找。</view>
      <view class="voice-cta {{ ctaPressed ? 'pressed' : '' }} {{ (transcribing || extracting) ? 'busy' : '' }} {{ voiceState === 'cancelPending' ? 'cancel' : '' }}" catchtouchstart="onTalkTouchStart" catchtouchmove="onTalkTouchMove" catchtouchend="onTalkTouchEnd" catchtouchcancel="onTalkTouchCancel">
        <view class="cta-micdot"><view wx:if="{{ voiceState === 'recording' }}" class="mic-seconds">{{ recordSeconds }}s</view><block wx:else><view class="mic-cap"></view><view class="mic-stand"></view></block></view>
        <view class="cta-label">{{ voiceState === 'cancelPending' ? '松手取消' : extracting ? '整理物品和位置…' : transcribing ? '整理录音…' : voiceState === 'recording' ? '正在听，松手核对' : '语音记录' }}</view>
      </view>
      <view wx:if="{{ partialText }}" class="partial-text">{{ partialText }}</view>
      <view class="text-action" bindtap="onTextRecordTap">文字记录</view>
      <view class="empty-trust">确认后才保存。</view>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{ rooms.length }}" class="section-label">{{ isRootView ? '房间' : '位置' }}</view>
    <view class="roomgrid">
      <view wx:for="{{ rooms }}" wx:key="location_id" class="roomtile" hover-class="roomtile-active" data-index="{{ index }}" bindtap="onRoomTap">
        <view class="room-art"><image class="room-image theme-light" src="{{ item.artwork }}" mode="aspectFit" /><image class="room-image theme-dark" src="{{ item.artworkDark }}" mode="aspectFit" /></view>
        <view class="room-info"><view class="room-copy"><view class="rname">{{ item.name }}</view><view class="rcount">{{ item.countText }}</view></view><template is="icon" data="{{ name: 'chevron' }}" /></view>
      </view>
    </view>
    <view wx:if="{{ isRootView && unmountedCount > 0 }}" class="unmounted-entry" bindtap="onUnmountedTap"><view class="unmounted-symbol">?</view><view class="item-main"><view class="item-name">尚未归类</view><view class="item-location">{{ unmountedCount }} 件待核实</view></view><template is="icon" data="{{ name: 'chevron' }}" /></view>
    <view wx:if="{{ isRootView && dueBanner }}" class="due-banner" bindtap="onDueBannerTap"><template is="icon" data="{{ name: 'clock' }}" /><view class="due-banner-text">{{ dueBanner.text }}</view><template is="icon" data="{{ name: 'chevron' }}" /></view>
    <view wx:if="{{ !isRootView && directItems.length }}" class="section-label direct-label">这里的东西</view>
    <view wx:if="{{ directItems.length }}" class="result-card"><view wx:for="{{ directItems }}" wx:key="item_id" class="result-row" data-index="{{ index }}" bindtap="onDirectItemTap"><view class="item-icon"><image class="item-art theme-light" src="{{ item.artwork }}" mode="aspectFit" /><image class="item-art theme-dark" src="{{ item.artworkDark }}" mode="aspectFit" /></view><view class="item-main"><view class="item-name">{{ item.name }}</view><view class="item-location">{{ item.location_text }}</view></view><template is="icon" data="{{ name: 'chevron' }}" /></view></view>
    <view wx:if="{{ rooms.length === 0 && directItems.length === 0 && !(isRootView && unmountedCount > 0) }}" class="empty-map">这里还没有东西</view>
    <block wx:if="{{ isRootView && recentItems.length }}">
      <view class="section-header"><view class="section-label">最近记住</view><view wx:if="{{ recentItems.length > 2 }}" class="recent-more" bindtap="onRecentMore">{{ recentExpanded ? '收起' : '更多' }}</view></view>
      <view class="result-card"><block wx:for="{{ recentItems }}" wx:key="item_id"><view wx:if="{{ recentExpanded || index < 2 }}" class="result-row" data-index="{{ index }}" bindtap="onRecentTap"><view class="item-icon"><image class="item-art theme-light" src="{{ item.artwork }}" mode="aspectFit" /><image class="item-art theme-dark" src="{{ item.artworkDark }}" mode="aspectFit" /></view><view class="item-main"><view class="item-name">{{ item.name }}<text wx:if="{{ item.qtyText }}" class="qty-badge {{ item.quantity === null ? 'unconfirmed' : '' }}">{{ item.qtyText }}</text></view><view class="item-location">{{ item.location_text }}</view></view><view class="item-date" aria-label="记录更新于 {{ item.updated_at_short }}">{{ item.updated_at_short }}</view></view></block></view>
    </block>
    <view wx:if="{{ isRootView && recentError }}" class="recent-retry" bindtap="loadRecent">最近记录加载失败 · 重试</view>
  </block>
  <view wx:if="{{ isRootView && !firstUse && !unmountedView && !queried }}" class="manage-link" bindtap="onLocationsTap">管理位置 ›</view>
</view>
<view class="sheet-mask {{ famSheetVisible ? 'open' : '' }}" bindtap="onFamSheetClose"><view class="sheet" catchtap="noop"><view class="sheet-title">切换家庭</view><view wx:for="{{ famSheetOptions }}" wx:key="key" class="sheet-act {{ switchingFamily ? 'disabled' : '' }}" data-key="{{ item.key }}" bindtap="onFamSheetPick"><view class="sheet-act-name">{{ item.current ? '✓ ' : '' }}{{ item.title }}</view><view class="sheet-act-sub">{{ item.sub }}</view></view><view class="sheet-close" bindtap="onFamSheetCloseTap">{{ switchingFamily ? '切换中…' : '取消' }}</view></view></view>
<voice-bar id="global-voice-bar" wx:if="{{ !firstUse || queried }}" />
