<view class="page">
  <!-- 品牌头部 -->
  <view class="brand">
    <view class="brand-main">
      <view class="brand-name">我靠东西呢</view>
      <view class="brand-sub">东西放哪儿了?我记得。</view>
    </view>
    <!-- 共享家庭:点头像直接设置(微信头像昵称填写能力);个人家庭:提示 -->
    <button
      wx:if="{{ familyShared }}"
      class="home-avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onHomeAvatarChosen"
    >
      <image
        wx:if="{{ selfAvatar }}"
        class="home-avatar"
        src="{{ selfAvatar }}"
        mode="aspectFill"
      />
      <view wx:else class="home-avatar home-avatar-empty">{{ selfNick ? selfNick[0] : '我' }}</view>
    </button>
    <view
      wx:else
      class="home-avatar-btn"
      bindtap="onHomeAvatarPersonalTap"
    >
      <view class="home-avatar home-avatar-empty">我</view>
    </view>
  </view>

  <!-- 未完成草稿恢复(中途退出/进程回收;原幂等键续存) -->
  <view wx:if="{{ resumeSession }}" class="resume-banner" bindtap="onResumeTap">
    上次有 {{ resumeSession.count }} 件没记完,继续核对 ›
  </view>

  <!-- 找东西:紧跟品牌,打开就能找 -->
  <view class="search-wrap">
    <view class="section-title">找东西</view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="搜钥匙、证件、充电宝…"
        placeholder-class="placeholder"
        value="{{ queryText }}"
        confirm-type="search"
        bindinput="onQueryInput"
        bindconfirm="onQueryTap"
      />
      <view class="search-go-hit" bindtap="onQueryTap">
        <view class="search-go {{ querying ? 'busy' : '' }}">
          {{ querying ? '…' : '找' }}
        </view>
      </view>
    </view>

    <view wx:if="{{ queryError }}" class="error-text">{{ queryError }}</view>

    <block wx:if="{{ queried && !queryError }}">
      <view wx:if="{{ queryResults.length === 0 }}" class="empty-text">
        糟了,这个叫法我还真没对上。试试别的叫法,比如全名或俗称。
      </view>
      <view
        wx:for="{{ queryResults }}"
        wx:key="item_id"
        class="item-row"
        data-index="{{ index }}"
        bindtap="onResultTap"
      >
        <view class="item-icon">{{ item.name[0] }}</view>
        <view class="item-main">
          <view class="item-name">{{ item.name }}</view>
          <view class="item-location">上次记录:{{ item.location_text }}</view>
        </view>
        <view class="chevron">›</view>
      </view>
    </block>
  </view>

  <!-- 顺手记一件:一屏唯一主视觉,按住就能记 -->
  <view class="card">
    <view class="card-title">顺手记一件</view>

    <!-- 语音模式:按住说话 -->
    <block wx:if="{{ inputMode === 'voice' }}">
      <view class="example">比如说:"充电宝放在书房抽屉里"</view>
      <view
        class="talk-btn {{ (voiceState === 'recording' || transcribing || extracting) && voiceState !== 'cancelPending' ? 'busy' : '' }} {{ voiceState === 'cancelPending' ? 'cancel' : '' }}"
        catchtouchstart="onTalkTouchStart"
        catchtouchmove="onTalkTouchMove"
        catchtouchend="onTalkTouchEnd"
        catchtouchcancel="onTalkTouchCancel"
      >
        <view class="mic-icon">
          <block wx:if="{{ voiceState === 'recording' }}">
            <view class="mic-seconds">{{ recordSeconds }}s</view>
          </block>
          <block wx:else>
            <view class="mic-cap"></view>
            <view class="mic-stand"></view>
            <view class="mic-base"></view>
          </block>
        </view>
        <view class="talk-label">
          {{ voiceState === 'cancelPending' ? '好,当我没听见。' : extracting ? '核对物品和位置…' : transcribing ? '整理你刚说的话…' : voiceState === 'recording' ? '说吧,我记着呢。' : '按住说话,松开识别' }}
        </view>
      </view>
      <view wx:if="{{ partialText }}" class="partial-text">{{ partialText }}</view>
      <view class="mode-link" bindtap="{{ inputMode === 'voice' ? 'onModeText' : 'onModeVoice' }}">
        {{ inputMode === 'voice' ? '改用文字录入' : '改用语音' }}
      </view>
    </block>

    <!-- 文字模式:次级入口,保留用户输入 -->
    <block wx:else>
      <view class="hint">用一句话说出物品和位置,AI 帮你整理成草稿</view>
      <textarea
        class="memo-input"
        placeholder="例如:降压药放在厨房第二个抽屉"
        placeholder-class="placeholder"
        value="{{ memoText }}"
        maxlength="500"
        auto-height
        bindinput="onMemoInput"
      />
      <view class="char-count">{{ memoText.length }}/500</view>
      <button
        class="btn primary block"
        loading="{{ extracting }}"
        bindtap="onExtractTap"
      >
        提取并确认
      </button>
      <view class="mode-link" bindtap="{{ inputMode === 'voice' ? 'onModeText' : 'onModeVoice' }}">
        {{ inputMode === 'voice' ? '改用文字录入' : '改用语音' }}
      </view>
    </block>
  </view>

  <!-- 我的家:按空间浏览(次级入口,不抢语音主视觉) -->
  <view class="card">
    <view class="card-title">我的家</view>
    <view class="item-row" bindtap="onHomeTreeTap">
      <view class="item-icon">家</view>
      <view class="item-main">
        <view class="item-name">按空间浏览</view>
        <view class="item-location">房间 → 家具 → 抽屉,东西在哪儿一目了然</view>
      </view>
      <view class="chevron">›</view>
    </view>
    <view class="item-row" bindtap="onFamilyTap">
      <view class="item-icon">庭</view>
      <view class="item-main">
        <view class="item-name">家庭</view>
        <view class="item-location">创建共享家庭、邀请家人、退出或解散</view>
      </view>
      <view class="chevron">›</view>
    </view>
  </view>

  <!-- 最近记住的:紧凑,可点击 -->
  <view class="card">
    <view class="card-title">最近记住的</view>
    <view wx:if="{{ recentError }}" class="error-text">{{ recentError }}</view>
    <view wx:elif="{{ recentLoading }}" class="empty-text">加载中…</view>
    <view wx:elif="{{ recentItems.length === 0 }}" class="empty-text">
      还没记过东西。按住上面的按钮,说一句就行。
    </view>
    <view
      wx:for="{{ recentItems }}"
      wx:key="item_id"
      class="item-row"
      data-index="{{ index }}"
      bindtap="onRecentTap"
    >
      <view class="item-icon">{{ item.name[0] }}</view>
      <view class="item-main">
        <view class="item-name">{{ item.name }}</view>
        <view class="item-location">上次记录:{{ item.location_text }}</view>
      </view>
      <view class="chevron">›</view>
    </view>
  </view>
</view>

<!-- 设置昵称弹窗(与头像一起保存;取消则丢弃本次头像) -->
<view wx:if="{{ nickModalOpen }}" class="nick-mask" bindtap="onNickModalCancel">
  <view class="nick-card" catchtap="">
    <view class="nick-title">我的昵称</view>
    <view class="nick-hint">家人怎么称呼你(仅这个家庭的家人可见)</view>
    <input
      class="nick-input"
      type="nickname"
      value="{{ nickDraft }}"
      placeholder="如:老爸、小林"
      maxlength="20"
      focus="{{ nickModalOpen }}"
      bindinput="onNickDraftInput"
    />
    <view wx:if="{{ profileSaving }}" class="nick-hint">保存中…</view>
    <view class="nick-actions">
      <view class="nick-btn" bindtap="onNickModalCancel">取消</view>
      <view class="nick-btn primary" bindtap="onNickModalSave">保存</view>
    </view>
  </view>
</view>
