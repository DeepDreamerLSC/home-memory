<view class="page">
  <!-- 品牌头部 -->
  <view class="brand">
    <view class="brand-name">我靠东西呢</view>
    <view class="brand-sub">东西放哪儿了?我记得。</view>
  </view>

  <!-- 搜索:紧跟品牌,打开就能找 -->
  <view class="search-wrap">
    <view class="search-row">
      <input
        class="search-input"
        placeholder="搜钥匙、证件、充电宝…"
        placeholder-class="placeholder"
        value="{{ queryText }}"
        confirm-type="search"
        bindinput="onQueryInput"
        bindconfirm="onQueryTap"
      />
      <view class="search-go {{ querying ? 'busy' : '' }}" bindtap="onQueryTap">
        {{ querying ? '…' : '找' }}
      </view>
    </view>

    <view wx:if="{{ queryError }}" class="error-text">{{ queryError }}</view>

    <block wx:if="{{ queried && !queryError }}">
      <view wx:if="{{ queryResults.length === 0 }}" class="empty-text">
        糟了,这件我还真没记住。要记一件?往下按住说话。
      </view>
      <view
        wx:for="{{ queryResults }}"
        wx:key="item_id"
        class="item-row"
        data-index="{{ index }}"
        bindtap="onResultTap"
      >
        <view class="item-name">{{ item.name }}</view>
        <view class="item-location">上次记录:{{ item.location_text }}</view>
      </view>
    </block>
  </view>

  <!-- 顺手记一件:一屏唯一主视觉,按住就能记 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">顺手记一件</view>
      <view class="mode-link" bindtap="{{ inputMode === 'voice' ? 'onModeText' : 'onModeVoice' }}">
        {{ inputMode === 'voice' ? '改用文字录入' : '改用语音' }}
      </view>
    </view>

    <!-- 语音模式:按住说话 -->
    <block wx:if="{{ inputMode === 'voice' }}">
      <view class="voice-state">
        {{ voiceState === 'cancelPending' ? '松手取消本次' : extracting ? '核对物品和位置…' : transcribing ? '整理你刚说的话…' : voiceState === 'recording' ? '说吧,我记着呢。' : '' }}
      </view>
      <view
        class="talk-btn {{ (voiceState === 'recording' || transcribing || extracting) && voiceState !== 'cancelPending' ? 'busy' : '' }} {{ voiceState === 'cancelPending' ? 'cancel' : '' }}"
        catchtouchstart="onTalkTouchStart"
        catchtouchmove="onTalkTouchMove"
        catchtouchend="onTalkTouchEnd"
        catchtouchcancel="onTalkTouchCancel"
      >
        <view class="talk-icon">{{ voiceState === 'cancelPending' ? '好,当我没听见。' : voiceState === 'recording' ? '录音中 ' + recordSeconds + 's' : '🎤' }}</view>
        <view class="talk-label">按住说话,松开记住</view>
      </view>
      <view wx:if="{{ partialText }}" class="partial-text">{{ partialText }}</view>
      <view class="example">比如说:"充电宝放在书房抽屉里"</view>
    </block>

    <!-- 文字模式:次级入口,保留用户输入 -->
    <block wx:else>
      <view class="hint">用一句话说出物品和位置,AI 帮你整理成草稿</view>
      <textarea
        class="memo-input"
        placeholder="例如:降压药放在厨房第二个抽屉"
        placeholder-class="placeholder"
        value="{{ memoText }}"
        maxlength="500"
        auto-height
        bindinput="onMemoInput"
      />
      <view class="char-count">{{ memoText.length }}/500</view>
      <button
        class="btn primary block"
        loading="{{ extracting }}"
        bindtap="onExtractTap"
      >
        提取并确认
      </button>
    </block>
  </view>

  <!-- 最近记住的:紧凑,可点击 -->
  <view class="card">
    <view class="card-title">最近记住的</view>
    <view wx:if="{{ recentError }}" class="error-text">{{ recentError }}</view>
    <view wx:elif="{{ recentLoading }}" class="empty-text">加载中…</view>
    <view wx:elif="{{ recentItems.length === 0 }}" class="empty-text">
      还没记过东西。按住上面的按钮,说一句就行。
    </view>
    <view
      wx:for="{{ recentItems }}"
      wx:key="item_id"
      class="item-row"
      data-index="{{ index }}"
      bindtap="onRecentTap"
    >
      <view class="item-name">{{ item.name }}</view>
      <view class="item-location">上次记录:{{ item.location_text }}</view>
      <view class="item-time">{{ item.updated_at_text }}</view>
    </view>
  </view>
</view>
