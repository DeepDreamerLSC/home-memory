/* 全局样式:品牌「我靠东西呢」——奶油白/明黄/墨黑,跟随系统深浅色 */
page {
  /* 浅色(默认):奶油白底 + 白卡 + 墨字 */
  --bg: #faf8f2;
  --card: #ffffff;
  --card-inset: #f1ede0;
  --text: #191919;
  --text-2: #4c483e;
  --text-3: #a39d8d;
  --line: #e8e3d6;
  --placeholder: #b8b2a4;
  --accent: #ffe15a;
  --accent-shadow: #e5c431;
  --accent-dim: #f3edd9;
  --go-bg: #191919;
  --go-fg: #ffe15a;
  --danger: #d93025;
  --danger-bg: #fdecec;
  --danger-shadow: #ecc2c0;
  --banner-bg: #fff3bf;
  --banner-line: #ffe15a;
  --banner-manual-bg: #f4f1e6;
  --banner-manual-fg: #4c483e;
  /* 语音条专属(九轮冻结:奶油条 + 米黄油胶囊 + 圆点挖窗) */
  --vb-bg: #fffdf4;
  --vb-fg: #191919;
  --vb-line: #e8e3d6;
  --vb-hold-bg: #f3edd9;
  --vb-hold-fg: #191919;
  --vb-mic-bg: #fffdf4;
  --vb-mic-fg: #f3edd9;
  --vb-btn-bg: transparent;
  --vb-btn-fg: #4c483e;
  --vb-btn-line: #ddd6c2;
  --vb-cta-shadow: #ece6d6;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  .qualifiers.warn {
    color: #e8a33d;
  }

  page {
    /* 深色:近黑底 + 深灰卡 + 亮字,明黄仍是唯一强调面 */
    --bg: #111111;
    --card: #1e1e1e;
    --card-inset: #161616;
    --text: #f5f4f0;
    --text-2: #a8a69e;
    --text-3: #8a8880;
    --line: #2e2e2e;
    --placeholder: #82807a;
    --accent: #f7d64b;
    --accent-shadow: #8f7a1e;
    --accent-dim: #3a3627;
    --go-bg: #f5f4f0;
    --go-fg: #111111;
    --danger: #ff6b6b;
    --danger-bg: #3a2222;
    --danger-shadow: #57302e;
    --banner-bg: rgba(247, 214, 75, 0.14);
    --banner-line: #6b5b10;
    --banner-manual-bg: #262626;
    --banner-manual-fg: #a8a69e;
    /* 语音条专属(十轮:深色去黄,黑灰组合,麦克风单色) */
    --vb-bg: #1e1e1e;
    --vb-fg: #f5f4f0;
    --vb-line: #2e2e2e;
    --vb-hold-bg: #2e2e2e;
    --vb-hold-fg: #f5f4f0;
    --vb-mic-bg: #1e1e1e;
    --vb-mic-fg: #a8a69e;
    --vb-btn-bg: transparent;
    --vb-btn-fg: #a8a69e;
    --vb-btn-line: #3a3a3a;
    --vb-cta-shadow: rgba(0, 0, 0, 0.45);
  }
}

.page {
  padding-bottom: 48rpx;
}

/* 挂常驻语音条的页面:内容底部让出固定语音条高度(含底部安全区),不遮最后一条
   (语音条压扁后整条 112rpx + 20rpx 间隙,#36 真机反馈 Fix 1) */
.page-with-voice-bar {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

/* 卡片:原型 .card(radius 18px、padding 15px 14px、内容边距 18px,无投影) */
.card {
  background: var(--card);
  border-radius: 36rpx;
  padding: 30rpx 28rpx;
  margin: 24rpx 36rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.placeholder {
  color: var(--placeholder);
}

/* 输入控件:原型 .field input(白卡底 + 描边圆角,内嵌槽感来自描边而非深底) */
.memo-input {
  width: 100%;
  min-height: 140rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: var(--text);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin: 8rpx 0 16rpx;
}

.input {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  color: var(--text);
  min-height: 92rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 176rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: var(--text);
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-btn {
  width: 110rpx;
  margin-left: 16rpx;
}

/* ============ 按钮(#36 0.6.0 真机反馈 Fix 1:文字垂直居中 + 整体压扁 1/4) ============
 * 根因(按钮内字体偏上):按钮文本沿用 line-height 1.2/1.6 时,CJK 字形贴着
 * 基线排布,行盒的下半是拉丁字母降部留白——中文在行盒内视觉重心整体偏上,
 * 按钮越高偏得越明显。统一修法:垂直居中一律 flex align-items:center +
 * line-height:1(行盒=字面框,会换行的长标签用 ≤1.2 的等效基线补偿)。
 * 扁平:视觉高度整体 ×0.75,视觉收进内层 .btn-face(颜色/圆角都在这层);
 * 按钮本体是透明热区层(上下 padding 透明延伸),触摸热区一律 ≥88rpx(44px)
 * ——先例:首页 search-go-hit(视觉/热区分层)。深浅主题同改(面颜色全走主题变量)。 */
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

button.btn::after {
  border: none;
}

/* 视觉面:面 76(原 100 × 0.75)+ 透明上下 6 = 热区 88rpx */
button.btn .btn-face {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--card-inset);
  color: var(--text);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

button.btn.primary .btn-face {
  background: var(--go-bg);
  color: var(--go-fg);
  border: none;
}

button.btn.primary[disabled] {
  background: transparent;
  color: inherit;
  opacity: 1;
}

button.btn.primary[disabled] .btn-face {
  background: var(--go-bg);
  color: var(--go-fg);
  opacity: 0.38;
}

button.btn.danger .btn-face {
  background: var(--danger-bg);
  color: var(--danger);
  border: 3rpx solid var(--danger);
}

button.btn.block {
  display: flex;
  width: 100%;
  margin-top: 24rpx;
}

/* 墨底黄字大按钮(view 与 button 共用):热区 88 = 面 66(原 88 × 0.75)+ 透明上下 11 */
.btn.ink {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.btn.ink .btn-face {
  width: 100%;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.btn.ink.block {
  display: flex;
  width: 100%;
}

/* 「用完了」次级小按钮(item/reminders 共用):热区 88 = 面 66 + 透明上下 11 */
.r-done {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.r-done .r-done-face {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 20rpx;
  line-height: 1;
}

.r-done.busy {
  opacity: 0.5;
}

/* 「⋯」方块入口(index 容器抬头/item 详情头共用):热区 88 = 面 66 + 透明上下 11 */
.more-inline {
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.more-inline .more-inline-face {
  min-height: 66rpx;
  min-width: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

/* 列表条目:紧凑 */
.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.item-row:last-child {
  border-bottom: none;
}

/* 条目图标块:原型 .ico(随按钮同比例压扁,42px→32px 方块) */
.item-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--go-bg);
  border-radius: 20rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.item-location {
  font-size: 23rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.chevron {
  margin-left: 12rpx;
  color: var(--text-3);
  font-size: 48rpx;
  font-weight: 300;
  flex-shrink: 0;
}

.empty-text {
  text-align: center;
  color: var(--text-3);
  padding: 32rpx 0;
  font-size: 26rpx;
}

.error-text {
  color: var(--danger);
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 确认页 / 详情页表单:AI 草稿 = 黄底横幅(与已确认事实视觉分离) */
.banner {
  margin: 24rpx 36rpx;
  padding: 20rpx 24rpx;
  background: var(--banner-bg);
  color: var(--text);
  border: 2rpx solid var(--banner-line);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.banner.manual {
  background: var(--banner-manual-bg);
  color: var(--banner-manual-fg);
  border-color: var(--line);
  font-weight: 400;
}

.qualifiers {
  margin: 12rpx 36rpx 0;
  font-size: 24rpx;
  color: var(--text-2);
}

.qualifiers.warn {
  color: #b45309;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}
