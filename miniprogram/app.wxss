/* 全局样式:简洁卡片式布局,全中文文案配合 */
page {
  background: #f4f5f7;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding-bottom: 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #8a919f;
  margin-bottom: 12rpx;
}

.placeholder {
  color: #b9c0cc;
}

/* 输入控件 */
.memo-input {
  width: 100%;
  min-height: 140rpx;
  background: #f4f5f7;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #b9c0cc;
  margin: 8rpx 0 16rpx;
}

.input {
  background: #f4f5f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f4f5f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: #f4f5f7;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 170rpx;
  margin-left: 16rpx;
}

/* 按钮 */
button.btn {
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 2.4;
  padding-left: 0;
  padding-right: 0;
}

button.btn::after {
  border: none;
}

button.btn.primary {
  background: #3f6ff2;
  color: #ffffff;
}

button.btn.danger {
  background: #fdecec;
  color: #d93025;
}

button.btn.block {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

/* 列表条目 */
.item-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.item-row:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
}

.item-location {
  font-size: 26rpx;
  color: #4b5563;
  margin-top: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #9aa3af;
  margin-top: 4rpx;
}

.empty-text {
  text-align: center;
  color: #9aa3af;
  padding: 32rpx 0;
  font-size: 26rpx;
}

.error-text {
  color: #d93025;
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 确认页 / 详情页表单 */
.banner {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: #e8efff;
  color: #2b5fd9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.banner.manual {
  background: #eef1f5;
  color: #4b5563;
}

.qualifiers {
  margin: 12rpx 24rpx 0;
  font-size: 24rpx;
  color: #6b7280;
}

.qualifiers.warn {
  color: #b45309;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #9aa3af;
  margin-bottom: 20rpx;
}
