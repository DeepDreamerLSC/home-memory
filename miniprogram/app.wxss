/* 全局样式:品牌「我靠东西呢」——奶油白/明黄/墨黑,跟随系统深浅色 */
page {
  /* 浅色(默认):奶油白底 + 白卡 + 墨字 */
  --bg: #faf8f2;
  --card: #ffffff;
  --card-inset: #f1ede0;
  --text: #191919;
  --text-2: #4c483e;
  --text-3: #a39d8d;
  --line: #e8e3d6;
  --placeholder: #b8b2a4;
  --accent: #ffe15a;
  --accent-shadow: #e5c431;
  --accent-dim: #f3edd9;
  --go-bg: #191919;
  --go-fg: #ffe15a;
  --danger: #d93025;
  --danger-bg: #fdecec;
  --danger-shadow: #ecc2c0;
  --banner-bg: #fff3bf;
  --banner-line: #ffe15a;
  --banner-manual-bg: #f4f1e6;
  --banner-manual-fg: #4c483e;
  /* 语音条专属(九轮冻结:奶油条 + 米黄油胶囊 + 圆点挖窗) */
  --vb-bg: #fffdf4;
  --vb-fg: #191919;
  --vb-line: #e8e3d6;
  --vb-hold-bg: #f3edd9;
  --vb-hold-fg: #191919;
  --vb-mic-bg: #fffdf4;
  --vb-mic-fg: #f3edd9;
  --vb-btn-bg: transparent;
  --vb-btn-fg: #4c483e;
  --vb-btn-line: #ddd6c2;
  --vb-cta-shadow: #ece6d6;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  .qualifiers.warn {
    color: #e8a33d;
  }

  page {
    /* 深色:近黑底 + 深灰卡 + 亮字,明黄仍是唯一强调面 */
    --bg: #111111;
    --card: #1e1e1e;
    --card-inset: #161616;
    --text: #f5f4f0;
    --text-2: #a8a69e;
    --text-3: #8a8880;
    --line: #2e2e2e;
    --placeholder: #82807a;
    --accent: #f7d64b;
    --accent-shadow: #8f7a1e;
    --accent-dim: #3a3627;
    --go-bg: #f5f4f0;
    --go-fg: #111111;
    --danger: #ff6b6b;
    --danger-bg: #3a2222;
    --danger-shadow: #57302e;
    --banner-bg: rgba(247, 214, 75, 0.14);
    --banner-line: #6b5b10;
    --banner-manual-bg: #262626;
    --banner-manual-fg: #a8a69e;
    /* 语音条专属(十轮:深色去黄,黑灰组合,麦克风单色) */
    --vb-bg: #1e1e1e;
    --vb-fg: #f5f4f0;
    --vb-line: #2e2e2e;
    --vb-hold-bg: #2e2e2e;
    --vb-hold-fg: #f5f4f0;
    --vb-mic-bg: #1e1e1e;
    --vb-mic-fg: #a8a69e;
    --vb-btn-bg: transparent;
    --vb-btn-fg: #a8a69e;
    --vb-btn-line: #3a3a3a;
    --vb-cta-shadow: rgba(0, 0, 0, 0.45);
  }
}

.page {
  padding-bottom: 48rpx;
}

/* 挂常驻语音条的页面:内容底部让出固定语音条高度(含底部安全区),不遮最后一条 */
.page-with-voice-bar {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.placeholder {
  color: var(--placeholder);
}

/* 输入控件:内嵌深槽 */
.memo-input {
  width: 100%;
  min-height: 140rpx;
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin: 8rpx 0 16rpx;
}

.input {
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text);
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-btn {
  width: 110rpx;
  margin-left: 16rpx;
}

/* 按钮:明黄主操作(一屏一个强调面) */
button.btn {
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 2.4;
  font-weight: 600;
  padding-left: 0;
  padding-right: 0;
}

button.btn::after {
  border: none;
}

button.btn.primary {
  background: var(--accent);
  color: #191919;
}

button.btn.primary[disabled] {
  background: var(--accent-dim);
  color: var(--placeholder);
}

button.btn.danger {
  background: var(--danger-bg);
  color: var(--danger);
}

button.btn.block {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

/* 列表条目:紧凑 */
.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.item-row:last-child {
  border-bottom: none;
}

/* 条目图标块:黑底白字首字(两主题通用,参考图的几何块) */
.item-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  border-radius: 18rpx;
  color: #f5f4f0;
  font-size: 30rpx;
  font-weight: 600;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.item-location {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}

.chevron {
  margin-left: 12rpx;
  color: var(--text-3);
  font-size: 32rpx;
  flex-shrink: 0;
}

.empty-text {
  text-align: center;
  color: var(--text-3);
  padding: 32rpx 0;
  font-size: 26rpx;
}

.error-text {
  color: var(--danger);
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 确认页 / 详情页表单:AI 草稿 = 黄底横幅(与已确认事实视觉分离) */
.banner {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--banner-bg);
  color: var(--text);
  border: 2rpx solid var(--banner-line);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.banner.manual {
  background: var(--banner-manual-bg);
  color: var(--banner-manual-fg);
  border-color: var(--line);
  font-weight: 400;
}

.qualifiers {
  margin: 12rpx 24rpx 0;
  font-size: 24rpx;
  color: var(--text-2);
}

.qualifiers.warn {
  color: #b45309;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}
