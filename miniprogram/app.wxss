/* 全局样式:品牌「我靠东西呢」——奶油白 #FAF8F2 / 明黄 #FFE15A / 墨黑 #191919 */
page {
  background: #faf8f2;
  color: #191919;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding-bottom: 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(25, 25, 25, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #191919;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #8a8577;
  margin-bottom: 12rpx;
}

.placeholder {
  color: #b8b2a4;
}

/* 输入控件:白底墨字,细边 */
.memo-input {
  width: 100%;
  min-height: 140rpx;
  background: #faf8f2;
  border: 2rpx solid #e8e3d6;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #b8b2a4;
  margin: 8rpx 0 16rpx;
}

.input {
  background: #faf8f2;
  border: 2rpx solid #e8e3d6;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #faf8f2;
  border: 2rpx solid #e8e3d6;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: #faf8f2;
  border: 2rpx solid #e8e3d6;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 110rpx;
  margin-left: 16rpx;
}

/* 按钮:明黄主操作(一屏一个强调面) */
button.btn {
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 2.4;
  font-weight: 600;
  padding-left: 0;
  padding-right: 0;
}

button.btn::after {
  border: none;
}

button.btn.primary {
  background: #ffe15a;
  color: #191919;
}

button.btn.primary[disabled] {
  background: #f3edd9;
  color: #b8b2a4;
}

button.btn.danger {
  background: #fdecec;
  color: #d93025;
}

button.btn.block {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

/* 列表条目:紧凑 */
.item-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0ede4;
}

.item-row:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
}

.item-location {
  font-size: 26rpx;
  color: #4c483e;
  margin-top: 2rpx;
}

.item-time {
  font-size: 22rpx;
  color: #a39d8d;
  margin-top: 2rpx;
}

.empty-text {
  text-align: center;
  color: #a39d8d;
  padding: 32rpx 0;
  font-size: 26rpx;
}

.error-text {
  color: #d93025;
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 确认页 / 详情页表单:AI 草稿 = 黄底横幅(与已确认事实视觉分离) */
.banner {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff3bf;
  color: #191919;
  border: 2rpx solid #ffe15a;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.banner.manual {
  background: #f4f1e6;
  color: #4c483e;
  border-color: #e8e3d6;
  font-weight: 400;
}

.qualifiers {
  margin: 12rpx 24rpx 0;
  font-size: 24rpx;
  color: #6b6659;
}

.qualifiers.warn {
  color: #b45309;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #4c483e;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #a39d8d;
  margin-bottom: 20rpx;
}
