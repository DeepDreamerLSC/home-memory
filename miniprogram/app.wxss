/* 已确认的 UI 原型: docs/design/ui-polish-v1/index.html。rpx = 375px 画布的 2 倍。 */
page {
  --bg: #f8f7f2;
  --card: #fffefa;
  --card-inset: #eeeee5;
  --room-bg: #efeee4;
  --text: #292d25;
  --text-2: #666d5e;
  --text-3: #6d7363;
  --line: #e7e8de;
  --placeholder: #6d7363;
  --accent: #efd36e;
  --accent-shadow: #d1b95e;
  --accent-dim: #eeeee5;
  --go-bg: #30372c;
  --go-fg: #fcfaf1;
  --danger: #ad4238;
  --danger-bg: #faeeea;
  --danger-shadow: #e8cbc5;
  --banner-bg: #f4eedb;
  --banner-line: #e6dbb9;
  --banner-manual-bg: #eeeee5;
  --banner-manual-fg: #666d5e;
  --vb-bg: #f8f7f2;
  --vb-fg: #292d25;
  --vb-line: #e7e8de;
  --vb-hold-bg: #30372c;
  --vb-hold-fg: #fcfaf1;
  --vb-mic-bg: #efd36e;
  --vb-mic-fg: #30372c;
  --vb-btn-bg: #fffefa;
  --vb-btn-fg: #292d25;
  --vb-btn-line: #e7e8de;
  --vb-cta-shadow: transparent;
  --radius-card: 34rpx;
  --radius-input: 24rpx;
  --radius-button: 28rpx;
  --page-inset: 44rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
image.theme-dark { display: none; }
@media (prefers-color-scheme: dark) {
  page {
    --bg: #20241f;
    --card: #2b3028;
    --card-inset: #32392e;
    --room-bg: #30362d;
    --text: #efeee4;
    --text-2: #b5baa8;
    --text-3: #929a85;
    --line: #3d4436;
    --placeholder: #929a85;
    --accent: #e8ce78;
    --accent-shadow: #b29b65;
    --accent-dim: #32392e;
    --go-bg: #e8ce78;
    --go-fg: #262c22;
    --danger: #f3a89a;
    --danger-bg: #3b2925;
    --danger-shadow: #69473e;
    --banner-bg: #3a392b;
    --banner-line: #57553b;
    --banner-manual-bg: #32392e;
    --banner-manual-fg: #b5baa8;
    --vb-bg: #20241f;
    --vb-fg: #efeee4;
    --vb-line: #3d4436;
    --vb-hold-bg: #e8ce78;
    --vb-hold-fg: #262c22;
    --vb-mic-bg: #e8ce78;
    --vb-mic-fg: #30372c;
    --vb-btn-bg: #2b3028;
    --vb-btn-fg: #efeee4;
    --vb-btn-line: #3d4436;
    --vb-cta-shadow: transparent;
  }
  image.theme-light { display: none; }
  image.theme-dark { display: block; }
  .qualifiers.warn { color: #e8ce78; }
}

.page {
  padding-bottom: 48rpx;
}

/* 挂常驻语音条的页面:内容底部让出固定语音条高度(含底部安全区),不遮最后一条
   (语音条压扁后整条 112rpx + 20rpx 间隙,#36 真机反馈 Fix 1) */
.page-with-voice-bar {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 卡片:原型 .card(radius 18px、padding 15px 14px、内容边距 18px,无投影) */
.card {
  background: var(--card);
  border-radius: 36rpx;
  padding: 30rpx 28rpx;
  margin: 24rpx 36rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.placeholder {
  color: var(--placeholder);
}

/* 输入控件:原型 .field input(白卡底 + 描边圆角,内嵌槽感来自描边而非深底) */
.memo-input {
  width: 100%;
  min-height: 140rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: var(--text);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin: 8rpx 0 16rpx;
}

.input {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  color: var(--text);
  min-height: 92rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 176rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: var(--text);
}

.search-row {
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: var(--card-inset);
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-btn {
  width: 110rpx;
  margin-left: 16rpx;
}

/* ============ 按钮(#36 0.6.0 真机反馈 Fix 1:文字垂直居中 + 整体压扁 1/4) ============
 * 根因(按钮内字体偏上):按钮文本沿用 line-height 1.2/1.6 时,CJK 字形贴着
 * 基线排布,行盒的下半是拉丁字母降部留白——中文在行盒内视觉重心整体偏上,
 * 按钮越高偏得越明显。统一修法:垂直居中一律 flex align-items:center +
 * line-height:1(行盒=字面框,会换行的长标签用 ≤1.2 的等效基线补偿)。
 * 扁平:视觉高度整体 ×0.75,视觉收进内层 .btn-face(颜色/圆角都在这层);
 * 按钮本体是透明热区层(上下 padding 透明延伸),触摸热区一律 ≥88rpx(44px)
 * ——先例:首页 search-go-hit(视觉/热区分层)。深浅主题同改(面颜色全走主题变量)。 */
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

button.btn::after {
  border: none;
}

/* 视觉面:面 76(原 100 × 0.75)+ 透明上下 6 = 热区 88rpx */
button.btn .btn-face {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--card-inset);
  color: var(--text);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

button.btn.primary .btn-face {
  background: var(--go-bg);
  color: var(--go-fg);
  border: none;
}

button.btn.primary[disabled] {
  background: transparent;
  color: inherit;
  opacity: 1;
}

button.btn.primary[disabled] .btn-face {
  background: var(--go-bg);
  color: var(--go-fg);
  opacity: 0.38;
}

button.btn.danger .btn-face {
  background: var(--danger-bg);
  color: var(--danger);
  border: 3rpx solid var(--danger);
}

button.btn.block {
  display: flex;
  width: 100%;
  margin-top: 24rpx;
}

/* 墨底黄字大按钮(view 与 button 共用):热区 88 = 面 66(原 88 × 0.75)+ 透明上下 11 */
.btn.ink {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.btn.ink .btn-face {
  width: 100%;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--go-bg);
  color: var(--go-fg);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.btn.ink.block {
  display: flex;
  width: 100%;
}

/* 「已处理」次级小按钮(item/reminders 共用;0.7.0 前「用完了」):热区 88 = 面 66 + 透明上下 11 */
.r-done {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.r-done .r-done-face {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 20rpx;
  line-height: 1;
}

.r-done.busy {
  opacity: 0.5;
}

/* 「⋯」方块入口(index 容器抬头/item 详情头共用):热区 88 = 面 66 + 透明上下 11 */
.more-inline {
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 11rpx 0;
  box-sizing: border-box;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.more-inline .more-inline-face {
  min-height: 66rpx;
  min-width: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text-2);
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

/* 列表条目:紧凑 */
.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.item-row:last-child {
  border-bottom: none;
}

/* 条目图标块:原型 .ico(随按钮同比例压扁,42px→32px 方块) */
.item-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--go-bg);
  border-radius: 20rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.item-location {
  font-size: 23rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.chevron {
  margin-left: 12rpx;
  color: var(--text-3);
  font-size: 48rpx;
  font-weight: 300;
  flex-shrink: 0;
}

.empty-text {
  text-align: center;
  color: var(--text-3);
  padding: 32rpx 0;
  font-size: 26rpx;
}

.error-text {
  color: var(--danger);
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 确认页 / 详情页表单:AI 草稿 = 黄底横幅(与已确认事实视觉分离) */
.banner {
  margin: 24rpx 36rpx;
  padding: 20rpx 24rpx;
  background: var(--banner-bg);
  color: var(--text);
  border: 2rpx solid var(--banner-line);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.banner.manual {
  background: var(--banner-manual-bg);
  color: var(--banner-manual-fg);
  border-color: var(--line);
  font-weight: 400;
}

.qualifiers {
  margin: 12rpx 36rpx 0;
  font-size: 24rpx;
  color: var(--text-2);
}

.qualifiers.warn {
  color: #b45309;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

/* ============ 微交互复用包(2026-10-17,A 档六项之「全局统一」) ============
 * 原则:精致感=一致的物理隐喻(按下会陷、弹出会过冲、成功会庆祝),不加任何信息。
 * 全站仅两个缓动:弹簧(0.2,0.9,0.3,1.35,与语音录音窗同款)与 ease-out。 */
page {
  --spring: cubic-bezier(0.2, 0.9, 0.3, 1.35);
}

/* 统一按压三件套:缩 0.97+变暗+投影下沉(所有主按钮 hover 类挂 btn-press) */
.btn-press {
  filter: brightness(0.94);
  transform: scale(0.97);
}

.appearance-root { min-height:100vh; background:var(--bg); color:var(--text); }
.appearance-root .theme-light { display:var(--theme-light-display,block) !important; }
.appearance-root .theme-dark { display:var(--theme-dark-display,none) !important; }
