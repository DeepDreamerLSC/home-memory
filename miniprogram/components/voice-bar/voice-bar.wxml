<block wx:if="{{ !kbOpen && (voiceState === 'recording' || voiceState === 'cancelPending') }}">
  <view class="recback"></view>
  <view class="recsheet">
    <view class="rec-title">{{ voiceState === 'cancelPending' ? '好,当我没听见。' : '说吧,我记着呢。' }}</view>
    <view class="wave">
      <view class="wv"></view><view class="wv"></view><view class="wv"></view>
      <view class="wv"></view><view class="wv"></view><view class="wv"></view><view class="wv"></view>
    </view>
    <view wx:if="{{ partialText }}" class="rec-transcript">{{ partialText }}</view>
    <view wx:if="{{ voiceState === 'recording' }}" class="rec-hint">松开去核对 · 确认后才保存</view>
    <view class="rec-cancel">{{ voiceState === 'cancelPending' ? '↓ 滑回继续' : '↑ 上滑取消' }}</view>
  </view>
</block>

<view class="voicebar {{ kbOpen ? 'kb-hide' : '' }}">
  <view
    class="hold {{ pressed ? 'pressed' : '' }} {{ (transcribing || extracting) ? 'busy' : '' }} {{ voiceState === 'cancelPending' ? 'cancel' : '' }}"
    catchtouchstart="onHoldTouchStart"
    catchtouchmove="onHoldTouchMove"
    catchtouchend="onHoldTouchEnd"
    catchtouchcancel="onHoldTouchCancel"
    aria-role="button"
    aria-label="按住说话"
  >
    <view class="hold-face">
      <view class="micdot">
        <view wx:if="{{ voiceState === 'recording' }}" class="mic-seconds">{{ recordSeconds }}s</view>
        <image wx:else class="mic-icon" src="/assets/icons/mic.png" mode="aspectFit" />
      </view>
      <view class="hold-label">{{ voiceState === 'cancelPending' ? '上滑取消' : extracting ? '核对物品和位置…' : transcribing ? '整理语音…' : voiceState === 'recording' ? '正在听…' : '按住说话' }}</view>
    </view>
  </view>
  <button
    class="add-btn {{ voiceState !== 'idle' || transcribing || extracting ? 'disabled' : '' }}"
    disabled="{{ voiceState !== 'idle' || transcribing || extracting }}"
    hover-class="add-pressed"
    bindtap="onAddTap"
    aria-label="选择其他录入方式"
  ><view class="plus-h"></view><view class="plus-v"></view></button>
</view>

<view wx:if="{{ showActions && !kbOpen }}" class="actions-mask" bindtap="onActionsClose" catchtouchmove="noop">
  <view class="actions-sheet" catchtap="noop">
    <view class="sheet-grab"></view>
    <view class="actions-head">
      <view class="actions-title">想怎么记？</view>
      <button class="actions-close" bindtap="onActionsClose" aria-label="关闭">×</button>
    </view>
    <button class="action-row" hover-class="action-row-pressed" bindtap="onPhotoTap">
      <view class="action-icon"><image class="icon-light" src="/assets/icons/camera.png"/><image class="icon-dark" src="/assets/icons/camera-dark.png"/></view>
      <view class="action-name">拍照记一件</view><text class="action-chevron">›</text>
    </button>
    <button class="action-row" hover-class="action-row-pressed" bindtap="onVideoTap">
      <view class="action-icon"><image class="icon-light" src="/assets/icons/video.png"/><image class="icon-dark" src="/assets/icons/video-dark.png"/></view>
      <view class="action-name">视频记多件</view><text class="action-chevron">›</text>
    </button>
    <button class="action-row txtbtn" hover-class="action-row-pressed" bindtap="onTextTap">
      <view class="action-icon"><image class="icon-light" src="/assets/icons/text.png"/><image class="icon-dark" src="/assets/icons/text-dark.png"/></view>
      <view class="action-name txtbtn-face">文字记录</view><text class="action-chevron">›</text>
    </button>
  </view>
</view>
