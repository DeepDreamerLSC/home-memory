/* 与批准原型共用色值；底栏只保留语音与添加入口。 */
.voicebar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--vb-bg);
  border-top: 1rpx solid var(--vb-line);
  padding: 24rpx 40rpx calc(8rpx + env(safe-area-inset-bottom) / 2);
}
.kb-hide { display: none; }
.hold {
  flex: 1;
  min-width: 0;
  min-height: 102rpx;
  display: flex;
  align-items: center;
}
.hold-face {
  width: 100%;
  min-height: 102rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  background: var(--vb-hold-bg);
  color: var(--vb-hold-fg);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  transition: transform .15s ease, filter .15s ease;
}
.hold.pressed .hold-face { filter: brightness(0.94); transform: scale(0.985); }
.hold.busy .hold-face { opacity: .65; }
.hold.cancel .hold-face { opacity: .8; }
.micdot {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  border-radius: 50%;
  background: var(--vb-mic-bg);
  color: var(--vb-mic-fg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mic-icon { width: 36rpx; height: 36rpx; }
.mic-seconds { font-size: 20rpx; font-variant-numeric: tabular-nums; }
.hold-label { min-width: 0; line-height: 1.2; }
button.add-btn {
  position: relative;
  display: block;
  flex: 0 0 102rpx;
  width: 102rpx;
  min-width: 102rpx;
  max-width: 102rpx;
  height: 102rpx;
  min-height: 102rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--vb-btn-line);
  border-radius: 32rpx;
  background: var(--vb-btn-bg);
  color: var(--vb-btn-fg);
}
.add-btn::after, .actions-close::after, .action-row::after { border: none; }
.plus-h, .plus-v { position: absolute; background: currentColor; border-radius: 2rpx; }
.plus-h { width: 34rpx; height: 3rpx; top: calc(50% - 1.5rpx); left: calc(50% - 17rpx); }
.plus-v { width: 3rpx; height: 34rpx; top: calc(50% - 17rpx); left: calc(50% - 1.5rpx); }
.add-btn.disabled { opacity: .45; }
.add-pressed { transform: scale(.975); }
.recback, .actions-mask { position: fixed; inset: 0; background: rgba(23, 29, 24, .4); }
.recback { z-index: 40; }
.recsheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 45;
  border-radius: 40rpx;
  background: var(--card);
  padding: 40rpx 36rpx;
  text-align: center;
  animation: sheet-rise .2s ease-out;
}
.rec-title { font-size: 40rpx; font-weight: 500; color: var(--text); }
.wave { display: flex; gap: 10rpx; align-items: center; justify-content: center; height: 150rpx; }
.wv { width: 8rpx; height: 48rpx; border-radius: 6rpx; background: var(--text-2); animation: wave 1s infinite alternate ease-in-out; }
.wv:nth-child(3n) { height: 78rpx; animation-delay: -.4s; }
.wv:nth-child(3n + 1) { height: 30rpx; animation-delay: -.7s; }
.rec-transcript { font-size: 28rpx; line-height: 1.7; padding: 24rpx; border-radius: 24rpx; background: var(--card-inset); margin-bottom: 28rpx; }
.rec-hint, .rec-cancel { font-size: 24rpx; line-height: 1.7; color: var(--text-2); }
.rec-cancel { margin-top: 12rpx; }
.actions-mask { z-index: 60; display: flex; align-items: flex-end; }
.actions-sheet { width: 100%; padding: 20rpx 44rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--bg); color: var(--text); border-radius: 50rpx 50rpx 0 0; animation: sheet-rise .2s ease-out; }
.sheet-grab { width: 64rpx; height: 8rpx; margin: 0 auto 30rpx; background: var(--line); border-radius: 8rpx; }
.actions-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.actions-title { font-size: 40rpx; font-weight: 500; }
button.actions-close { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; padding: 0; margin: -8rpx -12rpx -8rpx 0; font-size: 44rpx; font-weight: 300; color: var(--text-2); background: transparent; }
button.action-row { display: flex; align-items: center; gap: 28rpx; min-height: 150rpx; width: 100%; padding: 32rpx 0; margin: 0; border-bottom: 1rpx solid var(--line); border-radius: 0; background: transparent; color: var(--text); line-height: 1.3; text-align: left; }
.action-row:last-child { border-bottom: none; }
.action-icon { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; flex: none; border-radius: 26rpx; background: var(--card-inset); }
.action-icon image { width: 40rpx; height: 40rpx; }
.icon-dark { display: none; }
.action-name { flex: 1; font-size: 28rpx; font-weight: 500; }
.action-chevron { font-size: 36rpx; color: var(--text-3); }
.action-row-pressed { opacity: .65; }
@keyframes wave { to { transform: scaleY(.45); opacity: .6; } }
@keyframes sheet-rise { from { transform: translateY(30rpx); opacity: .5; } to { transform: translateY(0); opacity: 1; } }
@media (prefers-color-scheme: dark) { .icon-light { display: none; } .icon-dark { display: block; } }
@media (prefers-reduced-motion: reduce) { .wv, .recsheet, .actions-sheet { animation: none; } .hold-face { transition: none; } }

button.actions-close { flex: 0 0 88rpx; min-width: 88rpx; max-width: 88rpx; }
button.action-row { min-width: 100%; max-width: 100%; }
