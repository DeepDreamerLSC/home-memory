/* R0 候选组卡:视觉沿用现有 token(纸底/墨字/深绿主操作/黄高亮框),
   几何一律固定 rpx 盒(130rpx 缩略先例),不用 aspect-ratio/min/calc/vh。 */
.sgc {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f7f2e7;
  border: 2rpx solid rgba(29, 28, 24, 0.08);
}
.sgc-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.sgc-thumb {
  position: relative;
  flex: 0 0 130rpx;
  width: 130rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #e6dfd1;
}
.sgc-thumb-img { width: 100%; height: 100%; }
.sgc-box {
  position: absolute;
  border: 4rpx solid #ffd600;
  border-radius: 4rpx;
  box-sizing: border-box;
  pointer-events: none;
}
.sgc-main { flex: 1; min-width: 0; }
.sgc-title-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.sgc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #292d25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}
.sgc-risk {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #8b2318;
  background: #ffe1dc;
}
.sgc-meta { margin-top: 8rpx; font-size: 22rpx; color: #7a5c08; font-weight: 600; }
.sgc-state { margin-top: 8rpx; font-size: 23rpx; color: #5f5437; }
.sgc-warn {
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #8b2318;
  background: #ffe1dc;
}
.sgc-chev {
  flex: 0 0 auto;
  padding: 8rpx 0 8rpx 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--go-bg, #1d1c18);
}
.sgc-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.sgc-act {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(29, 28, 24, 0.2);
  font-size: 23rpx;
  font-weight: 700;
  color: #292d25;
  background: #fffdf7;
}
.sgc-act-go {
  border-color: var(--go-bg, #1d1c18);
  background: var(--go-bg, #1d1c18);
  color: var(--go-fg, #fff4c7);
}
.sgc-act-off { opacity: 0.45; }
.sgc-body { margin-top: 16rpx; }
.sgc-hint { font-size: 21rpx; line-height: 1.5; color: #7a5c08; }
.sgc-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx;
  margin-top: 10rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #fffdf7;
}
.sgc-row-on { border-color: var(--go-bg, #1d1c18); background: #fff8d8; }
.sgc-row-claimed { opacity: 0.72; }
.sgc-used {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(29, 28, 24, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #5f5437;
  box-sizing: border-box;
}
.sgc-check {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(29, 28, 24, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 24rpx;
  box-sizing: border-box;
}
.sgc-check.on {
  background: var(--go-bg, #1d1c18);
  color: var(--go-fg, #fff4c7);
  border-color: var(--go-bg, #1d1c18);
}
.sgc-row-thumb {
  position: relative;
  flex: 0 0 110rpx;
  width: 110rpx;
  height: 82rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #e6dfd1;
}
.sgc-row-img { width: 100%; height: 100%; }
.sgc-row-main { flex: 1; min-width: 0; }
.sgc-row-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #292d25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sgc-row-meta { margin-top: 6rpx; font-size: 21rpx; color: #7a6f52; }
.sgc-row-claim { margin-top: 6rpx; font-size: 21rpx; color: #5f5437; }
.sgc-per { margin-top: 12rpx; text-align: center; }
